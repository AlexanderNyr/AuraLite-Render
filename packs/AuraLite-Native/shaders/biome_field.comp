#version 460
// Reference pack: compute pass that fills the baked biome volume.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0, rgba8ui) uniform writeonly uimage3D biome_volume;
void main() {
    uvec3 p = gl_GlobalInvocationID;
    imageStore(biome_volume, ivec3(p), uvec4(1u, 0u, 0u, 255u));
}
