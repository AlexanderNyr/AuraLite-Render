+void main() { gl_Position = vec4(inPos, 1.0); }
diff --git a/packs/AuraLite-Native/shaders/ssao.comp b/packs/AuraLite-Native/shaders/ssao.comp
new file mode 100644
index 0000000..2ce630e
--- /dev/null
+++ b/packs/AuraLite-Native/shaders/ssao.comp
@@ -0,0 +1,9 @@
+#version 460
+// Reference pack: half-resolution SSAO; dispatch ceil(width/16) x ceil(height/16).
+layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
+layout(set = 0, binding = 0, r16f) uniform readonly image2D sceneDepth;
+layout(set = 0, binding = 1, r16f) uniform writeonly image2D aoImage;
+void main() {
+    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
+    imageStore(aoImage, p, vec4(1.0));
+}
