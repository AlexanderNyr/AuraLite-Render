+                        VkPipelineRasterizationStateCreateInfo.calloc(stack)
+                        .sType(VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO)
+                        .depthClampEnable(desc.raster.depthClamp)
+                        .rasterizerDiscardEnable(false)
