--- /dev/null
+++ b/core/src/main/java/dev/auralite/render/graph/GraphException.java
@@ -0,0 +1,16 @@
+package dev.auralite.render.graph;
+
+/** Always carries a named reason and, where useful, the offending path. */
+public class GraphException extends RuntimeException {
+    private static final long serialVersionUID = 1L;
+    private final String passName;
+
+    public GraphException(String message) { this(message, ""); }
+
+    public GraphException(String message, String passName) {
+        super(passName == null || passName.isEmpty() ? message : "[" + passName + "] " + message);
+        this.passName = passName == null ? "" : passName;
+    }
+
+    public String passName() { return passName; }
+}
diff --git a/core/src/main/java/dev/auralite/render/graph/GraphHistory.java b/core/src/main/java/dev/auralite/render/graph/GraphHistory.java
new file mode 100644
index 0000000..be41468
--- /dev/null
+++ b/core/src/main/java/dev/auralite/render/graph/GraphHistory.java
@@ -0,0 +1,67 @@
+package dev.auralite.render.graph;
+
+import dev.auralite.render.rhi.GfxDesc;
+import dev.auralite.render.rhi.GfxImage;
+
+/**
+ * A ping-pong pair, which is how feedback stays acyclic.
+ *
+ * <p>TAA, reprojection, temporal cloud noise and accumulated SSR all need to
+ * read last frame's result. Declaring that as "pass X reads what pass X
+ * writes" is a genuine cycle, so the graph exposes it honestly as two
+ * resources: a pass reads {@code previous()} and writes {@code current()}, and
+ * the frame swaps the two bindings at the end. Two frames later the bindings
+ * are back where they started, which is exactly what the B-lane gate asserts.
+ */
+public final class GraphHistory {
+    private final String logicalName;
+    private final GraphResource a;
+    private final GraphResource b;
+    private int phase;
+    private int swaps;
+
+    GraphHistory(String logicalName, GraphResource a, GraphResource b) {
+        this.logicalName = logicalName;
+        this.a = a;
+        this.b = b;
+    }
+
+    public String logicalName() { return logicalName; }
+
+    /**
+     * The two physical sides, independent of the current phase.
+     *
+     * <p>The compiler needs both, because an edge exists between a writer of one
+     * side and a reader of the other regardless of which side is "current" this
+     * frame -- that edge is what keeps a temporal producer alive during culling.
+     */
+    public GraphResource sideA() { return a; }
+    public GraphResource sideB() { return b; }
+    public GraphResource current() { return phase == 0 ? a : b; }
+    public GraphResource previous() { return phase == 0 ? b : a; }
+    public String currentName() { return current().name(); }
+    public String previousName() { return previous().name(); }
+    public int phase() { return phase; }
+    public int swapCount() { return swaps; }
+
+    /** Exchanges the two GPU bindings. Called once per frame after execution. */
+    void swapBindings() {
+        GfxImage ia = a.image(), ib = b.image();
+        a.bindImage(ib);
+        b.bindImage(ia);
+        phase ^= 1;
+        swaps++;
+    }
+
+    /** Registers the pair on a graph; the descriptor is used for both sides. */
+    static GraphHistory create(RenderGraph graph, String name, GfxDesc.Image desc) {
+        GfxDesc.Image da = desc;
+        GfxDesc.Image db = GfxDesc.Image.tex2d(desc.width, desc.height, desc.format, desc.usage);
+        db.type = desc.type; db.depth = desc.depth; db.mipLevels = desc.mipLevels;
+        db.arrayLayers = desc.arrayLayers; db.samples = desc.samples;
+        db.domain = desc.domain;
+        GraphResource ra = graph.addTexture(name + ".0", da);
+        GraphResource rb = graph.addTexture(name + ".1", db);
+        return new GraphHistory(name, ra, rb);
+    }
+}
diff --git a/core/src/main/java/dev/auralite/render/graph/GraphPass.java b/core/src/main/java/dev/auralite/render/graph/GraphPass.java
new file mode 100644
index 0000000..f211ab6
--- /dev/null
+++ b/core/src/main/java/dev/auralite/render/graph/GraphPass.java
@@ -0,0 +1,116 @@
+package dev.auralite.render.graph;
+
+import dev.auralite.render.rhi.GfxEnums.PassType;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+/**
+ * One node of the render graph.
+ *
+ * <p>A pass declares what it reads and what it writes and nothing else: the
+ * compiler derives ordering, barriers, lifetimes and aliasing from those
+ * declarations. That is the whole point of having a graph instead of Iris's
+ * fixed {@code composite0..N} list -- a pack may declare a DAG with compute
+ * nodes, feedback edges through history buffers, and passes that only exist
+ * when an option is on.
+ */
+public final class GraphPass {
+    /** Body executed when the pass runs. */
+    public interface Executor {
+        void execute(GraphContext ctx);
+    }
+
+    private final String name;
+    private final PassType type;
+    private final List<GraphAccess> accesses = new ArrayList<GraphAccess>();
+    private final List<String> conditionals = new ArrayList<String>();
+    private Executor executor;
+    private int declarationIndex;
+    private boolean external;
+    private boolean kept;
+    private String keepReason = "";
+    private boolean enabled = true;
+    private String disableReason = "";
+    /** Compute work-group size declared by the pack, 0 when not a compute pass. */
+    private int groupsX, groupsY, groupsZ;
+    /** Measured cost, filled in by the profiling lane; -1 until measured. */
+    private double lastCostMillis = -1.0;
+
+    GraphPass(String name, PassType type, int declarationIndex) {
+        this.name = name;
+        this.type = type;
+        this.declarationIndex = declarationIndex;
+    }
+
+    void addAccess(GraphAccess a) { accesses.add(a); }
+    void setExecutor(Executor e) { this.executor = e; }
+    void setExternal(boolean e) { this.external = e; }
+    void setKept(boolean k, String why) { this.kept = k; this.keepReason = k && why != null ? why : ""; }
+    void setEnabled(boolean e, String reason) { this.enabled = e; this.disableReason = reason == null ? "" : reason; }
+    void addConditional(String optionName) { conditionals.add(optionName); }
+    void setDispatch(int x, int y, int z) { this.groupsX = x; this.groupsY = y; this.groupsZ = z; }
+    public void recordCost(double millis) { this.lastCostMillis = millis; }
+
+    public String name() { return name; }
+    public PassType type() { return type; }
+    public List<GraphAccess> accesses() { return Collections.unmodifiableList(accesses); }
+    public List<String> conditionals() { return Collections.unmodifiableList(conditionals); }
+    public Executor executor() { return executor; }
+    public int declarationIndex() { return declarationIndex; }
+    public boolean isExternal() { return external; }
+
+    /**
+     * True when this pass has consumers the graph cannot see.
+     *
+     * <p>A legacy Iris pack samples {@code shadowtex0}, {@code shadowtex1},
+     * {@code shadowcolor0} and {@code shadowcolor1} from any later program
+     * through implicit bindings that no {@code shaders.properties} line ever
+     * declares. Reachability from the external output would therefore cull the
+     * shadow passes as dead, which is correct graph reasoning and a broken
+     * frame. {@code keep} records that the pass is load-bearing anyway.
+     */
+    public boolean isKept() { return kept; }
+
+    /** Why this pass was kept, for the compile receipt. Empty when not kept. */
+    public String keepReason() { return keepReason; }
+    public boolean isEnabled() { return enabled; }
+    public String disableReason() { return disableReason; }
+    public boolean isCompute() { return type == PassType.COMPUTE; }
+    public int groupsX() { return groupsX; }
+    public int groupsY() { return groupsY; }
+    public int groupsZ() { return groupsZ; }
+    public double lastCostMillis() { return lastCostMillis; }
+
+    public List<GraphAccess> reads() {
+        List<GraphAccess> out = new ArrayList<GraphAccess>();
+        for (GraphAccess a : accesses) if (a.isRead()) out.add(a);
+        return out;
+    }
+
+    public List<GraphAccess> writes() {
+        List<GraphAccess> out = new ArrayList<GraphAccess>();
+        for (GraphAccess a : accesses) if (a.isWrite()) out.add(a);
+        return out;
+    }
+
+    /** Colour attachments in slot order, for render-pass construction. */
+    public List<GraphAccess> colorAttachments() {
+        List<GraphAccess> out = new ArrayList<GraphAccess>();
+        for (GraphAccess a : accesses) if (a.attachmentSlot >= 0) out.add(a);
+        Collections.sort(out, (x, y) -> Integer.compare(x.attachmentSlot, y.attachmentSlot));
+        return out;
+    }
+
+    public GraphAccess depthAttachment() {
+        for (GraphAccess a : accesses) {
+            int m = a.access & (dev.auralite.render.rhi.GfxEnums.Access.DEPTH_STENCIL_WRITE
+                    | dev.auralite.render.rhi.GfxEnums.Access.DEPTH_STENCIL_READ);
+            if (m != 0) return a;
+        }
+        return null;
+    }
+
+    @Override public String toString() { return name + "(" + type + ")"; }
+}
diff --git a/core/src/main/java/dev/auralite/render/graph/GraphResource.java b/core/src/main/java/dev/auralite/render/graph/GraphResource.java
new file mode 100644
index 0000000..699aeb8
--- /dev/null
+++ b/core/src/main/java/dev/auralite/render/graph/GraphResource.java
@@ -0,0 +1,85 @@
+package dev.auralite.render.graph;
+
+import dev.auralite.render.rhi.GfxBuffer;
+import dev.auralite.render.rhi.GfxDesc;
+import dev.auralite.render.rhi.GfxFormat;
+import dev.auralite.render.rhi.GfxImage;
+import dev.auralite.render.rhi.GfxUsage;
+
+/**
+ * A named graph resource: either a texture the graph owns, a buffer it owns, or
+ * something imported from outside (the vanilla framebuffer, a pack-supplied
+ * texture, the swapchain image).
+ *
+ * <p>Imported resources are never reallocated by the graph and never aliased,
+ * which is how the Minecraft glue hands the renderer a framebuffer it does not
+ * own.
+ */
+public final class GraphResource {
+    public enum ResType { TEXTURE, BUFFER }
+
+    private final String name;
+    private final ResType type;
+    private final GfxDesc.Image imageDesc;
+    private final GfxDesc.Buffer bufferDesc;
+    private final boolean imported;
+    private final boolean transientAttachment;
+
+    private GfxImage image;
+    private GfxBuffer buffer;
+    private int index = -1;
+
+    GraphResource(String name, ResType type, GfxDesc.Image imageDesc, GfxDesc.Buffer bufferDesc,
+                  boolean imported, boolean transientAttachment) {
+        this.name = name;
+        this.type = type;
+        this.imageDesc = imageDesc;
+        this.bufferDesc = bufferDesc;
+        this.imported = imported;
+        this.transientAttachment = transientAttachment;
+    }
+
+    static GraphResource texture(String name, GfxDesc.Image desc) {
+        boolean tr = (desc.usage & GfxUsage.IMAGE_TRANSIENT_ATTACHMENT) != 0;
+        return new GraphResource(name, ResType.TEXTURE, desc, null, false, tr);
+    }
+
+    static GraphResource buffer(String name, GfxDesc.Buffer desc) {
+        return new GraphResource(name, ResType.BUFFER, null, desc, false, false);
+    }
+
+    static GraphResource importedTexture(String name, GfxDesc.Image desc) {
+        return new GraphResource(name, ResType.TEXTURE, desc, null, true, false);
+    }
+
+    static GraphResource importedBuffer(String name, GfxDesc.Buffer desc) {
+        return new GraphResource(name, ResType.BUFFER, null, desc, true, false);
+    }
+
+    public String name() { return name; }
+    public ResType type() { return type; }
+    public boolean isTexture() { return type == ResType.TEXTURE; }
+    public boolean isBuffer() { return type == ResType.BUFFER; }
+    public boolean isImported() { return imported; }
+    public boolean isTransient() { return transientAttachment; }
+    public GfxDesc.Image imageDesc() { return imageDesc; }
+    public GfxDesc.Buffer bufferDesc() { return bufferDesc; }
+    public GfxFormat format() { return imageDesc == null ? GfxFormat.UNDEFINED : imageDesc.format; }
+    public int index() { return index; }
+    void setIndex(int i) { this.index = i; }
+
+    public GfxImage image() { return image; }
+    public GfxBuffer buffer() { return buffer; }
+    public void bindImage(GfxImage img) { this.image = img; }
+    public void bindBuffer(GfxBuffer buf) { this.buffer = buf; }
+
+    /** Device bytes this resource occupies, 0 while unallocated. */
+    public long sizeBytes() {
+        if (image != null) return image.sizeBytes();
+        if (buffer != null) return buffer.sizeBytes();
+        if (imageDesc != null) return imageDesc.approxBytes();
+        return bufferDesc == null ? 0 : bufferDesc.sizeBytes;
+    }
+
+    @Override public String toString() { return name + (imported ? "(imported)" : ""); }
+}
diff --git a/core/src/main/java/dev/auralite/render/graph/GraphStats.java b/core/src/main/java/dev/auralite/render/graph/GraphStats.java
new file mode 100644
index 0000000..02325ad
--- /dev/null
+++ b/core/src/main/java/dev/auralite/render/graph/GraphStats.java
@@ -0,0 +1,62 @@
+package dev.auralite.render.graph;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Compile receipts.
+ *
+ * <p>Every number here is produced by the compiler, not estimated, and the test
+ * gates assert on the receipts. {@link #receipt()} renders them as one line per
+ * fact so a regression shows up as a diff in CI output rather than a red bar.
+ */
+public final class GraphStats {
+    public int declaredPasses;
+    public int enabledPasses;
+    public int culledPasses;
+    public int orderedPasses;
+    public int rasterPasses;
+    public int computePasses;
+    public int copyPasses;
+    public int declaredResources;
+    public int importedResources;
+    public int transientResources;
+    public long ownedTextureBytes;
+    public long importedTextureBytes;
+    public long bufferBytes;
+    public long aliasSavingsBytes;
+    public int aliasGroups;
+    public int barriers;
+    public int noopBarriersSuppressed;
+    public long edgeCount;
+    public long compileMicros;
+    public final List<String> culled = new ArrayList<String>();
+    public final List<String> disabled = new ArrayList<String>();
+    public final List<String> warnings = new ArrayList<String>();
+
+    public String receipt() {
+        StringBuilder sb = new StringBuilder();
+        sb.append("passes: ").append(declaredPasses).append(" declared, ")
+          .append(enabledPasses).append(" enabled, ")
+          .append(orderedPasses).append(" ordered, ")
+          .append(culledPasses).append(" culled\n");
+        sb.append("  kinds: ").append(rasterPasses).append(" raster, ")
+          .append(computePasses).append(" compute, ")
+          .append(copyPasses).append(" copy\n");
+        sb.append("resources: ").append(declaredResources).append(" declared, ")
+          .append(importedResources).append(" imported, ")
+          .append(transientResources).append(" transient\n");
+        sb.append("memory: ").append(ownedTextureBytes).append(" B owned textures, ")
+          .append(importedTextureBytes).append(" B imported, ")
+          .append(bufferBytes).append(" B buffers\n");
+        sb.append("aliasing: ").append(aliasGroups).append(" groups, ")
+          .append(aliasSavingsBytes).append(" B reclaimable\n");
+        sb.append("barriers: ").append(barriers).append(" emitted, ")
+          .append(noopBarriersSuppressed).append(" suppressed as no-ops\n");
+        sb.append("edges: ").append(edgeCount).append('\n');
+        for (String c : culled) sb.append("  culled: ").append(c).append('\n');
+        for (String d : disabled) sb.append("  disabled: ").append(d).append('\n');
+        for (String w : warnings) sb.append("  warning: ").append(w).append('\n');
+        return sb.toString();
+    }
+}
diff --git a/core/src/main/java/dev/auralite/render/graph/RenderGraph.java b/core/src/main/java/dev/auralite/render/graph/RenderGraph.java
new file mode 100644
index 0000000..6183a58
--- /dev/null
+++ b/core/src/main/java/dev/auralite/render/graph/RenderGraph.java
@@ -0,0 +1,267 @@
+package dev.auralite.render.graph;
+
+import dev.auralite.render.rhi.DeviceLimits;
+import dev.auralite.render.rhi.GfxDesc;
+import dev.auralite.render.rhi.GfxEnums.Access;
+import dev.auralite.render.rhi.GfxEnums.PassType;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Builder for one frame's dependency graph.
+ *
+ * <p>Rebuilt cheaply whenever the pack, the window size or the enabled options
+ * change, then compiled once and executed every frame. Compilation is pure CPU
+ * work with no device calls, which is what makes the whole thing testable on a
+ * machine with no GPU.
+ */
+public final class RenderGraph {
+
+    /** Fluent per-pass declaration handed to a setup callback. */
+    public interface Setup {
+        void setup(PassBuilder pass);
+    }
+
+    /** Per-pass builder: declares accesses, then the body. */
+    public static final class PassBuilder {
+        private final GraphPass pass;
+        private final RenderGraph graph;
+        private int nextColorSlot = 0;
+
+        PassBuilder(RenderGraph graph, GraphPass pass) {
+            this.graph = graph;
+            this.pass = pass;
+        }
+
+        public PassBuilder read(String resource, int access) {
+            return read(graph.require(resource), access);
+        }
+
+        public PassBuilder read(GraphResource r, int access) {
+            pass.addAccess(new GraphAccess(r, access, -1, 0));
+            return this;
+        }
+
+        public PassBuilder write(String resource, int access) {
+            return write(graph.require(resource), access);
+        }
+
+        public PassBuilder write(GraphResource r, int access) {
+            pass.addAccess(new GraphAccess(r, access, -1, 0));
+            return this;
+        }
+
+        /** Declares a colour attachment in declaration order (slot 0, 1, 2...). */
+        public PassBuilder color(String resource, int loadOpClear) {
+            GraphResource r = graph.require(resource);
+            int access = Access.COLOR_ATTACHMENT_WRITE | (loadOpClear != 0 ? Access.COLOR_ATTACHMENT_READ : 0);
+            pass.addAccess(new GraphAccess(r, access, nextColorSlot++, 0));
+            return this;
+        }
+
+        public PassBuilder color(String resource) { return color(resource, 0); }
+
+        /** Declares a depth attachment; at most one per pass. */
+        public PassBuilder depth(String resource, boolean write) {
+            GraphResource r = graph.require(resource);
+            int access = Access.DEPTH_STENCIL_READ | (write ? Access.DEPTH_STENCIL_WRITE : 0);
+            pass.addAccess(new GraphAccess(r, access, -1, 0));
+            return this;
+        }
+
+        /** Declares a mip level write, used by the bloom pyramid and the cloud LUTs. */
+        public PassBuilder writeMip(String resource, int mip, int access) {
+            pass.addAccess(new GraphAccess(graph.require(resource), access, -1, mip));
+            return this;
+        }
+
+        /** Reads the previous frame's side of a history pair. */
+        public PassBuilder readHistory(GraphHistory h, int access) {
+            return read(h.previous(), access);
+        }
+
+        /**
+         * Attaches this frame's side of a history pair as a colour target.
+         *
+         * <p>Distinct from {@link #writeHistory}: this one registers the
+         * attachment slot, so a raster pass that resolves into a TAA history is
+         * a legal raster pass and {@code beginRasterPass()} finds its target.
+         */
+        public PassBuilder colorHistory(GraphHistory h) {
+            return color(h.currentName());
+        }
+
+        /** Writes this frame's side of a history pair, for compute and copy passes. */
+        public PassBuilder writeHistory(GraphHistory h, int access) {
+            return write(h.current(), access);
+        }
+
+        /** Compute work-group counts; validated against device limits at compile. */
+        public PassBuilder dispatch(int gx, int gy, int gz) {
+            pass.setDispatch(gx, gy, gz);
+            return this;
+        }
+
+        /** The pass only exists when this pack option is enabled. */
+        public PassBuilder when(String optionName, boolean enabled) {
+            pass.addConditional(optionName);
+            pass.setEnabled(enabled, enabled ? "" : "option '" + optionName + "' is off");
+            return this;
+        }
+
+        /** Marks the pass as producing something consumed outside the graph. */
+        /**
+         * Marks this pass as load-bearing even though nothing in the graph
+         * reads its output. See {@link GraphPass#isKept()}.
+         */
+        public PassBuilder keep(String why) { pass.setKept(true, why); return this; }
+
+        public PassBuilder external() {
+            pass.setExternal(true);
+            return this;
+        }
+
+        public PassBuilder body(GraphPass.Executor e) {
+            pass.setExecutor(e);
+            return this;
+        }
+    }
+
+    private final String name;
+    private final Map<String, GraphResource> resources = new LinkedHashMap<String, GraphResource>();
+    private final List<GraphPass> passes = new ArrayList<GraphPass>();
+    private final List<GraphHistory> histories = new ArrayList<GraphHistory>();
+
+    public RenderGraph(String name) { this.name = name; }
+
+    public String name() { return name; }
+
+    // ------------------------------------------------------------- resources
+    public GraphResource addTexture(String name, GfxDesc.Image desc) {
+        checkName(name);
+        if (resources.containsKey(name)) {
+            throw new GraphException("resource '" + name + "' declared twice");
+        }
+        GraphResource r = GraphResource.texture(name, desc);
+        r.setIndex(resources.size());
+        resources.put(name, r);
+        return r;
+    }
+
+    public GraphResource addBuffer(String name, GfxDesc.Buffer desc) {
+        checkName(name);
+        if (resources.containsKey(name)) {
+            throw new GraphException("resource '" + name + "' declared twice");
+        }
+        GraphResource r = GraphResource.buffer(name, desc);
+        r.setIndex(resources.size());
+        resources.put(name, r);
+        return r;
+    }
+
+    /** A texture the graph does not own: the vanilla framebuffer, a pack asset. */
+    public GraphResource importTexture(String name, GfxDesc.Image desc) {
+        checkName(name);
+        if (resources.containsKey(name)) {
+            throw new GraphException("resource '" + name + "' declared twice");
+        }
+        GraphResource r = GraphResource.importedTexture(name, desc);
+        r.setIndex(resources.size());
+        resources.put(name, r);
+        return r;
+    }
+
+    public GraphResource importBuffer(String name, GfxDesc.Buffer desc) {
+        checkName(name);
+        if (resources.containsKey(name)) {
+            throw new GraphException("resource '" + name + "' declared twice");
+        }
+        GraphResource r = GraphResource.importedBuffer(name, desc);
+        r.setIndex(resources.size());
+        resources.put(name, r);
+        return r;
+    }
+
+    public GraphResource find(String name) { return resources.get(name); }
+
+    public GraphResource require(String name) {
+        GraphResource r = resources.get(name);
+        if (r == null) {
+            throw new GraphException("unknown resource '" + name + "'");
+        }
+        return r;
+    }
+
+    public boolean hasResource(String name) { return resources.containsKey(name); }
+    public List<GraphResource> resources() {
+        return Collections.unmodifiableList(new ArrayList<GraphResource>(resources.values()));
+    }
+    public int resourceCount() { return resources.size(); }
+
+    // ---------------------------------------------------------------- passes
+    public PassBuilder addPass(String name, PassType type) {
+        checkName(name);
+        for (GraphPass p : passes) {
+            if (p.name().equals(name)) throw new GraphException("pass '" + name + "' declared twice");
+        }
+        GraphPass p = new GraphPass(name, type, passes.size());
+        passes.add(p);
+        return new PassBuilder(this, p);
+    }
+
+    public PassBuilder addRasterPass(String name) { return addPass(name, PassType.RASTER); }
+    public PassBuilder addComputePass(String name) { return addPass(name, PassType.COMPUTE); }
+    public PassBuilder addCopyPass(String name) { return addPass(name, PassType.COPY); }
+
+    public PassBuilder addPass(String name, PassType type, Setup setup) {
+        PassBuilder b = addPass(name, type);
+        setup.setup(b);
+        return b;
+    }
+
+    // --------------------------------------------------------------- history
+    /**
+     * Declares a ping-pong pair for temporal feedback (TAA, reprojection,
+     * accumulated SSR, temporal cloud noise). Reading last frame's output is
+     * not a cycle in this graph; it is two resources and a swap at frame end.
+     */
+    public GraphHistory addHistory(String name, GfxDesc.Image desc) {
+        GraphHistory h = GraphHistory.create(this, name, desc);
+        histories.add(h);
+        return h;
+    }
+
+    public List<GraphHistory> histories() { return Collections.unmodifiableList(histories); }
+
+    public List<GraphPass> passes() { return Collections.unmodifiableList(passes); }
+    public int passCount() { return passes.size(); }
+
+    // --------------------------------------------------------------- compile
+    /** Compiles against a conservative limit profile; used by tests and lint. */
+    public CompiledGraph compile(int width, int height) {
+        return compile(width, height, new DeviceLimits());
+    }
+
+    public CompiledGraph compile(int width, int height, DeviceLimits limits) {
+        return new GraphCompiler(this, width, height, limits).compile();
+    }
+
+    private static void checkName(String name) {
+        if (name == null || name.trim().isEmpty()) {
+            throw new GraphException("empty resource or pass name");
+        }
+        for (int i = 0; i < name.length(); i++) {
+            char c = name.charAt(i);
+            boolean ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')
+                    || c == '_' || c == '.' || c == '-' || c == '/';
+            if (!ok) {
+                throw new GraphException("illegal character '" + c + "' in name '" + name
+                        + "'; names are used as GLSL identifiers and debug markers");
+            }
+        }
+    }
+}
diff --git a/core/src/main/java/dev/auralite/render/graph/ResourceLifetime.java b/core/src/main/java/dev/auralite/render/graph/ResourceLifetime.java
new file mode 100644
index 0000000..38435d5
--- /dev/null
+++ b/core/src/main/java/dev/auralite/render/graph/ResourceLifetime.java
@@ -0,0 +1,30 @@
+package dev.auralite.render.graph;
+
+/** Half-open pass-index interval during which a resource is live. */
+public final class ResourceLifetime {
+    public final GraphResource resource;
+    public final int firstPass;
+    public final int lastPass;
+    /** Alias group id; resources in the same group may share one allocation. -1 = own allocation. */
+    private int aliasGroup;
+
+    public ResourceLifetime(GraphResource resource, int firstPass, int lastPass, int aliasGroup) {
+        this.resource = resource;
+        this.firstPass = firstPass;
+        this.lastPass = lastPass;
+        this.aliasGroup = aliasGroup;
+    }
+
+    public int aliasGroup() { return aliasGroup; }
+    void setAliasGroup(int g) { this.aliasGroup = g; }
+
+    public boolean overlaps(ResourceLifetime other) {
+        return firstPass <= other.lastPass && other.firstPass <= lastPass;
+    }
+
+    public int span() { return lastPass - firstPass + 1; }
+
+    @Override public String toString() {
+        return resource.name() + " [" + firstPass + ".." + lastPass + "] g" + aliasGroup;
+    }
+}
diff --git a/core/src/main/java/dev/auralite/render/pack/GraphSpec.java b/core/src/main/java/dev/auralite/render/pack/GraphSpec.java
new file mode 100644
index 0000000..e1f5e14
--- /dev/null
+++ b/core/src/main/java/dev/auralite/render/pack/GraphSpec.java
@@ -0,0 +1,131 @@
+package dev.auralite.render.pack;
+
+import dev.auralite.render.rhi.GfxFormat;
+import dev.auralite.render.rhi.GfxUsage;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+/**
+ * The declarative half of a NATIVE pack: what resources exist and which pass
+ * touches which.
+ *
+ * <p>This is the thing Iris has no equivalent of. Iris hard-codes the frame as
+ * {@code shadow -> gbuffers_* -> deferred -> composite0..N -> final} and a pack
+ * can only add or skip steps inside that shape. Here the pack declares the
+ * shape, including compute nodes and temporal feedback, and the compiler
+ * derives order, barriers and memory from it.
+ */
+public final class GraphSpec {
+
+    /** How a resource's extent is decided. */
+    public enum SizeKind {
+        /** Matches the framebuffer; recreated on resize. */
+        FULLSCREEN,
+        /** A fraction of the framebuffer, e.g. half-res bloom. */
+        SCALED,
+        /** Fixed pixel extent. */
+        FIXED,
+        /** Sized from the render distance, e.g. the shadow map or biome volume. */
+        SHADOW,
+        /** Sized from the biome field window. */
+        BIOME_VOLUME
+    }
+
+    public static final class ResourceSpec {
+        public final String name;
+        public GfxFormat format = GfxFormat.RGBA16F;
+        public SizeKind sizeKind = SizeKind.FULLSCREEN;
+        public double scale = 1.0;
+        public int fixedWidth = 1, fixedHeight = 1, fixedDepth = 1;
+        public int mipLevels = 1;
+        public int arrayLayers = 1;
+        public int usage = GfxUsage.IMAGE_SAMPLED | GfxUsage.IMAGE_COLOR_ATTACHMENT;
+        public boolean history;
+        public boolean imported;
+        public boolean is3d;
+        public String comment = "";
+
+        public ResourceSpec(String name) { this.name = name; }
+
+        /** Expands the declared size against a concrete framebuffer and shadow distance. */
+        public int[] extent(int fbWidth, int fbHeight, int shadowMapSize, int[] biomeCells) {
+            switch (sizeKind) {
+                case FULLSCREEN: return new int[] { fbWidth, fbHeight, 1 };
+                case SCALED: return new int[] {
+                        Math.max(1, (int) Math.round(fbWidth * scale)),
+                        Math.max(1, (int) Math.round(fbHeight * scale)), 1 };
+                case FIXED: return new int[] { fixedWidth, fixedHeight, Math.max(1, fixedDepth) };
+                case SHADOW: return new int[] { shadowMapSize, shadowMapSize, 1 };
+                case BIOME_VOLUME: return biomeCells == null
+                        ? new int[] { 1, 1, 1 }
+                        : new int[] { biomeCells[0], biomeCells[1], biomeCells[2] };
+                default: return new int[] { fbWidth, fbHeight, 1 };
+            }
+        }
+    }
+
+    public static final class PassSpec {
+        public final String name;
+        public String type = "raster";
+        /** Colour attachments in slot order. */
+        public final List<String> colors = new ArrayList<String>();
+        public String depth = "";
+        public final List<String> reads = new ArrayList<String>();
+        public final List<String> writes = new ArrayList<String>();
+        public String program = "";
+        public String when = "";
+        public boolean external;
+        public int dispatchX, dispatchY, dispatchZ;
+        /** Dispatch expressed as an expression of width/height, e.g. "ceil(width/8)". */
+        public String dispatchExpr = "";
+        public String comment = "";
+
+        public PassSpec(String name) { this.name = name; }
+        public boolean isCompute() { return "compute".equals(type); }
+        public boolean isCopy() { return "copy".equals(type); }
+    }
+
+    private final List<ResourceSpec> resources = new ArrayList<ResourceSpec>();
+    private final List<PassSpec> passes = new ArrayList<PassSpec>();
+    /** Name of the resource that ends up on screen. */
+    public String presentResource = "";
+
+    public List<ResourceSpec> resources() { return Collections.unmodifiableList(resources); }
+    public List<PassSpec> passes() { return Collections.unmodifiableList(passes); }
+
+    public ResourceSpec addResource(ResourceSpec r) { resources.add(r); return r; }
+    public PassSpec addPass(PassSpec p) { passes.add(p); return p; }
+
+    public ResourceSpec findResource(String name) {
+        for (ResourceSpec r : resources) if (r.name.equals(name)) return r;
+        return null;
+    }
+
+    public PassSpec findPass(String name) {
+        for (PassSpec p : passes) if (p.name.equals(name)) return p;
+        return null;
+    }
+
+    /** Every name referenced by a pass that no resource declares. */
+    public List<String> danglingReferences() {
+        List<String> out = new ArrayList<String>();
+        for (PassSpec p : passes) {
+            check(p.name, p.depth, out);
+            for (String s : p.colors) check(p.name, s, out);
+            for (String s : p.reads) check(p.name, s, out);
+            for (String s : p.writes) check(p.name, s, out);
+        }
+        return out;
+    }
+
+    private void check(String passName, String resource, List<String> out) {
+        if (resource == null || resource.isEmpty()) return;
+        String base = resource;
+        int dot = base.indexOf(".cur");
+        if (dot > 0) base = base.substring(0, dot);
+        if (base.endsWith(".prev")) base = base.substring(0, base.length() - 5);
+        if (findResource(base) == null) out.add(passName + " -> " + resource);
+    }
+}
diff --git a/core/src/main/java/dev/auralite/render/pack/LegacyPropertiesParser.java b/core/src/main/java/dev/auralite/render/pack/LegacyPropertiesParser.java
new file mode 100644
index 0000000..18d560c
--- /dev/null
+++ b/core/src/main/java/dev/auralite/render/pack/LegacyPropertiesParser.java
@@ -0,0 +1,162 @@
+package dev.auralite.render.pack;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+
+/**
+ * Parser for {@code shaders.properties}, the OptiFine/Iris pack configuration.
+ *
+ * <p>The lines that matter are handled explicitly and everything else is
+ * reported as unparsed rather than dropped silently, so a pack that relies on
+ * something this loader does not implement yet says so at load time.
+ */
+public final class LegacyPropertiesParser {
+
+    /** Setting keys copied verbatim into {@link PackManifest#settings()}. */
+    private static final List<String> SETTINGS = Arrays.asList(
+            "shadowDistance", "shadowDistanceRenderMul", "shadowIntervalSize", "shadowMapResolution",
+            "shadowMapFov", "shadowHardwareFiltering", "shadowculling", "separateAo", "oldLighting",
+            "underwaterOverlay", "oldHandLight", "dynamicHandLight", "sunPathRotation", "cloudShadow",
+            "prepareAhead", "rain.depth", "customtex", "vignette", "customTex", "maxTAA",
+            "sliders", "screen.columns", "screen.order", "hand.depth", "water.shadow", "ambientOcclusionLevel");
+
+    private LegacyPropertiesParser() { }
+
+    /** Parses the whole file into {@code manifest}, recording findings in {@code report}. */
+    public static void parse(String text, PackManifest manifest, PackLoadReport report) {
+        if (text == null) {
+            report.warning("shaders.properties", "absent; the pack has no configuration, defaults apply");
+            return;
+        }
+        String[] lines = text.split("\r?\n", -1);
+        for (int i = 0; i < lines.length; i++) {
+            String raw = stripComment(lines[i]).trim();
+            if (raw.isEmpty()) continue;
+            String where = "shaders.properties:" + (i + 1);
+            if (!parseLine(raw, where, manifest, report)) report.unparsed(where, raw);
+        }
+    }
+
+    /** Removes a trailing {@code #} comment but not one inside a quoted label. */
+    static String stripComment(String line) {
+        boolean inQuote = false;
+        for (int i = 0; i < line.length(); i++) {
+            char c = line.charAt(i);
+            if (c == '"' || c == '\'') inQuote = !inQuote;
+            else if (c == '#' && !inQuote) return line.substring(0, i);
+        }
+        return line;
+    }
+
+    private static boolean parseLine(String line, String where, PackManifest m, PackLoadReport report) {
+        int eq = line.indexOf('=');
+        if (eq < 0) return false;
+        String key = line.substring(0, eq).trim();
+        String value = line.substring(eq + 1).trim();
+
+        // Custom uniforms and variables: handed to the expression table, which
+        // also owns the "<name>.transition" form.
+        if (key.startsWith("uniform.") || key.startsWith("variable.") || key.endsWith(".transition")) {
+            return m.customUniforms.parseLine(line, where);
+        }
+
+        if (key.equals("sliders")) {
+            for (String name : splitWs(value)) {
+                m.sliderOrder().add(name);
+                PackOption o = m.option(name);
+                if (o == null) { o = m.addOption(new PackOption(name, PackOption.Kind.DEFINE)); }
+            }
+            return true;
+        }
+
+        if (key.startsWith("screen")) {
+            // "screen", "screen.Atmosphere", "screen.columns", "screen.order"
+            String tab = "";
+            if (key.startsWith("screen.")) {
+                String rest = key.substring("screen.".length());
+                if (!rest.equals("columns") && !rest.equals("order")) tab = rest;
+                else { m.settings().put(key, value); return true; }
+            }
+            List<String> list = m.screen().get(tab);
+            if (list == null) { list = new ArrayList<String>(); m.screen().put(tab, list); }
+            for (String token : splitWs(value)) {
+                if (token.equals("<empty>") || token.equals("<profile>")) continue;
+                if (token.startsWith("[") && token.endsWith("]")) continue;   // sub-column marker
+                list.add(token);
+                PackOption o = m.option(token);
+                if (o == null) {
+                    o = new PackOption(token, PackOption.Kind.DEFINE);
+                    o.tab(tab);
+                    m.addOption(o);
+                } else if (tab != null && !tab.isEmpty() && o.screenTab.isEmpty()) {
+                    o.tab(tab);
+                }
+            }
+            return true;
+        }
+
+        if (key.startsWith("program.")) {
+            String[] parts = key.split("\\.");
+            if (parts.length < 3) return false;
+            String programName = parts[1];
+            String setting = parts[2];
+            PackProgram p = m.program(programName);
+            if (p == null) { p = new PackProgram(programName); m.addProgram(p); }
+            if (setting.equals("enabled")) {
+                boolean on = value.equalsIgnoreCase("true") || value.equals("1");
+                p.explicitlyDisabled = !on;
+                p.enabled = on;
+                if (!on) p.disableReason = "program." + programName + ".enabled=false";
+            } else if (setting.equals("blend")) {
+                String[] f = splitWs(value);
+                if (f.length >= 2) { p.blendSrc = f[0]; p.blendDst = f[1]; }
+                else if (f.length == 1 && f[0].equalsIgnoreCase("off")) { p.blendSrc = ""; p.blendDst = ""; }
+            } else if (setting.equals("composite")) {
+                // "program.composite.composite.<k>=<v>" collapses to key/value.
+                m.settings().put("program." + programName + "." + setting, value);
+            } else {
+                m.settings().put("program." + programName + "." + setting, value);
+            }
+            return true;
+        }
+
+        if (key.startsWith("colortex") && key.endsWith("Format")) {
+            m.legacyFormats().put(key, value);
+            return true;
+        }
+
+        if (key.startsWith("customTexture.")) {
+            m.customTextures().put(key.substring("customTexture.".length()), value);
+            return true;
+        }
+
+        // "<OPTION>.enabled = <expr>": option visibility, evaluated on the CPU.
+        if (key.endsWith(".enabled")) {
+            String opt = key.substring(0, key.length() - ".enabled".length());
+            PackOption o = m.option(opt);
+            if (o == null) { o = new PackOption(opt, PackOption.Kind.DEFINE); m.addOption(o); }
+            o.comment("visible when " + value);
+            return true;
+        }
+
+        for (String s : SETTINGS) {
+            if (key.equals(s)) { m.settings().put(key, value); return true; }
+        }
+
+        // Block and item id maps live in their own files but some packs inline them.
+        if (key.startsWith("block.") || key.startsWith("item.") || key.startsWith("entity.")) {
+            m.settings().put(key, value);
+            return true;
+        }
+
+        return false;
+    }
+
+    static String[] splitWs(String s) {
+        if (s == null) return new String[0];
+        String t = s.trim();
+        if (t.isEmpty()) return new String[0];
+        return t.split("\\s+");
+    }
+}
diff --git a/core/src/main/java/dev/auralite/render/pack/NativePackParser.java b/core/src/main/java/dev/auralite/render/pack/NativePackParser.java
new file mode 100644
index 0000000..53caa5e
--- /dev/null
+++ b/core/src/main/java/dev/auralite/render/pack/NativePackParser.java
@@ -0,0 +1,422 @@
+package dev.auralite.render.pack;
+
+import dev.auralite.render.rhi.GfxCapability;
+import dev.auralite.render.rhi.GfxFormat;
+import dev.auralite.render.rhi.GfxUsage;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Parser for {@code pack.aurapack}, the native format.
+ *
+ * <p>Line-oriented with {@code [section]} headers, {@code key = value} bodies
+ * and {@code #} comments. Deliberately not a general-purpose markup language:
+ * a pack author edits it in a text editor, diffs it in git, and gets a line
+ * number in every error.
+ *
+ * <pre>
+ * [meta]
+ * name = AuraLite Native
+ * version = 1.0.0
+ * auralite.api = 1
+ *
+ * [capabilities]
+ * require = COMPUTE_SHADERS, TEXTURE_3D, INTEGER_TEXTURES
+ *
+ * [biome]
+ * spatialUniforms = true
+ * sampleEntries = 4
+ *
+ * [resources]
+ * scene_color  = rgba16f fullscreen
+ * scene_depth  = d32_sfloat fullscreen usage=depth
+ * cloud_shadow = r16f 2048x2048
+ * taa          = rgba16f fullscreen history
+ * biome_volume = rgba8_uint biome-volume 3d usage=sampled
+ *
+ * [options]
+ * CLOUD_QUALITY = select "Raymarch steps" { 14=Cheap, 24=Standard, 36=High } default=24 tab=Atmosphere
+ * SPATIAL_BIOME = bool "Spatial biome field" default=true
+ *
+ * [graph]
+ * pass shadow_map  raster  depth=scene_depth            program=shadow
+ * pass terrain     raster  color=scene_color depth=scene_depth program=terrain
+ * pass biome_field compute write=biome_volume           program=biome_field dispatch=ceil(width/8),ceil(height/8),1
+ * pass taa         raster  read=scene_color,taa.prev    color=taa.cur  program=taa
+ * pass present     raster  read=taa.cur external
+ * present = taa
+ *
+ * [programs]
+ * terrain     = shaders/terrain.vert, shaders/terrain.frag
+ * biome_field = shaders/biome_field.comp  local_size=8x8x1
+ *
+ * [screen]
+ * Atmosphere = CLOUD_QUALITY
+ * </pre>
+ */
+public final class NativePackParser {
+
+    private NativePackParser() { }
+
+    public static void parse(String text, PackManifest m, PackLoadReport report) {
+        if (text == null) {
+            report.error("pack.aurapack", "absent; a native pack must declare one");
+            return;
+        }
+        m.format = PackFormat.NATIVE;
+        String section = "";
+        String[] lines = text.split("\r?\n", -1);
+        for (int i = 0; i < lines.length; i++) {
+            String raw = LegacyPropertiesParser.stripComment(lines[i]).trim();
+            if (raw.isEmpty()) continue;
+            String where = "pack.aurapack:" + (i + 1);
+            if (raw.charAt(0) == '[') {
+                if (!raw.endsWith("]")) { report.error(where, "section header is not closed: " + raw); continue; }
+                section = raw.substring(1, raw.length() - 1).trim().toLowerCase(java.util.Locale.ROOT);
+                continue;
+            }
+            // A "[graph] pass ..." line carries '=' inside its own clause list
+            // (color=..., program=...), so it must be recognised before the
+            // key/value split -- splitting first read the whole line as one key.
+            if (section.equals("graph") && raw.startsWith("pass")) {
+                parsePass(raw, where, m, report);
+                continue;
+            }
+            int eq = raw.indexOf('=');
+            if (eq < 0) {
+                report.error(where, "expected 'key = value', got '" + raw + "'");
+                continue;
+            }
+            String key = raw.substring(0, eq).trim();
+            String value = raw.substring(eq + 1).trim();
+            if (section.equals("graph") && key.equals("pass")) {
+                parsePass("pass " + value, where, m, report);
+                continue;
+            }
+            dispatchSection(section, key, value, where, m, report);
+        }
+    }
+
+    private static void dispatchSection(String section, String key, String value, String where,
+                                        PackManifest m, PackLoadReport report) {
+        if (section.equals("meta")) {
+            if (key.equals("name")) m.name = value;
+            else if (key.equals("version")) m.version = value;
+            else if (key.equals("author")) m.author = value;
+            else if (key.equals("description")) m.description = value;
+            else if (key.equals("auralite.api") || key.equals("api")) {
+                try { m.apiLevel = Integer.parseInt(value); }
+                catch (NumberFormatException e) { report.error(where, "api level is not an integer: " + value); }
+            } else report.warning(where, "unknown [meta] key '" + key + "'");
+            return;
+        }
+        if (section.equals("capabilities")) {
+            if (!key.equals("require") && !key.equals("optional")) {
+                report.warning(where, "unknown [capabilities] key '" + key + "'");
+                return;
+            }
+            for (String tok : value.split(",")) {
+                String name = tok.trim();
+                if (name.isEmpty()) continue;
+                try {
+                    GfxCapability c = GfxCapability.valueOf(name.toUpperCase(java.util.Locale.ROOT));
+                    if (key.equals("require")) m.requiredCapabilities.add(c);
+                    else report.note("optional capability recorded: " + c);
+                } catch (IllegalArgumentException e) {
+                    report.error(where, "unknown capability '" + name + "'");
+                }
+            }
+            return;
+        }
+        if (section.equals("biome")) {
+            if (key.equals("spatialUniforms")) m.spatialBiomeUniforms = truthy(value);
+            else if (key.equals("sampleEntries")) {
+                try {
+                    m.biomeSampleEntries = Integer.parseInt(value);
+                    if (m.biomeSampleEntries < 1 || m.biomeSampleEntries > 4) {
+                        report.error(where, "sampleEntries must be 1..4, got " + value);
+                    }
+                } catch (NumberFormatException e) { report.error(where, "sampleEntries is not an integer"); }
+            } else report.warning(where, "unknown [biome] key '" + key + "'");
+            return;
+        }
+        if (section.equals("resources")) { parseResource(key, value, where, m, report); return; }
+        if (section.equals("options")) { parseOption(key, value, where, m, report); return; }
+        if (section.equals("programs")) { parseProgramDecl(key, value, where, m, report); return; }
+        if (section.equals("graph")) {
+            if (key.equals("present")) { m.graph.presentResource = value; return; }
+            report.warning(where, "unknown [graph] key '" + key + "'");
+            return;
+        }
+        if (section.equals("screen")) {
+            List<String> list = m.screen().get(key);
+            if (list == null) { list = new ArrayList<String>(); m.screen().put(key, list); }
+            for (String tok : LegacyPropertiesParser.splitWs(value)) {
+                list.add(tok);
+                PackOption o = m.option(tok);
+                if (o != null) o.tab(key);
+            }
+            return;
+        }
+        if (section.isEmpty()) { report.error(where, "'" + key + "' appears before any [section]"); return; }
+        report.warning(where, "unknown section [" + section + "]");
+    }
+
+    private static boolean truthy(String v) {
+        String s = v.trim().toLowerCase(java.util.Locale.ROOT);
+        return s.equals("true") || s.equals("1") || s.equals("yes") || s.equals("on");
+    }
+
+    // ------------------------------------------------------------- resources
+    private static void parseResource(String name, String value, String where,
+                                      PackManifest m, PackLoadReport report) {
+        GraphSpec.ResourceSpec r = new GraphSpec.ResourceSpec(name);
+        String[] tokens = LegacyPropertiesParser.splitWs(value);
+        if (tokens.length == 0) { report.error(where, "resource '" + name + "' has no declaration"); return; }
+        r.format = GfxFormat.fromName(tokens[0]);
+        if (r.format == GfxFormat.UNDEFINED) {
+            report.error(where, "resource '" + name + "' has unknown format '" + tokens[0] + "'");
+            return;
+        }
+        int usage = 0;
+        for (int i = 1; i < tokens.length; i++) {
+            String t = tokens[i];
+            int eqi = t.indexOf('=');
+            String flag = eqi > 0 ? t.substring(0, eqi) : t;
+            String arg = eqi > 0 ? t.substring(eqi + 1) : "";
+            if (flag.equals("fullscreen")) { r.sizeKind = GraphSpec.SizeKind.FULLSCREEN; continue; }
+            if (flag.equals("shadow")) {
+                r.sizeKind = GraphSpec.SizeKind.SHADOW;
+                usage |= GfxUsage.IMAGE_DEPTH_STENCIL_ATTACHMENT;
+                continue;
+            }
+            if (flag.equals("biome-volume") || flag.equals("biome_volume")) {
+                r.sizeKind = GraphSpec.SizeKind.BIOME_VOLUME;
+                r.is3d = true;
+                usage |= GfxUsage.IMAGE_SAMPLED;
+                continue;
+            }
+            if (flag.equals("scaled")) {
+                r.sizeKind = GraphSpec.SizeKind.SCALED;
+                try { r.scale = Double.parseDouble(arg.isEmpty() ? tokens[++i] : arg); }
+                catch (RuntimeException e) { report.error(where, "scaled needs a factor: '" + t + "'"); }
+                continue;
+            }
+            if (flag.equals("history")) { r.history = true; continue; }
+            if (flag.equals("imported")) { r.imported = true; continue; }
+            if (flag.equals("3d")) { r.is3d = true; continue; }
+            if (flag.equals("mips")) {
+                try { r.mipLevels = Integer.parseInt(arg.isEmpty() ? tokens[++i] : arg); }
+                catch (RuntimeException e) { report.error(where, "mips needs a count: '" + t + "'"); }
+                continue;
+            }
+            if (flag.equals("layers")) {
+                try { r.arrayLayers = Integer.parseInt(arg.isEmpty() ? tokens[++i] : arg); }
+                catch (RuntimeException e) { report.error(where, "layers needs a count: '" + t + "'"); }
+                continue;
+            }
+            if (flag.equals("usage")) {
+                for (String u : arg.split("\\|")) usage |= parseUsage(u.trim(), where, report);
+                continue;
+            }
+            // Bare "WxH" or "WxHxD".
+            int[] dims = dev.auralite.render.util.Extents.parse(flag);
+            if (dims != null && !flag.contains(",")) {
+                r.sizeKind = GraphSpec.SizeKind.FIXED;
+                r.fixedWidth = dims[0];
+                r.fixedHeight = dims[1];
+                r.fixedDepth = dims[2];
+                continue;
+            }
+            report.error(where, "resource '" + name + "' has unknown token '" + t + "'");
+        }
+        if (usage == 0) {
+            usage = r.format.isDepthStencil()
+                    ? GfxUsage.IMAGE_SAMPLED | GfxUsage.IMAGE_DEPTH_STENCIL_ATTACHMENT
+                    : GfxUsage.IMAGE_SAMPLED | GfxUsage.IMAGE_COLOR_ATTACHMENT;
+        }
+        r.usage = usage;
+        m.graph.addResource(r);
+    }
+
+    private static int parseUsage(String u, String where, PackLoadReport report) {
+        String k = u.toLowerCase(java.util.Locale.ROOT);
+        if (k.equals("sampled")) return GfxUsage.IMAGE_SAMPLED;
+        if (k.equals("storage")) return GfxUsage.IMAGE_STORAGE;
+        if (k.equals("color")) return GfxUsage.IMAGE_COLOR_ATTACHMENT;
+        if (k.equals("depth")) return GfxUsage.IMAGE_DEPTH_STENCIL_ATTACHMENT;
+        if (k.equals("present")) return GfxUsage.IMAGE_PRESENT;
+        if (k.equals("transient")) return GfxUsage.IMAGE_TRANSIENT_ATTACHMENT;
+        if (k.equals("input")) return GfxUsage.IMAGE_INPUT_ATTACHMENT;
+        if (k.equals("transfer-src")) return GfxUsage.IMAGE_TRANSFER_SRC;
+        if (k.equals("transfer-dst")) return GfxUsage.IMAGE_TRANSFER_DST;
+        report.warning(where, "unknown usage flag '" + u + "'");
+        return 0;
+    }
+
+    // ---------------------------------------------------------------- options
+    private static void parseOption(String name, String value, String where,
+                                    PackManifest m, PackLoadReport report) {
+        // <kind> "<label>" [ { v=Label, ... } ] [default=<v>] [tab=<t>] [min..max step s]
+        int q1 = value.indexOf('"');
+        String head = q1 >= 0 ? value.substring(0, q1).trim() : value;
+        String label = "";
+        String rest = value;
+        if (q1 >= 0) {
+            int q2 = value.indexOf('"', q1 + 1);
+            if (q2 < 0) { report.error(where, "option '" + name + "' has an unterminated label"); return; }
+            label = value.substring(q1 + 1, q2);
+            rest = value.substring(q2 + 1).trim();
+        }
+        String kindToken = head.isEmpty() ? "define" : head.split("\\s+")[0].toLowerCase(java.util.Locale.ROOT);
+        PackOption.Kind kind;
+        if (kindToken.equals("bool")) kind = PackOption.Kind.BOOL;
+        else if (kindToken.equals("const")) kind = PackOption.Kind.CONST;
+        else if (kindToken.equals("slider")) kind = PackOption.Kind.SLIDER;
+        else if (kindToken.equals("select") || kindToken.equals("selector")) kind = PackOption.Kind.SELECTOR;
+        else if (kindToken.equals("define")) kind = PackOption.Kind.DEFINE;
+        else { report.error(where, "option '" + name + "' has unknown kind '" + kindToken + "'"); return; }
+
+        PackOption o = new PackOption(name, kind).label(label);
+        if (kind == PackOption.Kind.BOOL) { o.choice("true", "On"); o.choice("false", "Off"); }
+
+        // Slider range embedded in the head: "slider 0.0..2.0 step 0.05"
+        if (kind == PackOption.Kind.SLIDER) {
+            String[] hp = head.split("\\s+");
+            for (int i = 1; i < hp.length; i++) {
+                if (hp[i].contains("..")) {
+                    String[] r = hp[i].split("\\.\\.");
+                    try { o.slider(Double.parseDouble(r[0]), Double.parseDouble(r[1]), 1.0); }
+                    catch (RuntimeException e) { report.error(where, "bad slider range '" + hp[i] + "'"); }
+                }
+                if (hp[i].equals("step") && i + 1 < hp.length) {
+                    try { o.sliderStep = Double.parseDouble(hp[++i]); }
+                    catch (RuntimeException e) { report.error(where, "bad slider step"); }
+                }
+            }
+        }
+
+        // Choice block "{ 14=Cheap, 24=Standard }"
+        int b1 = rest.indexOf('{');
+        if (b1 >= 0) {
+            int b2 = rest.indexOf('}', b1);
+            if (b2 < 0) { report.error(where, "option '" + name + "' has an unterminated choice block"); return; }
+            String body = rest.substring(b1 + 1, b2);
+            for (String part : body.split(",")) {
+                String p = part.trim();
+                if (p.isEmpty()) continue;
+                int e2 = p.indexOf('=');
+                if (e2 < 0) o.choice(p, p);
+                else o.choice(p.substring(0, e2).trim(), p.substring(e2 + 1).trim());
+            }
+            rest = rest.substring(b2 + 1).trim();
+        }
+
+        for (String tok : LegacyPropertiesParser.splitWs(rest)) {
+            int e2 = tok.indexOf('=');
+            if (e2 < 0) { report.warning(where, "option '" + name + "' ignores token '" + tok + "'"); continue; }
+            String k = tok.substring(0, e2).trim(), v = tok.substring(e2 + 1).trim();
+            if (k.equals("default")) o.defaultValue(v);
+            else if (k.equals("tab")) o.tab(v);
+            else if (k.equals("comment")) o.comment(v);
+            else report.warning(where, "option '" + name + "' has unknown attribute '" + k + "'");
+        }
+        if (o.defaultValue.equals("") && !o.choices().isEmpty()) {
+            o.defaultValue(o.choices().get(0).value);
+        }
+        if (!o.defaultValue.isEmpty() && !o.accepts(o.defaultValue)) {
+            report.error(where, "option '" + name + "' default '" + o.defaultValue
+                    + "' is not one of its declared values");
+            return;
+        }
+        m.addOption(o);
+    }
+
+    // -------------------------------------------------------------- programs
+    private static void parseProgramDecl(String name, String value, String where,
+                                         PackManifest m, PackLoadReport report) {
+        PackProgram p = m.program(name);
+        if (p == null) { p = new PackProgram(name); m.addProgram(p); }
+        // Grammar: "path[, path ...] [key=value ...]". A token is an attribute
+        // if and only if it carries '=', otherwise it is a source path. Anything
+        // cleverer is ambiguous: splitting only on spaces read
+        // "shaders/ssao.comp local_size=16x16x1" as one path plus a nonsense
+        // attribute, and splitting only on '=' read the path as the attribute
+        // name. This rule is total and the pack author can see it in one line.
+        List<String> paths = new ArrayList<String>();
+        String[] parts = value.split(",");
+        for (int i = 0; i < parts.length; i++) {
+            String[] tokens = parts[i].trim().split("\\s+");
+            for (int j = 0; j < tokens.length; j++) {
+                String tok = tokens[j];
+                if (tok.isEmpty()) continue;
+                int eq = tok.indexOf('=');
+                if (eq < 0) { paths.add(tok); continue; }
+                String attr = tok.substring(0, eq);
+                String arg = tok.substring(eq + 1);
+                if (attr.equals("local_size") || attr.equals("localSize")) {
+                    int[] d = dev.auralite.render.util.Extents.parse(arg);
+                    if (d == null) report.error(where, "bad local_size '" + arg + "'");
+                    else { p.localSizeX = d[0]; p.localSizeY = d[1]; p.localSizeZ = d[2]; }
+                    continue;
+                }
+                if (attr.equals("pass")) { p.boundPass = arg; continue; }
+                report.warning(where, "program '" + name + "' ignores attribute '" + attr + "'");
+            }
+        }
+        p.sourcePaths.addAll(paths);
+    }
+
+    // ------------------------------------------------------------------ graph
+    private static void parsePass(String raw, String where, PackManifest m, PackLoadReport report) {
+        String[] t = LegacyPropertiesParser.splitWs(raw);
+        if (t.length < 3) { report.error(where, "'pass' needs a name and a type"); return; }
+        GraphSpec.PassSpec p = new GraphSpec.PassSpec(t[1]);
+        p.type = t[2].toLowerCase(java.util.Locale.ROOT);
+        if (!p.type.equals("raster") && !p.type.equals("compute") && !p.type.equals("copy")) {
+            report.error(where, "pass '" + p.name + "' has unknown type '" + p.type + "'");
+            return;
+        }
+        for (int i = 3; i < t.length; i++) {
+            String tok = t[i];
+            int eq = tok.indexOf('=');
+            if (eq < 0) {
+                if (tok.equals("external")) { p.external = true; continue; }
+                report.error(where, "pass '" + p.name + "' has a clause without a value: '" + tok + "'");
+                continue;
+            }
+            String k = tok.substring(0, eq), v = tok.substring(eq + 1);
+            if (k.equals("color") || k.equals("colors")) addAll(p.colors, v);
+            else if (k.equals("depth")) p.depth = v;
+            else if (k.equals("read") || k.equals("reads")) addAll(p.reads, v);
+            else if (k.equals("write") || k.equals("writes")) addAll(p.writes, v);
+            else if (k.equals("program")) p.program = v;
+            else if (k.equals("when")) p.when = v;
+            else if (k.equals("dispatch")) {
+                if (v.contains("(") || v.contains("width") || v.contains("height")) {
+                    p.dispatchExpr = v;
+                } else {
+                    String[] d = v.split(",");
+                    try {
+                        p.dispatchX = Integer.parseInt(d[0].trim());
+                        p.dispatchY = d.length > 1 ? Integer.parseInt(d[1].trim()) : 1;
+                        p.dispatchZ = d.length > 2 ? Integer.parseInt(d[2].trim()) : 1;
+                    } catch (RuntimeException e) { report.error(where, "bad dispatch '" + v + "'"); }
+                }
+            } else report.warning(where, "pass '" + p.name + "' ignores clause '" + k + "'");
+        }
+        if (m.graph.findPass(p.name) != null) {
+            report.error(where, "pass '" + p.name + "' is declared twice");
+            return;
+        }
+        m.graph.addPass(p);
+    }
+
+    private static void addAll(List<String> into, String csv) {
+        for (String s : csv.split(",")) {
+            String t = s.trim();
+            if (!t.isEmpty()) into.add(t);
+        }
+    }
+}
diff --git a/core/src/main/java/dev/auralite/render/pack/PackFormat.java b/core/src/main/java/dev/auralite/render/pack/PackFormat.java
new file mode 100644
index 0000000..4849872
--- /dev/null
+++ b/core/src/main/java/dev/auralite/render/pack/PackFormat.java
@@ -0,0 +1,34 @@
+package dev.auralite.render.pack;
+
+/**
+ * The two pack modes.
+ *
+ * <p>{@link #LEGACY_IRIS} reads an OptiFine/Iris pack exactly as shipped:
+ * {@code shaders.properties}, filename-derived program names, scalar
+ * CPU-evaluated custom uniforms. It exists so AuraLite-Shaders, Complementary
+ * and BSL keep working on day one, and it is the lane the parity gate measures
+ * against.
+ *
+ * <p>{@link #NATIVE} reads {@code pack.aurapack}: an explicit resource table, a
+ * declared render-graph DAG, compute passes, a required-capability list and a
+ * versioned API level. Nothing is inferred from filenames.
+ *
+ * <p>A directory containing both is loaded as NATIVE and the legacy tree is
+ * ignored, with that decision recorded in the load report rather than made
+ * silently.
+ */
+public enum PackFormat {
+    LEGACY_IRIS("shaders.properties", "Iris/OptiFine compatible"),
+    NATIVE("pack.aurapack", "AuraLite-Render native");
+
+    private final String markerFile;
+    private final String description;
+
+    PackFormat(String markerFile, String description) {
+        this.markerFile = markerFile;
+        this.description = description;
+    }
+
+    public String markerFile() { return markerFile; }
+    public String description() { return description; }
+}
diff --git a/core/src/main/java/dev/auralite/render/pack/PackGraphBuilder.java b/core/src/main/java/dev/auralite/render/pack/PackGraphBuilder.java
new file mode 100644
index 0000000..a232b87
--- /dev/null
+++ b/core/src/main/java/dev/auralite/render/pack/PackGraphBuilder.java
@@ -0,0 +1,313 @@
+package dev.auralite.render.pack;
+
+import dev.auralite.render.rhi.GfxDesc;
+import dev.auralite.render.rhi.GfxEnums.Access;
+import dev.auralite.render.rhi.GfxEnums.ImageType;
+import dev.auralite.render.rhi.GfxEnums.PassType;
+import dev.auralite.render.rhi.GfxUsage;
+import dev.auralite.render.graph.RenderGraph;
+import dev.auralite.render.uniform.ExprEnv;
+import dev.auralite.render.uniform.ExprParser;
+import dev.auralite.render.uniform.FunctionTable;
+import dev.auralite.render.uniform.Value;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Manifest to {@link RenderGraph}.
+ *
+ * <p>Two entry points, one output. {@link #buildNative} walks the pack's
+ * declared DAG; {@link #buildLegacy} synthesises the Iris-shaped frame from the
+ * programs a legacy pack happens to contain. Both produce the same kind of
+ * compiled graph, so a legacy pack runs on the new pipeline -- barriers,
+ * lifetimes and all -- without being converted, and the two can be diffed
+ * against each other pass by pass.
+ */
+public final class PackGraphBuilder {
+
+    private static final Pattern COMPOSITE_INDEX = Pattern.compile("^composite(\\d*)$");
+    private static final Pattern DEFERRED_INDEX = Pattern.compile("^deferred(\\d*)$");
+
+    private final PackManifest manifest;
+    private final PipelineProvider pipelines;
+
+    public PackGraphBuilder(PackManifest manifest, PipelineProvider pipelines) {
+        this.manifest = manifest;
+        this.pipelines = pipelines;
+    }
+
+    public PackManifest manifest() { return manifest; }
+
+    /** Dispatches on the manifest's format. */
+    public RenderGraph build(int width, int height, int shadowMapSize, int[] biomeCells) {
+        return manifest.format == PackFormat.NATIVE
+                ? buildNative(width, height, shadowMapSize, biomeCells)
+                : buildLegacy(width, height, shadowMapSize);
+    }
+
+    // ----------------------------------------------------------------- native
+    public RenderGraph buildNative(int width, int height, int shadowMapSize, int[] biomeCells) {
+        RenderGraph g = new RenderGraph("native:" + manifest.name);
+        this.activeGraph = g;
+        GraphSpec spec = manifest.graph;
+
+        for (GraphSpec.ResourceSpec r : spec.resources()) {
+            int[] ext = r.extent(width, height, shadowMapSize, biomeCells);
+            GfxDesc.Image d;
+            if (r.is3d) {
+                d = GfxDesc.Image.tex3d(ext[0], ext[1], ext[2], r.format, r.usage);
+            } else {
+                d = GfxDesc.Image.tex2d(ext[0], ext[1], r.format, r.usage);
+            }
+            d.type = r.is3d ? ImageType.TEXTURE_3D : ImageType.TEXTURE_2D;
+            d.mipLevels = r.mipLevels;
+            d.arrayLayers = r.arrayLayers;
+            if (r.imported) g.importTexture(r.name, d);
+            else if (r.history) g.addHistory(r.name, d);
+            else g.addTexture(r.name, d);
+        }
+
+        ExprEnv env = new ExprEnv(new FunctionTable());
+        for (GraphSpec.PassSpec p : spec.passes()) {
+            PassType type = p.isCompute() ? PassType.COMPUTE : (p.isCopy() ? PassType.COPY : PassType.RASTER);
+            RenderGraph.PassBuilder b = g.addPass(p.name, type);
+
+            for (int i = 0; i < p.colors.size(); i++) {
+                String c = resolveHistoryName(p.colors.get(i));
+                b.color(c);
+            }
+            if (!p.depth.isEmpty()) b.depth(resolveHistoryName(p.depth), true);
+            for (String r : p.reads) b.read(resolveHistoryName(r), Access.SHADER_READ);
+            for (String w : p.writes) {
+                String name = resolveHistoryName(w);
+                if (g.require(name).isTexture()) b.write(name, Access.SHADER_WRITE);
+                else b.write(name, Access.TRANSFER_WRITE);
+            }
+            if (p.isCompute()) {
+                int[] d = resolveDispatch(p, env, width, height);
+                b.dispatch(d[0], d[1], d[2]);
+            }
+            if (!p.when.isEmpty()) {
+                b.when(p.when, manifest.optionEnabled(p.when));
+            }
+            if (p.external) b.external();
+
+            final String programName = p.program;
+            final boolean compute = p.isCompute();
+            b.body(new dev.auralite.render.graph.GraphPass.Executor() {
+                @Override public void execute(dev.auralite.render.graph.GraphContext ctx) {
+                    if (programName.isEmpty() || pipelines == null) return;
+                    // The graph opens and closes the render pass around this
+                    // body and sets the viewport to that pass's own area, so all
+                    // a body does is bind its pipeline and issue its work.
+                    if (compute) {
+                        dev.auralite.render.rhi.GfxPipeline pipe = pipelines.computePipeline(programName);
+                        if (pipe != null) {
+                            ctx.cmd().bindComputePipeline(pipe);
+                            ctx.cmd().dispatch(ctx.currentPass().groupsX(),
+                                    ctx.currentPass().groupsY(), ctx.currentPass().groupsZ());
+                        }
+                    } else {
+                        dev.auralite.render.rhi.GfxPipeline pipe =
+                                pipelines.rasterPipeline(programName, currentPassDesc(ctx));
+                        if (pipe != null) ctx.cmd().bindGraphicsPipeline(pipe);
+                    }
+                }
+            });
+        }
+        return g;
+    }
+
+    /**
+     * The render pass a body's pipeline must be compatible with.
+     *
+     * <p>It is this pass's own area, not the framebuffer's: building the
+     * 256x256 cloud-shadow pipeline against 1920x1080 is wrong on Vulkan
+     * (render-pass compatibility) and silently wrong on OpenGL (the viewport
+     * would cover pixels the target does not have).
+     */
+    private GfxDesc.RenderPass currentPassDesc(dev.auralite.render.graph.GraphContext ctx) {
+        int[] area = ctx.renderArea();
+        return GfxDesc.RenderPass.of(area[0], area[1]).named(ctx.currentPass().name());
+    }
+
+    /** Maps {@code foo.prev} / {@code foo.cur} onto the history pair's real names. */
+    private String resolveHistoryName(String declared) {
+        for (dev.auralite.render.graph.GraphHistory h : historyList()) {
+            if (declared.equals(h.logicalName() + ".prev")) return h.previousName();
+            if (declared.equals(h.logicalName() + ".cur")) return h.currentName();
+            if (declared.equals(h.logicalName())) return h.currentName();
+        }
+        return declared;
+    }
+
+    /** The graph currently being built, so history names resolve against it. */
+    private RenderGraph activeGraph;
+
+    private List<dev.auralite.render.graph.GraphHistory> historyList() {
+        return activeGraph == null
+                ? Collections.<dev.auralite.render.graph.GraphHistory>emptyList()
+                : activeGraph.histories();
+    }
+
+    // ----------------------------------------------------------------- legacy
+    /**
+     * Synthesises the Iris-shaped frame from the programs present.
+     *
+     * <p>Order: {@code shadow} first, then the terrain-family gbuffers in Iris's
+     * fixed sequence, then {@code deferred*}, {@code composite*} and
+     * {@code final}. Programs the pack does not ship are skipped, which is how
+     * Iris behaves too.
+     */
+    public RenderGraph buildLegacy(int width, int height, int shadowMapSize) {
+        RenderGraph g = new RenderGraph("legacy:" + manifest.name);
+        this.activeGraph = g;
+
+        GfxDesc.Image colorDesc = GfxDesc.Image.tex2d(width, height,
+                dev.auralite.render.rhi.GfxFormat.RGBA16F,
+                GfxUsage.IMAGE_COLOR_ATTACHMENT | GfxUsage.IMAGE_SAMPLED);
+        GfxDesc.Image depthDesc = GfxDesc.Image.tex2d(width, height,
+                dev.auralite.render.rhi.GfxFormat.D32_SFLOAT,
+                GfxUsage.IMAGE_DEPTH_STENCIL_ATTACHMENT | GfxUsage.IMAGE_SAMPLED);
+        GfxDesc.Image shadowDesc = GfxDesc.Image.tex2d(shadowMapSize, shadowMapSize,
+                dev.auralite.render.rhi.GfxFormat.D32_SFLOAT,
+                GfxUsage.IMAGE_DEPTH_STENCIL_ATTACHMENT | GfxUsage.IMAGE_SAMPLED);
+
+        g.addTexture("scene_color", colorDesc);
+        g.addTexture("scene_depth", depthDesc);
+        if (manifest.hasProgram("shadow") || manifest.hasProgram("shadow_solid")) {
+            g.addTexture("shadow_depth", shadowDesc);
+        }
+
+        if (g.find("shadow_depth") != null) {
+            g.addRasterPass("shadow_map")
+                    .depth("shadow_depth", true)
+                    // Nothing in the graph reads shadow_depth, and culling it
+                    // would be correct graph reasoning and a frame with no
+                    // shadows: legacy packs sample shadowtex0/shadowcolor0 from
+                    // any later program through implicit bindings.
+                    .keep("legacy packs sample shadowtex0/shadowcolor0 implicitly")
+                    .body(noopBody("shadow"));
+        }
+
+        String[] terrainFamily = {
+                "gbuffers_terrain", "gbuffers_block", "gbuffers_water", "gbuffers_weather",
+                "gbuffers_clouds", "gbuffers_entities", "gbuffers_textured", "gbuffers_basic",
+                "gbuffers_hand", "gbuffers_hand_water"
+        };
+        boolean first = true;
+        for (String program : terrainFamily) {
+            if (!usable(program)) continue;
+            RenderGraph.PassBuilder b = g.addRasterPass(program)
+                    .color("scene_color", first ? 1 : 0);
+            if (g.find("scene_depth") != null) b.depth("scene_depth", first);
+            b.body(noopBody(program));
+            first = false;
+        }
+
+        for (String program : indexedPrograms(DEFERRED_INDEX)) {
+            if (!usable(program)) continue;
+            g.addRasterPass(program)
+                    .color("scene_color", 0)
+                    .read("scene_color", Access.SHADER_READ)
+                    .body(noopBody(program));
+        }
+
+        for (String program : indexedPrograms(COMPOSITE_INDEX)) {
+            if (!usable(program)) continue;
+            g.addRasterPass(program)
+                    .color("scene_color", 0)
+                    .read("scene_color", Access.SHADER_READ)
+                    .body(noopBody(program));
+        }
+
+        String last = manifest.hasProgram("final") ? "final"
+                : (manifest.hasProgram("composite") ? "composite" : null);
+        if (last != null) {
+            g.addRasterPass("present")
+                    .color("scene_color", 0)
+                    .read("scene_color", Access.SHADER_READ)
+                    .external()
+                    .body(noopBody(last));
+        }
+        return g;
+    }
+
+    private boolean usable(String program) {
+        PackProgram p = manifest.program(program);
+        return p != null && p.enabled && p.stageCount() > 0;
+    }
+
+    /** Program names matching {@code pattern}, ordered by their numeric suffix. */
+    private List<String> indexedPrograms(Pattern pattern) {
+        List<int[]> withIndex = new ArrayList<int[]>();
+        List<String> names = new ArrayList<String>();
+        for (PackProgram p : manifest.programs()) {
+            Matcher m = pattern.matcher(p.name);
+            if (!m.matches()) continue;
+            String digits = m.group(1);
+            int idx = digits.isEmpty() ? 0 : Integer.parseInt(digits);
+            withIndex.add(new int[] { idx, withIndex.size() });
+            names.add(p.name);
+        }
+        List<Integer> order = new ArrayList<Integer>();
+        for (int i = 0; i < withIndex.size(); i++) order.add(i);
+        Collections.sort(order, (a, b) -> Integer.compare(withIndex.get(a)[0], withIndex.get(b)[0]));
+        List<String> out = new ArrayList<String>();
+        for (int i : order) out.add(names.get(i));
+        return out;
+    }
+
+    private dev.auralite.render.graph.GraphPass.Executor noopBody(final String program) {
+        return new dev.auralite.render.graph.GraphPass.Executor() {
+            @Override public void execute(dev.auralite.render.graph.GraphContext ctx) {
+                if (pipelines == null) return;
+                dev.auralite.render.rhi.GfxPipeline pipe = pipelines.rasterPipeline(program, null);
+                if (pipe != null) ctx.cmd().bindGraphicsPipeline(pipe);
+            }
+        };
+    }
+
+    // --------------------------------------------------------------- dispatch
+    /** Evaluates a dispatch clause such as {@code ceil(width/8),ceil(height/8),1}. */
+    public static int[] resolveDispatch(GraphSpec.PassSpec p, ExprEnv env, int width, int height) {
+        if (p.dispatchX > 0) return new int[] { p.dispatchX, Math.max(1, p.dispatchY), Math.max(1, p.dispatchZ) };
+        if (p.dispatchExpr == null || p.dispatchExpr.trim().isEmpty()) {
+            return new int[] { 1, 1, 1 };
+        }
+        env.bindInt("width", width);
+        env.bindInt("height", height);
+        List<String> parts = splitTopLevel(p.dispatchExpr, ',');
+        int[] out = new int[] { 1, 1, 1 };
+        for (int i = 0; i < Math.min(3, parts.size()); i++) {
+            try {
+                Value v = ExprParser.parse(parts.get(i).trim()).eval(env);
+                out[i] = Math.max(1, v.asInt());
+            } catch (RuntimeException e) {
+                out[i] = 1;
+            }
+        }
+        return out;
+    }
+
+    /** Splits on {@code sep} ignoring separators nested in parentheses. */
+    public static List<String> splitTopLevel(String s, char sep) {
+        List<String> out = new ArrayList<String>();
+        int depth = 0, start = 0;
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            if (c == '(' || c == '[' || c == '{') depth++;
+            else if (c == ')' || c == ']' || c == '}') depth--;
+            else if (c == sep && depth == 0) {
+                out.add(s.substring(start, i));
+                start = i + 1;
+            }
+        }
+        out.add(s.substring(start));
+        return out;
+    }
+}
diff --git a/core/src/main/java/dev/auralite/render/pack/PackLoadReport.java b/core/src/main/java/dev/auralite/render/pack/PackLoadReport.java
new file mode 100644
index 0000000..c9f447a
--- /dev/null
+++ b/core/src/main/java/dev/auralite/render/pack/PackLoadReport.java
@@ -0,0 +1,60 @@
+package dev.auralite.render.pack;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+/**
+ * What loading a pack actually did.
+ *
+ * <p>Errors refuse the pack, warnings let it run, notes record decisions that
+ * would otherwise be invisible -- including the format that was chosen when a
+ * pack ships both trees. Every line carries the file it came from, because
+ * "your pack is broken" without a location is not a useful message.
+ */
+public final class PackLoadReport {
+    private final List<String> errors = new ArrayList<String>();
+    private final List<String> warnings = new ArrayList<String>();
+    private final List<String> notes = new ArrayList<String>();
+    private final List<String> unparsed = new ArrayList<String>();
+    private long loadMicros;
+    private int programFilesRead;
+    private long shaderBytesRead;
+
+    public PackLoadReport error(String where, String what) { errors.add(where + ": " + what); return this; }
+    public PackLoadReport warning(String where, String what) { warnings.add(where + ": " + what); return this; }
+    public PackLoadReport note(String what) { notes.add(what); return this; }
+    public PackLoadReport unparsed(String where, String line) { unparsed.add(where + ": " + line); return this; }
+
+    public List<String> errors() { return Collections.unmodifiableList(errors); }
+    public List<String> warnings() { return Collections.unmodifiableList(warnings); }
+    public List<String> notes() { return Collections.unmodifiableList(notes); }
+    public List<String> unparsed() { return Collections.unmodifiableList(unparsed); }
+
+    public boolean ok() { return errors.isEmpty(); }
+    public int errorCount() { return errors.size(); }
+    public int warningCount() { return warnings.size(); }
+
+    public void setLoadMicros(long us) { this.loadMicros = us; }
+    public long loadMicros() { return loadMicros; }
+    public void countProgramFile(long bytes) { programFilesRead++; shaderBytesRead += bytes; }
+    public int programFilesRead() { return programFilesRead; }
+    public long shaderBytesRead() { return shaderBytesRead; }
+
+    public String receipt() {
+        StringBuilder sb = new StringBuilder();
+        sb.append("pack load: ").append(ok() ? "OK" : "REFUSED").append(" in ")
+          .append(loadMicros).append(" us, ").append(programFilesRead).append(" program files, ")
+          .append(shaderBytesRead).append(" B\n");
+        for (String e : errors) sb.append("  ERROR: ").append(e).append('\n');
+        for (String w : warnings) sb.append("  warning: ").append(w).append('\n');
+        for (String n : notes) sb.append("  note: ").append(n).append('\n');
+        if (!unparsed.isEmpty()) {
+            sb.append("  unparsed: ").append(unparsed.size()).append(" line(s)\n");
+            int shown = Math.min(unparsed.size(), 12);
+            for (int i = 0; i < shown; i++) sb.append("    ").append(unparsed.get(i)).append('\n');
+            if (unparsed.size() > shown) sb.append("    ... ").append(unparsed.size() - shown).append(" more\n");
+        }
+        return sb.toString();
+    }
+}
diff --git a/core/src/main/java/dev/auralite/render/pack/PackLoader.java b/core/src/main/java/dev/auralite/render/pack/PackLoader.java
new file mode 100644
index 0000000..8dff109
--- /dev/null
+++ b/core/src/main/java/dev/auralite/render/pack/PackLoader.java
@@ -0,0 +1,308 @@
+package dev.auralite.render.pack;
+
+import dev.auralite.render.rhi.GfxCapability;
+import dev.auralite.render.rhi.GfxDevice;
+import dev.auralite.render.rhi.GfxStage;
+import dev.auralite.render.rhi.ShaderSource;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Set;
+
+/**
+ * Loads a pack from a {@link PackSource} into a {@link PackManifest}.
+ *
+ * <p>Detection, parsing, program discovery and validation happen here and only
+ * here, so a pack that cannot run is refused with a named reason before a
+ * single shader is compiled. In particular the capability contract is checked
+ * against the device up front: a pack that needs {@code COMPUTE_SHADERS} on a
+ * driver that does not have them is told so, rather than producing a black
+ * screen and a confused log line three passes in.
+ */
+public final class PackLoader {
+
+    /** Dimensions a legacy pack may specialise for, matching Iris's directory names. */
+    public static final List<String> LEGACY_WORLD_DIRS =
+            Collections.unmodifiableList(Arrays.asList("", "world-1/", "world1/", "world0/"));
+
+    private final PackSource source;
+    private final PackManifest manifest = new PackManifest();
+    private final PackLoadReport report = new PackLoadReport();
+
+    public PackLoader(PackSource source) {
+        this.source = source;
+        this.manifest.origin = source.origin();
+    }
+
+    public PackManifest manifest() { return manifest; }
+    public PackLoadReport report() { return report; }
+
+    /** Detects the format without loading anything. */
+    public static PackFormat detect(PackSource source) {
+        if (source.exists(PackFormat.NATIVE.markerFile())) return PackFormat.NATIVE;
+        if (source.exists("shaders/" + PackFormat.LEGACY_IRIS.markerFile())) return PackFormat.LEGACY_IRIS;
+        if (source.exists(PackFormat.LEGACY_IRIS.markerFile())) return PackFormat.LEGACY_IRIS;
+        // A pack with neither marker is still loadable as legacy if it has programs.
+        if (!source.list("shaders/").isEmpty()) return PackFormat.LEGACY_IRIS;
+        return null;
+    }
+
+    /** Full load. Returns false when the pack was refused. */
+    public boolean load() {
+        return load(null);
+    }
+
+    /**
+     * Full load, validating against {@code device} when one is supplied.
+     * Tests pass {@code null} and get format-level validation only.
+     */
+    public boolean load(GfxDevice device) {
+        long t0 = System.nanoTime();
+        PackFormat format = detect(source);
+        if (format == null) {
+            report.error(source.origin(), "neither '" + PackFormat.NATIVE.markerFile() + "' nor a '"
+                    + "shaders/' tree was found; this does not look like a shader pack");
+            report.setLoadMicros((System.nanoTime() - t0) / 1000L);
+            return false;
+        }
+        manifest.format = format;
+
+        if (format == PackFormat.NATIVE) {
+            if (source.exists("shaders/" + PackFormat.LEGACY_IRIS.markerFile())) {
+                report.note("pack ships both trees; loaded as NATIVE and the legacy tree was ignored");
+            }
+            NativePackParser.parse(source.readText(PackFormat.NATIVE.markerFile()), manifest, report);
+        } else {
+            String props = source.readText("shaders/" + PackFormat.LEGACY_IRIS.markerFile());
+            if (props == null) props = source.readText(PackFormat.LEGACY_IRIS.markerFile());
+            LegacyPropertiesParser.parse(props, manifest, report);
+            applyLegacyDefaults(manifest);
+        }
+
+        if (manifest.apiLevel > PackManifest.CURRENT_API_LEVEL) {
+            report.error("meta", "pack requires API level " + manifest.apiLevel
+                    + " but this loader implements " + PackManifest.CURRENT_API_LEVEL);
+        }
+
+        discoverPrograms();
+        validate(device);
+
+        report.setLoadMicros((System.nanoTime() - t0) / 1000L);
+        if (manifest.name.equals("<unnamed>")) manifest.name = guessName();
+        return report.ok();
+    }
+
+    private String guessName() {
+        String o = source.origin();
+        int slash = Math.max(o.lastIndexOf('/'), o.lastIndexOf('\\'));
+        String base = slash >= 0 ? o.substring(slash + 1) : o;
+        if (base.endsWith(".zip")) base = base.substring(0, base.length() - 4);
+        return base.isEmpty() ? "<unnamed>" : base;
+    }
+
+    /** LEGACY packs get the settings Iris assumes when the file does not say. */
+    private static void applyLegacyDefaults(PackManifest m) {
+        if (!m.settings().containsKey("shadowDistance")) m.settings().put("shadowDistance", "128");
+        if (!m.settings().containsKey("shadowMapResolution")) m.settings().put("shadowMapResolution", "2048");
+        // Iris exposes these to every legacy pack; declaring them keeps the
+        // option table honest about what a pack can actually toggle.
+        for (String[] def : new String[][] {
+                { "AURALITE_SPATIAL_BIOME", "false", "Evaluate biome-dependent uniforms per cell" } }) {
+            if (!m.hasOption(def[0])) {
+                PackOption o = new PackOption(def[0], PackOption.Kind.BOOL)
+                        .label(def[2]).defaultValue(def[1]).tab("AuraLite-Render");
+                o.choice("true", "On");
+                o.choice("false", "Off");
+                m.addOption(o);
+            }
+        }
+    }
+
+    // -------------------------------------------------------------- programs
+    private void discoverPrograms() {
+        Set<String> names = new LinkedHashSet<String>();
+        if (manifest.format == PackFormat.NATIVE) {
+            // A native pack declares its programs and their stages explicitly in
+            // [programs]. Inferring them from filenames would reintroduce exactly
+            // the coupling the format exists to remove, and would silently bind
+            // files the pack never mentioned.
+            bindNativeProgramSources();
+            if (manifest.programCount() == 0) {
+                report.warning("[programs]", "no programs declared");
+            }
+            return;
+        }
+        for (String dir : LEGACY_WORLD_DIRS) {
+            for (String path : source.list("shaders/" + dir)) {
+                String file = path.substring(path.lastIndexOf('/') + 1);
+                int dot = file.lastIndexOf('.');
+                if (dot <= 0) continue;
+                String ext = file.substring(dot + 1).toLowerCase(java.util.Locale.ROOT);
+                GfxStage stage = GfxStage.fromExtension(ext);
+                if (stage == null) continue;
+                String base = file.substring(0, dot);
+                names.add(base);
+                PackProgram p = manifest.program(base);
+                if (p == null) { p = new PackProgram(base); manifest.addProgram(p); }
+                String text = source.readText(path);
+                if (text == null) {
+                    report.warning(path, "listed but unreadable");
+                    continue;
+                }
+                report.countProgramFile(text.length());
+                p.stage(stage, ShaderSource.glsl(stage, text, path));
+            }
+        }
+        if (names.isEmpty() && manifest.programCount() == 0) {
+            report.warning("shaders/", "no program sources found");
+        }
+    }
+
+    /** Resolves every {@code [programs]} declaration to real shader sources. */
+    private void bindNativeProgramSources() {
+        for (PackProgram p : manifest.programs()) {
+            for (String path : p.sourcePaths) {
+                String file = path.substring(path.lastIndexOf('/') + 1);
+                int dot = file.lastIndexOf('.');
+                if (dot <= 0) {
+                    report.error(path, "program source has no stage extension");
+                    continue;
+                }
+                GfxStage stage = GfxStage.fromExtension(file.substring(dot + 1));
+                if (stage == null) {
+                    report.error(path, "unknown stage extension in '" + file + "'");
+                    continue;
+                }
+                String text = source.readText(path);
+                if (text == null) {
+                    report.error(path, "declared by [programs] but not present in the pack");
+                    continue;
+                }
+                report.countProgramFile(text.length());
+                p.stage(stage, ShaderSource.glsl(stage, text, path));
+            }
+        }
+        for (GraphSpec.PassSpec pass : manifest.graph.passes()) {
+            if (pass.program.isEmpty()) continue;
+            PackProgram p = manifest.program(pass.program);
+            if (p == null) {
+                report.error("[graph]", "pass '" + pass.name + "' refers to program '"
+                        + pass.program + "', which is not declared");
+                continue;
+            }
+            if (p.boundPass.isEmpty()) p.boundPass = pass.name;
+            if (pass.isCompute() && !p.hasStage(GfxStage.COMPUTE)) {
+                report.error("[graph]", "compute pass '" + pass.name + "' needs program '"
+                        + pass.program + "' with a compute stage");
+            }
+            if (!pass.isCompute() && !pass.isCopy() && !p.isRasterComplete()) {
+                // A raster program with no vertex stage cannot issue geometry at
+                // all, on either backend, so it is a malformed pack rather than
+                // a thin one. A missing fragment stage is normal and legal: the
+                // shadow passes of a legacy pack are depth-only by design.
+                if (!p.hasStage(GfxStage.VERTEX)) {
+                    report.error("[graph]", "raster pass '" + pass.name + "' is bound to program '"
+                            + pass.program + "', which is missing a vertex stage and cannot draw");
+                } else {
+                    report.warning("[graph]", "pass '" + pass.name + "' program '" + pass.program
+                            + "' is missing: " + p.missingStages());
+                }
+            }
+        }
+        for (String ref : manifest.graph.danglingReferences()) {
+            report.error("[graph]", "pass references an undeclared resource: " + ref);
+        }
+    }
+
+    // ------------------------------------------------------------ validation
+    private void validate(GfxDevice device) {
+        if (device == null) {
+            report.note("no device supplied; capability validation skipped");
+        } else {
+            List<GfxCapability> missing = new ArrayList<GfxCapability>();
+            for (GfxCapability c : manifest.requiredCapabilities) {
+                if (!device.hasCapability(c)) missing.add(c);
+            }
+            if (!missing.isEmpty()) {
+                report.error("capabilities", "device '" + device.deviceName() + "' lacks " + missing
+                        + "; this pack cannot run here");
+            } else if (!manifest.requiredCapabilities.isEmpty()) {
+                report.note("all " + manifest.requiredCapabilities.size() + " required capabilities present");
+            }
+        }
+
+        if (manifest.format == PackFormat.NATIVE) {
+            if (manifest.graph.passes().isEmpty()) {
+                report.error("[graph]", "a native pack must declare at least one pass");
+            }
+            if (manifest.graph.presentResource.isEmpty()) {
+                report.warning("[graph]", "no 'present =' resource declared; the last external pass is used");
+            }
+            boolean anyCompute = false;
+            for (GraphSpec.PassSpec p : manifest.graph.passes()) if (p.isCompute()) anyCompute = true;
+            if (anyCompute) manifest.requiredCapabilities.add(GfxCapability.COMPUTE_SHADERS);
+            for (GraphSpec.ResourceSpec r : manifest.graph.resources()) {
+                if (r.is3d) manifest.requiredCapabilities.add(GfxCapability.TEXTURE_3D);
+                if (r.format.isInteger()) manifest.requiredCapabilities.add(GfxCapability.INTEGER_TEXTURES);
+            }
+            if (device != null) {
+                for (GfxCapability c : manifest.requiredCapabilities) {
+                    if (!device.hasCapability(c)) {
+                        report.error("capabilities", "derived requirement " + c
+                                + " is not supported by '" + device.deviceName() + "'");
+                    }
+                }
+            }
+        } else {
+            if (manifest.programCount() == 0) {
+                report.error("shaders/", "a legacy pack must contain at least one program");
+            }
+            boolean hasFinal = manifest.hasProgram("final") || manifest.hasProgram("composite");
+            if (!hasFinal) {
+                report.warning("shaders/", "no 'final' or 'composite' program; the pack cannot reach the screen");
+            }
+        }
+
+        for (String problem : manifest.customUniforms.problems()) {
+            report.warning("custom uniforms", problem);
+        }
+    }
+
+    /** Programs a LEGACY pack is expected to have, used by the parity gate. */
+    /**
+     * The program names an OptiFine/Iris pack can actually ship, spelled the way
+     * they appear on disk -- which is also the way this loader discovers them.
+     *
+     * <p>An earlier version of this list mixed in the renderer's internal names
+     * ("terrain_solid", "sky_basic"), which no pack ever writes as a filename.
+     * Coverage against that list reported 3 of 21 for a pack that shipped 6, so
+     * the number was not merely imprecise, it was measuring the wrong thing.
+     */
+    public static final List<String> LEGACY_CORE_PROGRAMS = Collections.unmodifiableList(Arrays.asList(
+            "shadow", "shadow_solid", "shadow_cutout", "shadow_water", "shadow_terrain",
+            "shadow_entities", "shadow_block", "shadow_beam",
+            "gbuffers_basic", "gbuffers_textured", "gbuffers_textured_lit",
+            "gbuffers_skybasic", "gbuffers_skytextured", "gbuffers_skybasic_textured",
+            "gbuffers_clouds", "gbuffers_weather", "gbuffers_water", "gbuffers_block",
+            "gbuffers_beaconbeam", "gbuffers_entity", "gbuffers_entities_translucent",
+            "gbuffers_armor_glint", "gbuffers_spidereyes",
+            "gbuffers_terrain", "gbuffers_terrain_solid", "gbuffers_terrain_cutout",
+            "gbuffers_terrain_cutout_mip", "gbuffers_hand", "gbuffers_hand_water",
+            "gbuffers_crumbling", "gbuffers_damagedblock", "gbuffers_item", "gbuffers_line",
+            "gbuffers_particles", "gbuffers_particles_translucent", "gbuffers_setblock",
+            "gbuffers_screen",
+            "deferred", "composite", "final"));
+
+    /** Which of the expected legacy programs this pack actually supplies. */
+    public List<String> legacyCoverage() {
+        List<String> out = new ArrayList<String>();
+        for (String n : LEGACY_CORE_PROGRAMS) {
+            PackProgram p = manifest.program(n);
+            if (p != null && p.stageCount() > 0) out.add(n);
+        }
+        return out;
+    }
+}
diff --git a/core/src/main/java/dev/auralite/render/pack/PackManifest.java b/core/src/main/java/dev/auralite/render/pack/PackManifest.java
new file mode 100644
index 0000000..817df14
--- /dev/null
+++ b/core/src/main/java/dev/auralite/render/pack/PackManifest.java
@@ -0,0 +1,138 @@
+package dev.auralite.render.pack;
+
+import dev.auralite.render.rhi.GfxCapability;
+import dev.auralite.render.uniform.CustomUniformTable;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.EnumSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/** Everything a pack declares, in one object, whichever mode it came from. */
+public final class PackManifest {
+    /** API level this loader implements; packs above it are refused. */
+    public static final int CURRENT_API_LEVEL = 1;
+
+    public String name = "<unnamed>";
+    public String version = "0.0.0";
+    public String author = "";
+    public String description = "";
+    public int apiLevel = 1;
+    public PackFormat format = PackFormat.LEGACY_IRIS;
+    public String origin = "";
+
+    // ---- capability contract -------------------------------------------
+    public final Set<GfxCapability> requiredCapabilities = EnumSet.noneOf(GfxCapability.class);
+
+    // ---- options --------------------------------------------------------
+    private final Map<String, PackOption> options = new LinkedHashMap<String, PackOption>();
+    private final Map<String, String> optionValues = new LinkedHashMap<String, String>();
+
+    // ---- programs -------------------------------------------------------
+    private final Map<String, PackProgram> programs = new LinkedHashMap<String, PackProgram>();
+
+    // ---- legacy surface -------------------------------------------------
+    public final CustomUniformTable customUniforms = new CustomUniformTable();
+    /** Iris {@code colortex<N>Format=}. */
+    private final Map<String, String> legacyFormats = new LinkedHashMap<String, String>();
+    /** Iris {@code customTexture.<name>=<path>}. */
+    private final Map<String, String> customTextures = new LinkedHashMap<String, String>();
+    /** Iris {@code shadowDistance}, {@code shadowMapResolution} and friends. */
+    private final Map<String, String> settings = new LinkedHashMap<String, String>();
+    /** Iris {@code sliders=} list, in declared order. */
+    private final List<String> sliderOrder = new ArrayList<String>();
+    /** Iris {@code screen[Tab]=} layout, tab -> option names in order. */
+    private final Map<String, List<String>> screen = new LinkedHashMap<String, List<String>>();
+
+    // ---- native surface -------------------------------------------------
+    public final GraphSpec graph = new GraphSpec();
+    /** AuraLite-Render extension: evaluate biome-dependent legacy uniforms per cell. */
+    public boolean spatialBiomeUniforms;
+    /** How many biomes the pack wants exposed per sample (1..4). */
+    public int biomeSampleEntries = 4;
+
+    // ---- options API ----------------------------------------------------
+    public PackOption addOption(PackOption o) {
+        options.put(o.name, o);
+        if (!optionValues.containsKey(o.name)) optionValues.put(o.name, o.defaultValue);
+        return o;
+    }
+    public PackOption option(String name) { return options.get(name); }
+    public boolean hasOption(String name) { return options.containsKey(name); }
+    public List<PackOption> options() {
+        return Collections.unmodifiableList(new ArrayList<PackOption>(options.values()));
+    }
+    public int optionCount() { return options.size(); }
+
+    public String optionValue(String name) {
+        String v = optionValues.get(name);
+        if (v != null) return v;
+        PackOption o = options.get(name);
+        return o == null ? "" : o.defaultValue;
+    }
+
+    public PackManifest setOption(String name, String value) {
+        PackOption o = options.get(name);
+        if (o != null && !o.accepts(value)) {
+            throw new IllegalArgumentException("option '" + name + "' does not accept '" + value + "'");
+        }
+        optionValues.put(name, value);
+        return this;
+    }
+
+    public Map<String, String> resolvedOptions() { return Collections.unmodifiableMap(optionValues); }
+
+    /** True when a boolean/define option is currently on. */
+    public boolean optionEnabled(String name) {
+        String v = optionValue(name);
+        return "true".equals(v) || "1".equals(v) || "on".equalsIgnoreCase(v);
+    }
+
+    /** The {@code #define} lines for the current option selection. */
+    public List<String> activeDefines() {
+        List<String> out = new ArrayList<String>();
+        for (Map.Entry<String, String> e : optionValues.entrySet()) {
+            PackOption o = options.get(e.getKey());
+            if (o == null) continue;
+            String d = o.defineFor(e.getValue());
+            if (!d.isEmpty()) out.add(d);
+        }
+        return out;
+    }
+
+    // ---- programs API ---------------------------------------------------
+    public PackProgram addProgram(PackProgram p) { programs.put(p.name, p); return p; }
+    public PackProgram program(String name) { return programs.get(name); }
+    public boolean hasProgram(String name) { return programs.containsKey(name); }
+    public List<PackProgram> programs() {
+        return Collections.unmodifiableList(new ArrayList<PackProgram>(programs.values()));
+    }
+    public int programCount() { return programs.size(); }
+
+    // ---- legacy maps ----------------------------------------------------
+    public Map<String, String> legacyFormats() { return legacyFormats; }
+    public Map<String, String> customTextures() { return customTextures; }
+    public Map<String, String> settings() { return settings; }
+    public List<String> sliderOrder() { return sliderOrder; }
+    public Map<String, List<String>> screen() { return screen; }
+
+    public int shadowDistance() {
+        String v = settings.get("shadowDistance");
+        try { return v == null ? 128 : (int) Double.parseDouble(v.trim()); }
+        catch (NumberFormatException e) { return 128; }
+    }
+
+    public int shadowMapResolution() {
+        String v = settings.get("shadowMapResolution");
+        try { return v == null ? 2048 : Integer.parseInt(v.trim()); }
+        catch (NumberFormatException e) { return 2048; }
+    }
+
+    @Override public String toString() {
+        return name + " v" + version + " (" + format + ", api " + apiLevel + ", "
+                + programs.size() + " programs, " + options.size() + " options)";
+    }
+}
diff --git a/core/src/main/java/dev/auralite/render/pack/PackOption.java b/core/src/main/java/dev/auralite/render/pack/PackOption.java
new file mode 100644
index 0000000..8282408
--- /dev/null
+++ b/core/src/main/java/dev/auralite/render/pack/PackOption.java
@@ -0,0 +1,102 @@
+package dev.auralite.render.pack;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+/**
+ * One user-facing option.
+ *
+ * <p>LEGACY packs declare these with {@code #define} blocks plus
+ * {@code screen[Tab]=} lines in {@code shaders.properties}; NATIVE packs
+ * declare them in an {@code [options]} section with a type. Both land here, so
+ * the option table, the profile presets and the GUI are one code path.
+ */
+public final class PackOption {
+    public enum Kind {
+        /** Preprocessor define: the value becomes {@code #define NAME value}. */
+        DEFINE,
+        /** A constant uploaded as a uniform rather than baked into the shader. */
+        CONST,
+        /** Continuous slider; every value between the endpoints exists. */
+        SLIDER,
+        /** Enumerated selector. */
+        SELECTOR,
+        /** On/off. */
+        BOOL
+    }
+
+    public static final class Choice {
+        public final String value;
+        public final String label;
+        public Choice(String value, String label) {
+            this.value = value;
+            this.label = label == null || label.isEmpty() ? value : label;
+        }
+        @Override public String toString() { return value + "=" + label; }
+    }
+
+    public final String name;
+    public final Kind kind;
+    public String label;
+    public String screenTab = "";
+    public final List<Choice> choices = new ArrayList<Choice>();
+    public String defaultValue = "";
+    public double sliderMin, sliderMax, sliderStep = 1.0;
+    public String comment = "";
+
+    public PackOption(String name, Kind kind) {
+        this.name = name;
+        this.kind = kind;
+    }
+
+    public PackOption label(String l) { this.label = l; return this; }
+    public PackOption tab(String t) { this.screenTab = t == null ? "" : t; return this; }
+    public PackOption defaultValue(String v) { this.defaultValue = v; return this; }
+    public PackOption comment(String c) { this.comment = c == null ? "" : c; return this; }
+
+    public PackOption choice(String value, String label) {
+        choices.add(new Choice(value, label));
+        return this;
+    }
+
+    public PackOption slider(double min, double max, double step) {
+        this.sliderMin = min; this.sliderMax = max; this.sliderStep = step;
+        return this;
+    }
+
+    public List<Choice> choices() { return Collections.unmodifiableList(choices); }
+
+    /** True when {@code value} is one this option accepts. */
+    public boolean accepts(String value) {
+        if (value == null) return false;
+        switch (kind) {
+            case BOOL: return value.equals("true") || value.equals("false")
+                    || value.equals("0") || value.equals("1");
+            case SLIDER: {
+                try {
+                    double d = Double.parseDouble(value);
+                    return d >= sliderMin - 1e-9 && d <= sliderMax + 1e-9;
+                } catch (NumberFormatException e) { return false; }
+            }
+            case SELECTOR: case DEFINE: case CONST:
+                for (Choice c : choices) if (c.value.equals(value)) return true;
+                return choices.isEmpty();
+            default: return false;
+        }
+    }
+
+    /** The {@code #define} line this option contributes, empty for CONST. */
+    public String defineFor(String value) {
+        if (kind == Kind.CONST) return "";
+        if (kind == Kind.BOOL) {
+            boolean on = value.equals("true") || value.equals("1");
+            return on ? "#define " + name : "";
+        }
+        return "#define " + name + " " + value;
+    }
+
+    @Override public String toString() {
+        return name + " (" + kind + ", default=" + defaultValue + ", choices=" + choices.size() + ")";
+    }
+}
diff --git a/core/src/main/java/dev/auralite/render/pack/PackProgram.java b/core/src/main/java/dev/auralite/render/pack/PackProgram.java
new file mode 100644
index 0000000..5ca9657
--- /dev/null
+++ b/core/src/main/java/dev/auralite/render/pack/PackProgram.java
@@ -0,0 +1,71 @@
+package dev.auralite.render.pack;
+
+import dev.auralite.render.rhi.GfxStage;
+import dev.auralite.render.rhi.ShaderSource;
+
+import java.util.ArrayList;
+import java.util.EnumMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * One named program: the stages a pack supplies for it plus its fixed-function
+ * state.
+ *
+ * <p>LEGACY mode derives the name from the filename ({@code gbuffers_terrain},
+ * {@code composite3}, {@code shadow}); NATIVE mode takes it from the
+ * {@code [programs]} section. Both end up here, and the graph builder is what
+ * decides which pass a program runs in -- in NATIVE mode a program may run in
+ * several passes, which Iris cannot express.
+ */
+public final class PackProgram {
+    public final String name;
+    private final Map<GfxStage, ShaderSource> stages = new EnumMap<GfxStage, ShaderSource>(GfxStage.class);
+
+    public boolean enabled = true;
+    public String disableReason = "";
+    /** Iris {@code program.<name>.enabled=false}. */
+    public boolean explicitlyDisabled;
+    public String blendSrc = "";
+    public String blendDst = "";
+    /** Iris {@code program.<name>.composite.<setting>}. */
+    public boolean shadowHardwareFiltering;
+    public int blendMode = -1;
+    /** Passes this program participates in; empty in LEGACY mode. */
+    public String boundPass = "";
+    /** Work-group size for a compute program. */
+    public int localSizeX = 1, localSizeY = 1, localSizeZ = 1;
+    /** Declared source paths inside the pack, in stage order. */
+    public final List<String> sourcePaths = new ArrayList<String>();
+
+    public PackProgram(String name) { this.name = name; }
+
+    public PackProgram stage(GfxStage stage, ShaderSource source) {
+        stages.put(stage, source);
+        return this;
+    }
+
+    public ShaderSource stage(GfxStage stage) { return stages.get(stage); }
+    public boolean hasStage(GfxStage stage) { return stages.containsKey(stage); }
+    public Map<GfxStage, ShaderSource> stages() { return stages; }
+    public int stageCount() { return stages.size(); }
+
+    public boolean isCompute() { return stages.containsKey(GfxStage.COMPUTE); }
+
+    /** True when the program has the two stages a raster pass needs. */
+    public boolean isRasterComplete() {
+        return stages.containsKey(GfxStage.VERTEX) && stages.containsKey(GfxStage.FRAGMENT);
+    }
+
+    public String missingStages() {
+        if (isCompute()) return "";
+        StringBuilder sb = new StringBuilder();
+        if (!stages.containsKey(GfxStage.VERTEX)) sb.append("vertex ");
+        if (!stages.containsKey(GfxStage.FRAGMENT)) sb.append("fragment ");
+        return sb.toString().trim();
+    }
+
+    @Override public String toString() {
+        return name + "[" + stages.keySet() + (enabled ? "" : " DISABLED:" + disableReason) + "]";
+    }
+}
diff --git a/core/src/main/java/dev/auralite/render/pack/PackSource.java b/core/src/main/java/dev/auralite/render/pack/PackSource.java
new file mode 100644
index 0000000..66df066
--- /dev/null
+++ b/core/src/main/java/dev/auralite/render/pack/PackSource.java
@@ -0,0 +1,174 @@
+package dev.auralite.render.pack;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipFile;
+
+/**
+ * Read access to a pack, whether it is a directory, a {@code .zip} or an
+ * in-memory map.
+ *
+ * <p>One abstraction for all three so the parsers and every test are identical
+ * whichever way the pack arrived. Paths inside a pack always use {@code /}.
+ */
+public interface PackSource extends AutoCloseable {
+
+    boolean exists(String path);
+
+    /** Text content, or {@code null} when absent. Lines are returned as-is. */
+    String readText(String path);
+
+    byte[] readBytes(String path);
+
+    /** All entries under {@code prefix}, in stable lexicographic order. */
+    List<String> list(String prefix);
+
+    /** Where the pack came from, for load reports and error messages. */
+    String origin();
+
+    @Override void close();
+
+    // ------------------------------------------------------------- directory
+    final class Directory implements PackSource {
+        private final Path root;
+
+        public Directory(Path root) { this.root = root; }
+
+        private Path resolve(String path) {
+            Path p = root.resolve(path.replace('/', java.io.File.separatorChar)).normalize();
+            if (!p.startsWith(root)) throw new IllegalArgumentException("pack path escapes root: " + path);
+            return p;
+        }
+
+        @Override public boolean exists(String path) { return Files.exists(resolve(path)); }
+
+        @Override public String readText(String path) {
+            try {
+                Path p = resolve(path);
+                if (!Files.exists(p)) return null;
+                return new String(Files.readAllBytes(p), StandardCharsets.UTF_8);
+            } catch (IOException e) {
+                return null;
+            }
+        }
+
+        @Override public byte[] readBytes(String path) {
+            try {
+                Path p = resolve(path);
+                return Files.exists(p) ? Files.readAllBytes(p) : null;
+            } catch (IOException e) {
+                return null;
+            }
+        }
+
+        @Override public List<String> list(String prefix) {
+            List<String> out = new ArrayList<String>();
+            Path base = resolve(prefix.isEmpty() ? "." : prefix);
+            if (!Files.isDirectory(base)) return out;
+            try (java.util.stream.Stream<Path> s = Files.walk(base)) {
+                s.filter(Files::isRegularFile).forEach(p -> {
+                    String rel = root.relativize(p).toString().replace(java.io.File.separatorChar, '/');
+                    out.add(rel);
+                });
+            } catch (IOException e) {
+                return out;
+            }
+            Collections.sort(out);
+            return out;
+        }
+
+        @Override public String origin() { return root.toString(); }
+        @Override public void close() { }
+    }
+
+    // ------------------------------------------------------------------- zip
+    final class Zip implements PackSource {
+        private final Path file;
+        private final Map<String, byte[]> entries = new LinkedHashMap<String, byte[]>();
+
+        public Zip(Path file) throws IOException {
+            this.file = file;
+            try (ZipFile z = new ZipFile(file.toFile())) {
+                java.util.Enumeration<? extends ZipEntry> e = z.entries();
+                while (e.hasMoreElements()) {
+                    ZipEntry en = e.nextElement();
+                    if (en.isDirectory()) continue;
+                    ByteArrayOutputStream bos = new ByteArrayOutputStream((int) Math.max(64, en.getSize()));
+                    try (InputStream in = z.getInputStream(en)) {
+                        byte[] buf = new byte[8192];
+                        int n;
+                        while ((n = in.read(buf)) > 0) bos.write(buf, 0, n);
+                    }
+                    entries.put(en.getName(), bos.toByteArray());
+                }
+            }
+        }
+
+        @Override public boolean exists(String path) { return entries.containsKey(path); }
+
+        @Override public String readText(String path) {
+            byte[] b = entries.get(path);
+            return b == null ? null : new String(b, StandardCharsets.UTF_8);
+        }
+
+        @Override public byte[] readBytes(String path) { return entries.get(path); }
+
+        @Override public List<String> list(String prefix) {
+            List<String> out = new ArrayList<String>();
+            for (String k : entries.keySet()) if (k.startsWith(prefix)) out.add(k);
+            Collections.sort(out);
+            return out;
+        }
+
+        @Override public String origin() { return file.toString(); }
+        @Override public void close() { }
+    }
+
+    // ------------------------------------------------------------- in-memory
+    final class Memory implements PackSource {
+        private final Map<String, byte[]> files = new LinkedHashMap<String, byte[]>();
+        private final String origin;
+
+        public Memory() { this("<memory>"); }
+        public Memory(String origin) { this.origin = origin; }
+
+        public Memory put(String path, String text) {
+            files.put(path, text.getBytes(StandardCharsets.UTF_8));
+            return this;
+        }
+
+        public Memory put(String path, byte[] bytes) {
+            files.put(path, bytes);
+            return this;
+        }
+
+        @Override public boolean exists(String path) { return files.containsKey(path); }
+
+        @Override public String readText(String path) {
+            byte[] b = files.get(path);
+            return b == null ? null : new String(b, StandardCharsets.UTF_8);
+        }
+
+        @Override public byte[] readBytes(String path) { return files.get(path); }
+
+        @Override public List<String> list(String prefix) {
+            List<String> out = new ArrayList<String>();
+            for (String k : files.keySet()) if (k.startsWith(prefix)) out.add(k);
+            Collections.sort(out);
+            return out;
+        }
+
+        @Override public String origin() { return origin; }
+        @Override public void close() { }
+    }
+}
diff --git a/core/src/main/java/dev/auralite/render/pack/PipelineProvider.java b/core/src/main/java/dev/auralite/render/pack/PipelineProvider.java
