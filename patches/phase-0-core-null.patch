diff --git a/core/src/main/java/dev/auralite/render/rhi/GfxCapability.java b/core/src/main/java/dev/auralite/render/rhi/GfxCapability.java
new file mode 100644
index 0000000..b5d9762
--- /dev/null
+++ b/core/src/main/java/dev/auralite/render/rhi/GfxCapability.java
@@ -0,0 +1,66 @@
+package dev.auralite.render.rhi;
+
+/**
+ * Optional device capabilities.
+ *
+ * <p>A pack declares the set it requires; the loader intersects that with
+ * {@link GfxDevice#capabilities()} and refuses the pack with a named reason
+ * before any shader is compiled. This is the honest alternative to the Iris
+ * behaviour of compiling a program that then fails at first use.
+ */
+public enum GfxCapability {
+    /** Compute shaders. Absent from the Iris pack API entirely. */
+    COMPUTE_SHADERS,
+    /** 3D textures, needed by the biome field and volumetric LUTs. */
+    TEXTURE_3D,
+    /** Integer (usampler/isampler) textures, needed by the biome id field. */
+    INTEGER_TEXTURES,
+    /** Shader storage buffers. */
+    STORAGE_BUFFERS,
+    /** Writable storage images (imageStore) outside compute. */
+    FRAGMENT_STORAGE_IMAGES,
+    /** Indirect draw from a GPU buffer. */
+    INDIRECT_DRAW,
+    /** glMultiDrawElementsIndirect / vkCmdDrawIndexedIndirectCount. */
+    MULTI_DRAW_INDIRECT,
+    /** Indirect dispatch with a count buffer. */
+    INDIRECT_DISPATCH,
+    /** Bindless texture handles. */
+    BINDLESS_TEXTURES,
+    /** Ray query from a compute or fragment stage (no separate RT pipeline). */
+    RAY_QUERY,
+    /** Full ray-tracing pipelines. */
+    RAY_TRACING_PIPELINE,
+    /** Task + mesh stages. */
+    MESH_SHADERS,
+    /** A second queue family usable concurrently with graphics. */
+    ASYNC_COMPUTE,
+    /** Subgroup/wave intrinsics with a known subgroup size. */
+    SUBGROUP_OPS,
+    /** Geometry shaders. */
+    GEOMETRY_SHADERS,
+    /** Tessellation control + evaluation. */
+    TESSELLATION,
+    /** gl_FragCoord-order-independent programmable blending. */
+    FRAGMENT_SHADER_ORDERING,
+    /** Conservative rasterisation. */
+    CONSERVATIVE_RASTER,
+    /** Barycentric coordinate / perspective-correct attribute access in fragment. */
+    BARYCENTRICS,
+    /** Device-side clock (VK_KHR_shader_clock, GL_ARB_shader_clock). */
+    SHADER_CLOCK,
+    /** Sparse/resident texture binding. */
+    SPARSE_BINDING,
+    /** Viewport and scissor arrays. */
+    VIEWPORT_ARRAY,
+    /** Sampler-less buffer textures (samplerBuffer / texel buffers). */
+    BUFFER_TEXTURES,
+    /** Explicit LOD and derivative control. */
+    DERIVATIVE_CONTROL,
+    /** Dual-source blending. */
+    DUAL_SOURCE_BLEND,
+    /** Timestamp queries usable for honest per-pass profiling. */
+    TIMESTAMPS,
+    /** Pipeline statistics queries (clips, primitives). */
+    PIPELINE_STATISTICS;
+}
diff --git a/core/src/main/java/dev/auralite/render/rhi/GfxCommandBuffer.java b/core/src/main/java/dev/auralite/render/rhi/GfxCommandBuffer.java
new file mode 100644
index 0000000..baeb9f5
--- /dev/null
+++ b/core/src/main/java/dev/auralite/render/rhi/GfxCommandBuffer.java
@@ -0,0 +1,58 @@
+package dev.auralite.render.rhi;
+
+import dev.auralite.render.rhi.GfxEnums.PassType;
+
+import java.nio.ByteBuffer;
+
+/**
+ * Recording surface. One interface, two implementations, no GL/VK types leak.
+ *
+ * <p>Every method here has a measured host-side gate in the NULL backend: the
+ * NULL device records the call stream and validates ordering, so a pipeline bug
+ * is caught by {@code make test} on a machine with no GPU at all.
+ */
+public interface GfxCommandBuffer {
+
+    void begin();
+    void end();
+    boolean isRecording();
+    PassType passType();
+
+    // ---- raster -------------------------------------------------------
+    void beginRenderPass(GfxDesc.RenderPass pass);
+    void endRenderPass();
+    void nextSubpass();
+    void setViewport(float x, float y, float w, float h, float minDepth, float maxDepth);
+    void setScissor(int x, int y, int w, int h);
+    void bindGraphicsPipeline(GfxPipeline pipeline);
+    void bindVertexBuffer(int binding, GfxBuffer buffer, long offset);
+    void bindIndexBuffer(GfxBuffer buffer, long offset, boolean index32);
+    void draw(int vertexCount, int instanceCount, int firstVertex, int firstInstance);
+    void drawIndexed(int indexCount, int instanceCount, int firstIndex, int vertexOffset, int firstInstance);
+    void drawIndirect(GfxBuffer args, long offset, int drawCount, int stride);
+    void drawIndexedIndirect(GfxBuffer args, long offset, int drawCount, int stride);
+    void drawIndexedIndirectCount(GfxBuffer args, long argsOffset, GfxBuffer count, long countOffset,
+                                  int maxDrawCount, int stride);
+
+    // ---- compute ------------------------------------------------------
+    void bindComputePipeline(GfxPipeline pipeline);
+    void dispatch(int groupsX, int groupsY, int groupsZ);
+    void dispatchIndirect(GfxBuffer args, long offset);
+
+    // ---- resources ----------------------------------------------------
+    void bindDescriptorSet(int setIndex, GfxDescriptorSet set);
+    void pushConstants(int offset, ByteBuffer data);
+    void pushConstants(int offset, float[] values);
+    void copyBuffer(GfxBuffer src, long srcOffset, GfxBuffer dst, long dstOffset, long sizeBytes);
+    void copyBufferToImage(GfxBuffer src, GfxImage dst, int mipLevel);
+    void copyImage(GfxImage src, int srcMip, GfxImage dst, int dstMip, int width, int height, int depth);
+    void blitImage(GfxImage src, GfxImage dst, boolean linearFilter);
+    void generateMipmaps(GfxImage image);
+    void barrier(GfxImage image, GfxEnums.ResourceState from, GfxEnums.ResourceState to, int srcAccess, int dstAccess);
+    void barrier(GfxBuffer buffer, int srcAccess, int dstAccess);
+    void memoryBarrierAll();
+    void writeTimestamp(int queryIndex);
+
+    /** Number of recorded commands; the NULL backend's receipts come from this. */
+    int commandCount();
+}
diff --git a/core/src/main/java/dev/auralite/render/rhi/GfxDesc.java b/core/src/main/java/dev/auralite/render/rhi/GfxDesc.java
new file mode 100644
index 0000000..dd19096
--- /dev/null
+++ b/core/src/main/java/dev/auralite/render/rhi/GfxDesc.java
@@ -0,0 +1,421 @@
+package dev.auralite.render.rhi;
+
+import dev.auralite.render.rhi.GfxEnums.AddressMode;
+import dev.auralite.render.rhi.GfxEnums.BlendFactor;
+import dev.auralite.render.rhi.GfxEnums.BlendOp;
+import dev.auralite.render.rhi.GfxEnums.CompareOp;
+import dev.auralite.render.rhi.GfxEnums.CullMode;
+import dev.auralite.render.rhi.GfxEnums.Filter;
+import dev.auralite.render.rhi.GfxEnums.FrontFace;
+import dev.auralite.render.rhi.GfxEnums.ImageType;
+import dev.auralite.render.rhi.GfxEnums.LoadOp;
+import dev.auralite.render.rhi.GfxEnums.MemoryDomain;
+import dev.auralite.render.rhi.GfxEnums.MipmapMode;
+import dev.auralite.render.rhi.GfxEnums.StoreOp;
+import dev.auralite.render.rhi.GfxEnums.Topology;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+/**
+ * Every creation descriptor in one place.
+ *
+ * <p>Fields are public and final-by-convention: descriptors are value objects
+ * built once at pack load and hashed for pipeline-cache keys, so there is no
+ * mutation and no builder ceremony. {@code hash()} is the pipeline-cache key
+ * and is part of the graph's determinism gate.
+ */
+public final class GfxDesc {
+    private GfxDesc() { }
+
+    // ------------------------------------------------------------------ buffer
+    public static final class Buffer {
+        public long sizeBytes;
+        public int usage;
+        public MemoryDomain domain = MemoryDomain.DEVICE_LOCAL;
+        public String debugName = "";
+
+        public static Buffer of(long sizeBytes, int usage) {
+            Buffer b = new Buffer();
+            b.sizeBytes = sizeBytes;
+            b.usage = usage;
+            return b;
+        }
+        public Buffer named(String n) { this.debugName = n == null ? "" : n; return this; }
+        public Buffer domain(MemoryDomain d) { this.domain = d; return this; }
+
+        public long hash() {
+            long h = sizeBytes * 1099511628211L;
+            h ^= usage * 2654435761L;
+            h ^= domain.ordinal() * 40503L;
+            return h;
+        }
+    }
+
+    // ------------------------------------------------------------------- image
+    public static final class Image {
+        public ImageType type = ImageType.TEXTURE_2D;
+        public GfxFormat format = GfxFormat.RGBA8_UNORM;
+        public int width = 1, height = 1, depth = 1;
+        public int mipLevels = 1;
+        public int arrayLayers = 1;
+        public int samples = 1;
+        public int usage;
+        public MemoryDomain domain = MemoryDomain.DEVICE_LOCAL;
+        public String debugName = "";
+
+        public static Image tex2d(int w, int h, GfxFormat f, int usage) {
+            Image i = new Image();
+            i.type = ImageType.TEXTURE_2D;
+            i.width = w; i.height = h; i.format = f; i.usage = usage;
+            return i;
+        }
+        public static Image tex3d(int w, int h, int d, GfxFormat f, int usage) {
+            Image i = new Image();
+            i.type = ImageType.TEXTURE_3D;
+            i.width = w; i.height = h; i.depth = d; i.format = f; i.usage = usage;
+            return i;
+        }
+        public Image mips(int levels) { this.mipLevels = Math.max(1, levels); return this; }
+        public Image fullMipChain() {
+            int m = 1, s = Math.max(width, height);
+            while (s > 1) { s >>= 1; m++; }
+            this.mipLevels = m;
+            return this;
+        }
+        public Image samples(int s) { this.samples = Math.max(1, s); return this; }
+        public Image layers(int l) { this.arrayLayers = Math.max(1, l); return this; }
+        public Image named(String n) { this.debugName = n == null ? "" : n; return this; }
+
+        public long texelCount() {
+            return (long) width * height * depth * arrayLayers;
+        }
+        /** Bytes for one mip level, level 0. Compressed formats report 0 (unknown here). */
+        public long levelBytes() {
+            return format.isCompressed() ? 0 : texelCount() * format.bytesPerTexel();
+        }
+        /** Total bytes across the whole mip chain, used by the graph's memory budget. */
+        public long approxBytes() {
+            if (format.isCompressed()) return 0;
+            long total = 0, w = width, h = height, d = depth;
+            for (int m = 0; m < mipLevels; m++) {
+                total += w * h * d * arrayLayers * format.bytesPerTexel();
+                w = Math.max(1, w >> 1); h = Math.max(1, h >> 1);
+                if (type != ImageType.TEXTURE_3D) d = 1; else d = Math.max(1, d >> 1);
+            }
+            return total;
+        }
+        public long hash() {
+            long h = 1469598103934665603L;
+            h = (h ^ type.ordinal()) * 1099511628211L;
+            h = (h ^ format.ordinal()) * 1099511628211L;
+            h = (h ^ width) * 1099511628211L;
+            h = (h ^ height) * 1099511628211L;
+            h = (h ^ depth) * 1099511628211L;
+            h = (h ^ mipLevels) * 1099511628211L;
+            h = (h ^ arrayLayers) * 1099511628211L;
+            h = (h ^ samples) * 1099511628211L;
+            h = (h ^ usage) * 1099511628211L;
+            return h;
+        }
+    }
+
+    // ------------------------------------------------------------------ sampler
+    public static final class Sampler {
+        public Filter minFilter = Filter.LINEAR;
+        public Filter magFilter = Filter.LINEAR;
+        public MipmapMode mipmapMode = MipmapMode.LINEAR;
+        public AddressMode addressU = AddressMode.CLAMP_TO_EDGE;
+        public AddressMode addressV = AddressMode.CLAMP_TO_EDGE;
+        public AddressMode addressW = AddressMode.CLAMP_TO_EDGE;
+        public float maxAnisotropy = 1.0f;
+        public boolean compareEnable = false;
+        public CompareOp compareOp = CompareOp.LESS;
+        public float minLod = 0.0f;
+        public float maxLod = 16.0f;
+        public float[] borderColor = new float[] { 0, 0, 0, 0 };
+        public String debugName = "";
+
+        public static Sampler linearClamp() { return new Sampler(); }
+        public static Sampler nearestClamp() {
+            Sampler s = new Sampler();
+            s.minFilter = Filter.NEAREST; s.magFilter = Filter.NEAREST; s.mipmapMode = MipmapMode.NEAREST;
+            return s;
+        }
+        public static Sampler shadowCompare() {
+            Sampler s = new Sampler();
+            s.compareEnable = true;
+            s.minFilter = Filter.LINEAR; s.magFilter = Filter.LINEAR;
+            return s;
+        }
+        public Sampler aniso(float a) { this.maxAnisotropy = a; return this; }
+        public Sampler wrap(AddressMode m) { this.addressU = this.addressV = this.addressW = m; return this; }
+        public Sampler named(String n) { this.debugName = n == null ? "" : n; return this; }
+
+        public long hash() {
+            long h = minFilter.ordinal() * 31L + magFilter.ordinal();
+            h = h * 31 + mipmapMode.ordinal();
+            h = h * 31 + addressU.ordinal();
+            h = h * 31 + addressV.ordinal();
+            h = h * 31 + addressW.ordinal();
+            h = h * 31 + Float.floatToIntBits(maxAnisotropy);
+            h = h * 31 + (compareEnable ? 1 : 0);
+            h = h * 31 + compareOp.ordinal();
+            h = h * 31 + Float.floatToIntBits(minLod);
+            h = h * 31 + Float.floatToIntBits(maxLod);
+            return h;
+        }
+    }
+
+    // ------------------------------------------------------------- blend state
+    public static final class Blend {
+        public boolean enabled = false;
+        public BlendFactor srcColor = BlendFactor.ONE;
+        public BlendFactor dstColor = BlendFactor.ZERO;
+        public BlendOp opColor = BlendOp.ADD;
+        public BlendFactor srcAlpha = BlendFactor.ONE;
+        public BlendFactor dstAlpha = BlendFactor.ZERO;
+        public BlendOp opAlpha = BlendOp.ADD;
+        public int writeMask = 0xF;
+
+        /** Maps an OptiFine/Iris {@code blend.<program>=<src> <dst>} pair onto this state. */
+        public static Blend fromLegacyPair(String srcName, String dstName) {
+            Blend b = new Blend();
+            b.enabled = true;
+            b.srcColor = parseFactor(srcName);
+            b.dstColor = parseFactor(dstName);
+            b.srcAlpha = b.srcColor;
+            b.dstAlpha = b.dstColor;
+            return b;
+        }
+        public static Blend alphaBlend() {
+            Blend b = new Blend();
+            b.enabled = true;
+            b.srcColor = BlendFactor.SRC_ALPHA;
+            b.dstColor = BlendFactor.ONE_MINUS_SRC_ALPHA;
+            b.srcAlpha = BlendFactor.ONE;
+            b.dstAlpha = BlendFactor.ONE_MINUS_SRC_ALPHA;
+            return b;
+        }
+        private static BlendFactor parseFactor(String n) {
+            if (n == null) return BlendFactor.ONE;
+            String k = n.trim().toUpperCase(java.util.Locale.ROOT);
+            // Legacy GL enum spellings still floating around in old packs.
+            if (k.equals("SRC_ALPHA")) return BlendFactor.SRC_ALPHA;
+            if (k.equals("ONE_MINUS_SRC_ALPHA")) return BlendFactor.ONE_MINUS_SRC_ALPHA;
+            if (k.equals("770")) return BlendFactor.SRC_ALPHA;
+            if (k.equals("771")) return BlendFactor.ONE_MINUS_SRC_ALPHA;
+            if (k.equals("768")) return BlendFactor.DST_ALPHA;
+            if (k.equals("769")) return BlendFactor.ONE_MINUS_DST_ALPHA;
+            if (k.equals("1")) return BlendFactor.ONE;
+            if (k.equals("0")) return BlendFactor.ZERO;
+            try { return BlendFactor.valueOf(k); } catch (IllegalArgumentException e) { return BlendFactor.ONE; }
+        }
+    }
+
+    // --------------------------------------------------------- depth/stencil
+    public static final class DepthStencil {
+        public boolean depthTest = true;
+        public boolean depthWrite = true;
+        public CompareOp depthOp = CompareOp.LESS_OR_EQUAL;
+        public boolean stencilTest = false;
+        public float depthBiasConstant = 0f;
+        public float depthBiasSlope = 0f;
+
+        public static DepthStencil readOnly() {
+            DepthStencil d = new DepthStencil();
+            d.depthWrite = false;
+            return d;
+        }
+        public static DepthStencil disabled() {
+            DepthStencil d = new DepthStencil();
+            d.depthTest = false;
+            d.depthWrite = false;
+            return d;
+        }
+    }
+
+    // -------------------------------------------------------------- raster
+    public static final class Raster {
+        public CullMode cullMode = CullMode.BACK;
+        public FrontFace frontFace = FrontFace.COUNTER_CLOCKWISE;
+        public Topology topology = Topology.TRIANGLE_LIST;
+        public boolean depthClamp = false;
+        public boolean polygonOffset = false;
+        public float lineWidth = 1.0f;
+    }
+
+    // --------------------------------------------------------- vertex layout
+    public static final class VertexLayout {
+        public static final class Attribute {
+            public int location;
+            public int binding;
+            public GfxFormat format;
+            public int offset;
+            public Attribute(int location, int binding, GfxFormat format, int offset) {
+                this.location = location; this.binding = binding;
+                this.format = format; this.offset = offset;
+            }
+        }
+        public static final class Binding {
+            public int binding;
+            public int stride;
+            public boolean perInstance;
+            public Binding(int binding, int stride, boolean perInstance) {
+                this.binding = binding; this.stride = stride; this.perInstance = perInstance;
+            }
+        }
+        public final List<Binding> bindings = new ArrayList<Binding>();
+        public final List<Attribute> attributes = new ArrayList<Attribute>();
+
+        public static VertexLayout empty() { return new VertexLayout(); }
+        public VertexLayout binding(int index, int stride, boolean perInstance) {
+            bindings.add(new Binding(index, stride, perInstance));
+            return this;
+        }
+        public VertexLayout attribute(int location, int binding, GfxFormat format, int offset) {
+            attributes.add(new Attribute(location, binding, format, offset));
+            return this;
+        }
+        public List<Attribute> attributes() { return Collections.unmodifiableList(attributes); }
+    }
+
+    // ----------------------------------------------------------- render pass
+    public static final class Attachment {
+        public GfxImage image;
+        public int mipLevel = 0;
+        public int baseLayer = 0;
+        public int layerCount = 1;
+        public LoadOp loadOp = LoadOp.DONT_CARE;
+        public StoreOp storeOp = StoreOp.STORE;
+        public float[] clearColor = new float[] { 0, 0, 0, 0 };
+        public float clearDepth = 1.0f;
+        public int clearStencil = 0;
+        public Blend blend = new Blend();
+
+        public static Attachment of(GfxImage image) {
+            Attachment a = new Attachment();
+            a.image = image;
+            return a;
+        }
+        public Attachment load(LoadOp op) { this.loadOp = op; return this; }
+        public Attachment store(StoreOp op) { this.storeOp = op; return this; }
+        public Attachment clear(float r, float g, float b, float a) {
+            this.loadOp = LoadOp.CLEAR;
+            this.clearColor = new float[] { r, g, b, a };
+            return this;
+        }
+        public Attachment blend(Blend b) { this.blend = b; return this; }
+    }
+
+    public static final class RenderPass {
+        public final List<Attachment> colors = new ArrayList<Attachment>();
+        public Attachment depth;
+        public int width, height;
+        public String debugName = "";
+
+        public static RenderPass of(int width, int height) {
+            RenderPass p = new RenderPass();
+            p.width = width; p.height = height;
+            return p;
+        }
+        public RenderPass color(Attachment a) { colors.add(a); return this; }
+        public RenderPass depth(Attachment a) { depth = a; return this; }
+        public RenderPass named(String n) { this.debugName = n == null ? "" : n; return this; }
+        public int colorCount() { return colors.size(); }
+    }
+
+    // -------------------------------------------------------------- pipelines
+    public static final class GraphicsPipeline {
+        public final List<GfxShaderModule> stages = new ArrayList<GfxShaderModule>();
+        public VertexLayout vertexLayout = VertexLayout.empty();
+        public Raster raster = new Raster();
+        public DepthStencil depthStencil = new DepthStencil();
+        public RenderPass renderPass;
+        public PipelineLayout layout;
+        public String debugName = "";
+
+        public GraphicsPipeline stage(GfxShaderModule m) { stages.add(m); return this; }
+        public GraphicsPipeline renderPass(RenderPass p) { this.renderPass = p; return this; }
+        public GraphicsPipeline layout(PipelineLayout l) { this.layout = l; return this; }
+        public GraphicsPipeline vertexLayout(VertexLayout v) { this.vertexLayout = v; return this; }
+        public GraphicsPipeline raster(Raster r) { this.raster = r; return this; }
+        public GraphicsPipeline depthStencil(DepthStencil d) { this.depthStencil = d; return this; }
+        public GraphicsPipeline named(String n) { this.debugName = n == null ? "" : n; return this; }
+
+        public boolean hasStage(GfxStage s) {
+            for (GfxShaderModule m : stages) if (m.stage() == s) return true;
+            return false;
+        }
+    }
+
+    public static final class ComputePipeline {
+        public GfxShaderModule stage;
+        public PipelineLayout layout;
+        public int localSizeX = 1, localSizeY = 1, localSizeZ = 1;
+        public String debugName = "";
+
+        public static ComputePipeline of(GfxShaderModule m) {
+            ComputePipeline p = new ComputePipeline();
+            p.stage = m;
+            return p;
+        }
+        public ComputePipeline localSize(int x, int y, int z) {
+            this.localSizeX = x; this.localSizeY = y; this.localSizeZ = z;
+            return this;
+        }
+        public ComputePipeline layout(PipelineLayout l) { this.layout = l; return this; }
+        public ComputePipeline named(String n) { this.debugName = n == null ? "" : n; return this; }
+    }
+
+    // -------------------------------------------------------- pipeline layout
+    public static final class PipelineLayout {
+        /** Descriptor set index -> binding descriptions, in declaration order. */
+        public final List<SetLayout> sets = new ArrayList<SetLayout>();
+        public int pushConstantBytes = 0;
+        public GfxStage pushConstantStages = GfxStage.FRAGMENT;
+
+        public static final class BindingDesc {
+            public final int binding;
+            public final Kind kind;
+            public final GfxStage stages;
+            public final int count;
+            public BindingDesc(int binding, Kind kind, GfxStage stages, int count) {
+                this.binding = binding; this.kind = kind;
+                this.stages = stages; this.count = Math.max(1, count);
+            }
+        }
+        public enum Kind {
+            UNIFORM_BUFFER, STORAGE_BUFFER, COMBINED_IMAGE_SAMPLER, SAMPLED_IMAGE,
+            SAMPLER, STORAGE_IMAGE, INPUT_ATTACHMENT, ACCELERATION_STRUCTURE
+        }
+        public static final class SetLayout {
+            public final List<BindingDesc> bindings = new ArrayList<BindingDesc>();
+            public SetLayout uniformBuffer(int binding, GfxStage stages) {
+                bindings.add(new BindingDesc(binding, Kind.UNIFORM_BUFFER, stages, 1)); return this;
+            }
+            public SetLayout storageBuffer(int binding, GfxStage stages) {
+                bindings.add(new BindingDesc(binding, Kind.STORAGE_BUFFER, stages, 1)); return this;
+            }
+            public SetLayout storageBuffer(int binding, GfxStage stages, int count) {
+                bindings.add(new BindingDesc(binding, Kind.STORAGE_BUFFER, stages, count)); return this;
+            }
+            public SetLayout sampler(int binding, GfxStage stages) {
+                bindings.add(new BindingDesc(binding, Kind.COMBINED_IMAGE_SAMPLER, stages, 1)); return this;
+            }
+            public SetLayout storageImage(int binding, GfxStage stages) {
+                bindings.add(new BindingDesc(binding, Kind.STORAGE_IMAGE, stages, 1)); return this;
+            }
+        }
+        public PipelineLayout set(SetLayout s) { sets.add(s); return this; }
+        public PipelineLayout pushConstants(int bytes, GfxStage stages) {
+            this.pushConstantBytes = bytes; this.pushConstantStages = stages; return this;
+        }
+        public int bindingCount() {
+            int n = 0;
+            for (SetLayout s : sets) n += s.bindings.size();
+            return n;
+        }
+    }
+}
diff --git a/core/src/main/java/dev/auralite/render/rhi/GfxDescriptorSet.java b/core/src/main/java/dev/auralite/render/rhi/GfxDescriptorSet.java
new file mode 100644
index 0000000..723d6fd
--- /dev/null
+++ b/core/src/main/java/dev/auralite/render/rhi/GfxDescriptorSet.java
@@ -0,0 +1,87 @@
+package dev.auralite.render.rhi;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+/**
+ * A bound set of resources.
+ *
+ * <p>Deliberately backend-neutral: the GL backend turns this into indexed
+ * texture/buffer-range binding calls, the Vulkan backend into a
+ * {@code VkDescriptorSet} write. Packs never see the difference.
+ */
+public final class GfxDescriptorSet {
+    public static final class Write {
+        public final int binding;
+        public final GfxDesc.PipelineLayout.Kind kind;
+        public final GfxResource resource;
+        public final long offset;
+        public final long range;
+        public final int arrayIndex;
+
+        public Write(int binding, GfxDesc.PipelineLayout.Kind kind, GfxResource resource,
+                     long offset, long range, int arrayIndex) {
+            this.binding = binding;
+            this.kind = kind;
+            this.resource = resource;
+            this.offset = offset;
+            this.range = range;
+            this.arrayIndex = arrayIndex;
+        }
+
+        public static Write uniform(int binding, GfxBuffer b) {
+            return new Write(binding, GfxDesc.PipelineLayout.Kind.UNIFORM_BUFFER, b, 0, b.sizeBytes(), 0);
+        }
+        public static Write uniform(int binding, GfxBuffer b, long offset, long range) {
+            return new Write(binding, GfxDesc.PipelineLayout.Kind.UNIFORM_BUFFER, b, offset, range, 0);
+        }
+        public static Write storage(int binding, GfxBuffer b) {
+            return new Write(binding, GfxDesc.PipelineLayout.Kind.STORAGE_BUFFER, b, 0, b.sizeBytes(), 0);
+        }
+        public static Write sampler(int binding, GfxImage img, GfxSampler smp) {
+            Write w = new Write(binding, GfxDesc.PipelineLayout.Kind.COMBINED_IMAGE_SAMPLER, img, 0, 0, 0);
+            w.combinedSampler = smp;
+            return w;
+        }
+        public static Write storageImage(int binding, GfxImage img) {
+            return new Write(binding, GfxDesc.PipelineLayout.Kind.STORAGE_IMAGE, img, 0, 0, 0);
+        }
+        public GfxSampler combinedSampler;
+    }
+
+    private final int setIndex;
+    private final List<Write> writes = new ArrayList<Write>();
+
+    public GfxDescriptorSet(int setIndex) { this.setIndex = setIndex; }
+
+    public GfxDescriptorSet add(Write w) { writes.add(w); return this; }
+    public int setIndex() { return setIndex; }
+    public List<Write> writes() { return Collections.unmodifiableList(writes); }
+    public int size() { return writes.size(); }
+
+    /** Validates writes against a layout; returns a named reason or {@code null}. */
+    public String validateAgainst(GfxDesc.PipelineLayout layout) {
+        if (layout == null) return "null pipeline layout";
+        if (setIndex >= layout.sets.size()) {
+            return "set " + setIndex + " not declared (layout declares " + layout.sets.size() + ")";
+        }
+        GfxDesc.PipelineLayout.SetLayout sl = layout.sets.get(setIndex);
+        for (Write w : writes) {
+            GfxDesc.PipelineLayout.BindingDesc found = null;
+            for (GfxDesc.PipelineLayout.BindingDesc b : sl.bindings) {
+                if (b.binding == w.binding) { found = b; break; }
+            }
+            if (found == null) {
+                return "binding " + w.binding + " not declared in set " + setIndex;
+            }
+            if (found.kind != w.kind) {
+                return "binding " + w.binding + " declared as " + found.kind + " but written as " + w.kind;
+            }
+            if (found.kind == GfxDesc.PipelineLayout.Kind.COMBINED_IMAGE_SAMPLER && w.combinedSampler == null) {
+                return "binding " + w.binding + " is a combined image sampler but no sampler was supplied";
+            }
+        }
+        return null;
+    }
+}
diff --git a/core/src/main/java/dev/auralite/render/rhi/GfxDevice.java b/core/src/main/java/dev/auralite/render/rhi/GfxDevice.java
new file mode 100644
index 0000000..5085c3b
--- /dev/null
+++ b/core/src/main/java/dev/auralite/render/rhi/GfxDevice.java
@@ -0,0 +1,64 @@
+package dev.auralite.render.rhi;
+
+import dev.auralite.render.rhi.GfxEnums.BackendType;
+import dev.auralite.render.rhi.GfxEnums.QueueType;
+
+import java.nio.ByteBuffer;
+import java.util.Set;
+
+/**
+ * The whole backend surface.
+ *
+ * <p>Implementations: {@code NullDevice} (host tests), {@code Gl46Device}
+ * (OpenGL 4.6 core), {@code Vk13Device} (Vulkan 1.3). A Minecraft frame is
+ * expressed once against this interface and runs on any of the three.
+ */
+public interface GfxDevice extends AutoCloseable {
+
+    BackendType backendType();
+    String backendName();
+    String deviceName();
+    String driverVersion();
+    DeviceLimits limits();
+    Set<GfxCapability> capabilities();
+    boolean hasCapability(GfxCapability c);
+
+    // ---- creation -----------------------------------------------------
+    GfxBuffer createBuffer(GfxDesc.Buffer desc);
+    GfxImage createImage(GfxDesc.Image desc);
+    GfxSampler createSampler(GfxDesc.Sampler desc);
+    GfxShaderModule createShaderModule(ShaderSource source);
+    GfxPipeline createGraphicsPipeline(GfxDesc.GraphicsPipeline desc);
+    GfxPipeline createComputePipeline(GfxDesc.ComputePipeline desc);
+    GfxCommandBuffer createCommandBuffer(QueueType queue);
+
+    // ---- uploads ------------------------------------------------------
+    void uploadBuffer(GfxBuffer dst, ByteBuffer src, long dstOffsetBytes);
+    void uploadBuffer(GfxBuffer dst, float[] src, long dstOffsetBytes);
+    void uploadBuffer(GfxBuffer dst, int[] src, long dstOffsetBytes);
+    void uploadImage(GfxImage dst, int mipLevel, ByteBuffer src);
+    void uploadImageRegion(GfxImage dst, int mipLevel, int x, int y, int z,
+                           int w, int h, int d, ByteBuffer src);
+
+    // ---- frame --------------------------------------------------------
+    /** Begins a frame; returns a monotonically increasing frame id. */
+    long beginFrame();
+    void submit(QueueType queue, GfxCommandBuffer cmd);
+    void submitAndWait(QueueType queue, GfxCommandBuffer cmd);
+    void endFrame();
+    /** Blocks until all submitted work is done. Used at pack reload. */
+    void waitIdle();
+
+    // ---- diagnostics --------------------------------------------------
+    /** Live GPU object counts, for the leak gate. */
+    int liveBufferCount();
+    int liveImageCount();
+    int livePipelineCount();
+    int liveShaderModuleCount();
+    /** Last backend error string, empty when clean. */
+    String lastError();
+    /** Milliseconds spent inside this device since creation (CPU-side, honest). */
+    long cpuTimeMillis();
+
+    @Override void close();
+}
diff --git a/core/src/main/java/dev/auralite/render/rhi/GfxEnums.java b/core/src/main/java/dev/auralite/render/rhi/GfxEnums.java
new file mode 100644
index 0000000..d4e6a9f
--- /dev/null
+++ b/core/src/main/java/dev/auralite/render/rhi/GfxEnums.java
@@ -0,0 +1,102 @@
+package dev.auralite.render.rhi;
+
+/** Small, closed enumerations shared by descriptors and the render graph. */
+public final class GfxEnums {
+    private GfxEnums() { }
+
+    public enum BackendType {
+        /** Recording backend: no GPU, used by every host-side test gate. */
+        NULL,
+        OPENGL_46,
+        VULKAN_13
+    }
+
+    public enum ImageType { TEXTURE_1D, TEXTURE_2D, TEXTURE_3D, CUBE }
+
+    public enum LoadOp { LOAD, CLEAR, DONT_CARE }
+    public enum StoreOp { STORE, DONT_CARE, RESOLVE }
+
+    public enum Filter { NEAREST, LINEAR }
+    public enum MipmapMode { NEAREST, LINEAR }
+    public enum AddressMode { REPEAT, MIRRORED_REPEAT, CLAMP_TO_EDGE, CLAMP_TO_BORDER }
+
+    public enum CompareOp {
+        NEVER, LESS, EQUAL, LESS_OR_EQUAL, GREATER, NOT_EQUAL, GREATER_OR_EQUAL, ALWAYS
+    }
+
+    public enum BlendFactor {
+        ZERO, ONE,
+        SRC_COLOR, ONE_MINUS_SRC_COLOR,
+        DST_COLOR, ONE_MINUS_DST_COLOR,
+        SRC_ALPHA, ONE_MINUS_SRC_ALPHA,
+        DST_ALPHA, ONE_MINUS_DST_ALPHA,
+        CONSTANT_COLOR, ONE_MINUS_CONSTANT_COLOR,
+        SRC_ALPHA_SATURATE
+    }
+
+    public enum BlendOp { ADD, SUBTRACT, REVERSE_SUBTRACT, MIN, MAX }
+
+    public enum CullMode { NONE, FRONT, BACK, FRONT_AND_BACK }
+    public enum FrontFace { COUNTER_CLOCKWISE, CLOCKWISE }
+
+    public enum Topology {
+        POINT_LIST, LINE_LIST, LINE_STRIP, TRIANGLE_LIST, TRIANGLE_STRIP,
+        TRIANGLE_FAN, PATCH_LIST
+    }
+
+    public enum MemoryDomain {
+        DEVICE_LOCAL, HOST_VISIBLE, HOST_VISIBLE_DEVICE_LOCAL
+    }
+
+    public enum QueueType { GRAPHICS, COMPUTE, TRANSFER }
+
+    /**
+     * State a resource is in, for layout/barrier inference.
+     *
+     * <p>OpenGL hides this behind driver-side tracking; Vulkan requires it
+     * explicitly. The render graph infers it once and the GL backend simply
+     * ignores the transitions, which is why both backends can share one graph.
+     */
+    public enum ResourceState {
+        UNDEFINED,
+        COLOR_ATTACHMENT_WRITE,
+        DEPTH_STENCIL_WRITE,
+        DEPTH_STENCIL_READ,
+        SHADER_READ,
+        STORAGE_WRITE,
+        STORAGE_READ,
+        COPY_SOURCE,
+        COPY_DEST,
+        PRESENT,
+        HOST_READ
+    }
+
+    /** Access mask used for barrier generation. Bitwise-OR-able. */
+    public static final class Access {
+        private Access() { }
+        public static final int NONE = 0;
+        public static final int INPUT_ATTACHMENT_READ = 1;
+        public static final int SHADER_READ = 1 << 1;
+        public static final int SHADER_WRITE = 1 << 2;
+        public static final int COLOR_ATTACHMENT_READ = 1 << 3;
+        public static final int COLOR_ATTACHMENT_WRITE = 1 << 4;
+        public static final int DEPTH_STENCIL_READ = 1 << 5;
+        public static final int DEPTH_STENCIL_WRITE = 1 << 6;
+        public static final int TRANSFER_READ = 1 << 7;
+        public static final int TRANSFER_WRITE = 1 << 8;
+        public static final int HOST_READ = 1 << 9;
+        public static final int HOST_WRITE = 1 << 10;
+        public static final int MEMORY_READ = 1 << 11;
+        public static final int MEMORY_WRITE = 1 << 12;
+
+        public static boolean isWrite(int mask) {
+            return (mask & (SHADER_WRITE | COLOR_ATTACHMENT_WRITE | DEPTH_STENCIL_WRITE
+                    | TRANSFER_WRITE | HOST_WRITE | MEMORY_WRITE)) != 0;
+        }
+    }
+
+    /** Pass kind, drives which pipeline type a graph pass must bind. */
+    public enum PassType {
+        RASTER, COMPUTE, COPY, TRANSFER_BLIT, EXTERNAL
+    }
+}
diff --git a/core/src/main/java/dev/auralite/render/rhi/GfxException.java b/core/src/main/java/dev/auralite/render/rhi/GfxException.java
