+package dev.auralite.render.tests;
+
+import dev.auralite.render.rhi.DeviceLimits;
+import dev.auralite.render.rhi.GfxCapability;
+import dev.auralite.render.rhi.GfxDesc;
+import dev.auralite.render.rhi.GfxFormat;
+import dev.auralite.render.rhi.GfxStage;
+import dev.auralite.render.rhi.GfxUsage;
+import dev.auralite.render.rhi.ShaderSource;
+
+import java.util.Arrays;
+
+import static dev.auralite.render.tests.TestRig.check;
+import static dev.auralite.render.tests.TestRig.eq;
+import static dev.auralite.render.tests.TestRig.near;
+import static dev.auralite.render.tests.TestRig.receipt;
+import static dev.auralite.render.tests.TestRig.section;
+import static dev.auralite.render.tests.TestRig.suite;
+import static dev.auralite.render.tests.TestRig.throwsNamed;
+
+/** R0/R1 gate: the format table, the descriptors and the shader-source rules. */
+public final class RhiSuite {
+    private RhiSuite() { }
+
+    public static void run() {
+        suite("rhi");
+
+        section("formats");
+        eq(GfxFormat.RGBA16F.bytesPerTexel(), 8, "RGBA16F is 8 bytes per texel");
+        eq(GfxFormat.RGBA32F.bytesPerTexel(), 16, "RGBA32F is 16 bytes per texel");
+        eq(GfxFormat.R32_UINT.bytesPerTexel(), 4, "R32_UINT is 4 bytes per texel");
+        check(GfxFormat.RGBA8_SRGB.isSrgb(), "RGBA8_SRGB reports srgb");
+        check(!GfxFormat.RGBA8_UNORM.isSrgb(), "RGBA8_UNORM does not report srgb");
+        check(GfxFormat.R32_UINT.isInteger(), "R32_UINT is an integer format");
+        check(GfxFormat.R32_UINT.requiresIntegerSampler(), "integer formats need an integer sampler");
+        check(GfxFormat.D32_SFLOAT.isDepth(), "D32_SFLOAT is a depth format");
+        check(!GfxFormat.D32_SFLOAT.isColorAttachment(), "a depth format is not a colour attachment");
+        check(GfxFormat.RGBA16F.isColorAttachment(), "RGBA16F is a colour attachment");
+        check(!GfxFormat.BC7_SRGB.isStorableImage(), "a compressed format is not a storage image");
+
+        section("format lookup");
+        eq(GfxFormat.fromName("rgba16f"), GfxFormat.RGBA16F, "exact name lookup");
+        eq(GfxFormat.fromName("RGBA16F"), GfxFormat.RGBA16F, "lookup is case-insensitive");
+        eq(GfxFormat.fromName("rgba16"), GfxFormat.RGBA16F, "legacy spelling 'rgba16'");
+        eq(GfxFormat.fromName("rg11b10"), GfxFormat.RG11B10F, "legacy spelling 'rg11b10'");
+        eq(GfxFormat.fromName("r8"), GfxFormat.R8_UNORM, "legacy spelling 'r8'");
+        eq(GfxFormat.fromName("depth"), GfxFormat.D32_SFLOAT, "legacy spelling 'depth'");
+        eq(GfxFormat.fromName("not-a-format"), GfxFormat.UNDEFINED, "unknown name yields UNDEFINED");
+        eq(GfxFormat.fromName(null), GfxFormat.UNDEFINED, "null name yields UNDEFINED");
+
+        section("image descriptors");
+        GfxDesc.Image full = GfxDesc.Image.tex2d(1920, 1080, GfxFormat.RGBA16F, GfxUsage.IMAGE_COLOR_ATTACHMENT);
+        eq(full.levelBytes(), 1920L * 1080 * 8, "level 0 bytes for 1920x1080 RGBA16F");
+        GfxDesc.Image mipped = GfxDesc.Image.tex2d(1024, 1024, GfxFormat.RGBA16F, 0).fullMipChain();
+        eq(mipped.mipLevels, 11, "a 1024x1024 image has 11 mip levels");
+        // 1024^2 * 8 * (1 + 1/4 + 1/16 + ...) converges to 4/3 of level 0.
+        near(mipped.approxBytes() / (double) (1024L * 1024 * 8), 4.0 / 3.0, 0.01,
+                "full mip chain is ~4/3 of level 0");
+        GfxDesc.Image vol = GfxDesc.Image.tex3d(64, 96, 64, GfxFormat.RGBA8_UINT, GfxUsage.IMAGE_SAMPLED);
+        eq(vol.texelCount(), 64L * 96 * 64, "3D texel count");
+        eq(vol.levelBytes(), 64L * 96 * 64 * 4, "3D level bytes for RGBA8UI");
+        eq(vol.approxBytes(), vol.levelBytes(), "a single-mip 3D image has no chain overhead");
+
+        section("descriptor hashing");
+        GfxDesc.Image a = GfxDesc.Image.tex2d(1920, 1080, GfxFormat.RGBA16F, 0);
+        GfxDesc.Image b = GfxDesc.Image.tex2d(1920, 1080, GfxFormat.RGBA16F, 0);
+        GfxDesc.Image c = GfxDesc.Image.tex2d(1920, 1080, GfxFormat.RGBA8_UNORM, 0);
+        eq(a.hash(), b.hash(), "identical descriptors hash identically");
+        check(a.hash() != c.hash(), "a format change changes the hash");
+        GfxDesc.Sampler s1 = GfxDesc.Sampler.linearClamp();
+        GfxDesc.Sampler s2 = GfxDesc.Sampler.linearClamp().aniso(16);
+        check(s1.hash() != s2.hash(), "anisotropy is part of the sampler hash");
+
+        section("limits");
+        eq(DeviceLimits.align(100, 256), 256L, "align 100 to 256");
+        eq(DeviceLimits.align(512, 256), 512L, "512 is already aligned to 256");
+        eq(DeviceLimits.align(0, 256), 0L, "zero stays zero");
+        DeviceLimits l = new DeviceLimits();
+        check(l.supportsDispatch(240, 135, 1, 8, 8, 1), "a 1920x1080 / 8x8 dispatch fits");
+        check(!l.supportsDispatch(1, 1, 1, 2048, 1, 1), "a 2048-wide local size does not fit");
+        check(!l.supportsDispatch(99999, 1, 1, 8, 8, 1), "a work-group count over the limit does not fit");
+
+        section("stages");
+        eq(GfxStage.fromExtension("vsh"), GfxStage.VERTEX, "legacy .vsh maps to VERTEX");
+        eq(GfxStage.fromExtension("fsh"), GfxStage.FRAGMENT, "legacy .fsh maps to FRAGMENT");
+        eq(GfxStage.fromExtension("comp"), GfxStage.COMPUTE, ".comp maps to COMPUTE");
+        eq(GfxStage.fromExtension("glsl.frag"), GfxStage.FRAGMENT, "glsl.frag maps to FRAGMENT");
+        eq(GfxStage.fromExtension("txt"), null, "an unknown extension maps to nothing");
+        check(GfxStage.COMPUTE.isGraphics() == false, "COMPUTE is not a graphics stage");
+        check(GfxStage.CLOSEST_HIT.isRayTracing(), "CLOSEST_HIT is a ray-tracing stage");
+        check(GfxStage.MESH.optional(), "MESH is optional in a graphics pipeline");
+        check(!GfxStage.FRAGMENT.optional(), "FRAGMENT is not optional");
+
+        section("shader sources");
+        ShaderSource glsl = ShaderSource.glsl(GfxStage.FRAGMENT,
+                "#version 460 core\nvoid main() { }\n", "test.frag");
+        check(glsl.preprocessed().contains("void main("), "preprocessed GLSL keeps the entry point");
+        eq(glsl.preprocessed().split("#version", -1).length - 1, 1,
+                "preprocessing yields exactly one #version line");
+        ShaderSource withDefines = glsl.withDefines(Arrays.asList("CLOUD_QUALITY 36"));
+        check(withDefines.preprocessed().contains("#define CLOUD_QUALITY 36"), "defines are prepended");
+        check(withDefines.hash() != glsl.hash(), "defines change the source hash");
+        eq(ShaderSource.stripVersion("#version 450\nint x;"), "int x;", "#version is stripped");
+        ShaderSource spirv = ShaderSource.spirv(GfxStage.COMPUTE, new byte[64], "main", "test.comp.spv");
+        throwsNamed(new Runnable() {
+            @Override public void run() { spirv.withDefines(Arrays.asList("X 1")); }
+        }, "SPIR-V cannot take preprocessor defines", "defines on SPIR-V are refused with a reason");
+
+        section("capabilities");
+        eq(GfxCapability.values().length, 27, "the capability enum has 27 members");
+        check(GfxCapability.COMPUTE_SHADERS.ordinal() == 0, "COMPUTE_SHADERS is first");
+
+        receipt("rhi: " + GfxFormat.values().length + " formats, "
+                + GfxStage.values().length + " stages, "
+                + GfxCapability.values().length + " capabilities");
+    }
+}
diff --git a/tests/src/dev/auralite/render/tests/RunAll.java b/tests/src/dev/auralite/render/tests/RunAll.java
new file mode 100644
index 0000000..798b5b9
--- /dev/null
+++ b/tests/src/dev/auralite/render/tests/RunAll.java
@@ -0,0 +1,89 @@
+package dev.auralite.render.tests;
+
+/**
+ * Runs every host-side suite in one JVM and reports one total.
+ *
+ * <p>Each suite gets a clean rig, so a failure in one cannot mask or inflate
+ * another. The exit code is the number of failed suites, which is what
+ * {@code make test} and CI gate on.
+ */
+public final class RunAll {
+
+    private interface Suite {
+        String name();
+        void run();
+    }
+
+    private static Suite suite(final String name, final Runnable body) {
+        return new Suite() {
+            @Override public String name() { return name; }
+            @Override public void run() { body.run(); }
+        };
+    }
+
+    public static void main(String[] args) {
+        Suite[] suites = {
+            suite("rhi", new Runnable() { @Override public void run() { RhiSuite.run(); } }),
+            suite("graph", new Runnable() { @Override public void run() { GraphSuite.run(); } }),
+            suite("uniform", new Runnable() { @Override public void run() { UniformSuite.run(); } }),
+            suite("biome", new Runnable() { @Override public void run() { BiomeSuite.run(); } }),
+            suite("nulldev", new Runnable() { @Override public void run() { NullDeviceSuite.run(); } }),
+            suite("pack", new Runnable() { @Override public void run() { PackSuite.run(); } }),
+        };
+
+        boolean onlyReceipts = args.length > 0 && args[0].equals("--receipts");
+        int totalPassed = 0, totalFailed = 0, totalNc = 0, failedSuites = 0;
+        long t0 = System.nanoTime();
+
+        System.out.println("AuraLite-Render host test gates");
+        System.out.println("java " + System.getProperty("java.version")
+                + " on " + System.getProperty("os.name") + " " + System.getProperty("os.arch"));
+        System.out.println();
+
+        for (Suite s : suites) {
+            TestRig.reset();
+            long st = System.nanoTime();
+            Throwable crash = null;
+            try {
+                s.run();
+            } catch (Throwable t) {
+                crash = t;
+            }
+            long micros = (System.nanoTime() - st) / 1000L;
+            int passed = TestRig.passed(), failed = TestRig.failed();
+            if (crash != null) failed++;
+            totalPassed += passed; totalFailed += failed; totalNc += TestRig.negativeControls();
+
+            System.out.printf("%-9s %4d passed  %2d failed  %2d NC  %6d us  %s%n",
+                    s.name(), passed, failed, TestRig.negativeControls(), micros,
+                    failed == 0 ? "PASS" : "FAIL");
+
+            if (!onlyReceipts) {
+                for (String r : TestRig.receipts()) System.out.println(indent(r));
+            }
+            for (String f : TestRig.failures()) System.out.println(f);
+            if (crash != null) {
+                System.out.println("  CRASH [" + s.name() + "] " + crash);
+                for (StackTraceElement e : crash.getStackTrace()) {
+                    if (e.getClassName().startsWith("dev.auralite")) System.out.println("    at " + e);
+                }
+            }
+            if (failed > 0) failedSuites++;
+        }
+
+        if (onlyReceipts) {
+            System.out.println();
+            System.out.println("receipts (rerun without --receipts to see them per suite):");
+        }
+        System.out.println();
+        System.out.printf("TOTAL %d passed, %d failed, %d negative controls, %d/%d suites green, %d us%n",
+                totalPassed, totalFailed, totalNc, suites.length - failedSuites, suites.length,
+                (System.nanoTime() - t0) / 1000L);
+        System.out.println(totalFailed == 0 ? "RESULT: PASS" : "RESULT: FAIL");
+        System.exit(totalFailed == 0 ? 0 : 1);
+    }
+
+    private static String indent(String s) {
+        return "    " + s.replace("\n", "\n    ");
+    }
+}
diff --git a/tests/src/dev/auralite/render/tests/TestRig.java b/tests/src/dev/auralite/render/tests/TestRig.java
new file mode 100644
index 0000000..07842f1
--- /dev/null
+++ b/tests/src/dev/auralite/render/tests/TestRig.java
@@ -0,0 +1,153 @@
+package dev.auralite.render.tests;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * The host-side test rig.
+ *
+ * <p>No JUnit, no reflection, no annotations: a suite is a {@code static void
+ * run()} and an assertion is a method call, so {@code make test} needs nothing
+ * but a JDK. That is deliberate -- the gates run in CI on a runner with no GPU,
+ * no display and no dependency resolution, and they must not be able to fail
+ * for a reason other than the code under test.
+ *
+ * <p>Every failure records the assertion, the expected value and the actual
+ * one, and {@link #finish()} prints one line per fact plus a total, so a
+ * regression reads as a diff rather than a stack trace.
+ */
+public final class TestRig {
+
+    private TestRig() { }
+
+    private static String suite = "";
+    private static String section = "";
+    private static int passed;
+    private static int failed;
+    private static int negativeControls;
+    private static final List<String> failures = new ArrayList<String>();
+    private static final List<String> receipts = new ArrayList<String>();
+
+    public static void reset() {
+        suite = ""; section = "";
+        passed = 0; failed = 0; negativeControls = 0;
+        failures.clear();
+        receipts.clear();
+    }
+
+    public static void suite(String name) { suite = name; }
+    public static void section(String name) { section = name; }
+
+    /** Records a measured fact that the plan docs quote. */
+    public static void receipt(String fact) { receipts.add("[" + suite + "] " + fact); }
+
+    public static void check(boolean ok, String what) {
+        if (ok) passed++;
+        else fail(what, "true", "false");
+    }
+
+    public static void eq(long actual, long expected, String what) {
+        if (actual == expected) passed++;
+        else fail(what, Long.toString(expected), Long.toString(actual));
+    }
+
+    public static void eq(int actual, int expected, String what) { eq((long) actual, (long) expected, what); }
+
+    public static void eq(Object actual, Object expected, String what) {
+        if (expected == null ? actual == null : expected.equals(actual)) passed++;
+        else fail(what, String.valueOf(expected), String.valueOf(actual));
+    }
+
+    public static void eq(String actual, String expected, String what) { eq((Object) actual, (Object) expected, what); }
+
+    public static void near(double actual, double expected, double eps, String what) {
+        if (Math.abs(actual - expected) <= eps) passed++;
+        else fail(what, expected + " +/-" + eps, Double.toString(actual));
+    }
+
+    public static void notNull(Object o, String what) {
+        if (o != null) passed++;
+        else fail(what, "non-null", "null");
+    }
+
+    public static void isNull(Object o, String what) {
+        if (o == null) passed++;
+        else fail(what, "null", String.valueOf(o));
+    }
+
+    public static void contains(String haystack, String needle, String what) {
+        if (haystack != null && haystack.contains(needle)) passed++;
+        else fail(what, "contains '" + needle + "'", String.valueOf(haystack));
+    }
+
+    public static void notContains(String haystack, String needle, String what) {
+        if (haystack == null || !haystack.contains(needle)) passed++;
+        else fail(what, "does not contain '" + needle + "'", haystack);
+    }
+
+    /**
+     * Asserts that {@code body} throws, and that the message names the reason.
+     * A refusal with no reason is treated as a failure: this codebase does not
+     * throw bare exceptions.
+     */
+    public static void throwsNamed(Runnable body, String expectedInMessage, String what) {
+        try {
+            body.run();
+        } catch (RuntimeException e) {
+            String m = String.valueOf(e.getMessage());
+            if (expectedInMessage == null || m.contains(expectedInMessage)) { passed++; return; }
+            fail(what, "message contains '" + expectedInMessage + "'", m);
+            return;
+        }
+        fail(what, "an exception naming '" + expectedInMessage + "'", "no exception");
+    }
+
+    /**
+     * The negative control: revert the fix and the gate must redden.
+     *
+     * <p>Called with a body that is expected to FAIL. If it passes, the
+     * assertion is not actually testing anything and that is reported.
+     */
+    public static void negativeControl(String what, Runnable bodyThatMustFail) {
+        int before = failed;
+        boolean threw = false;
+        try {
+            bodyThatMustFail.run();
+        } catch (RuntimeException e) {
+            threw = true;
+        }
+        // Roll back whatever the control recorded so it does not pollute totals.
+        if (failed > before) {
+            failures.remove(failures.size() - 1);
+            failed = before;
+        }
+        if (threw || failed > before) { negativeControls++; return; }
+        fail("NEGATIVE CONTROL '" + what + "' did not redden -- the gate proves nothing", "failure", "success");
+    }
+
+    private static void fail(String what, String expected, String actual) {
+        failed++;
+        failures.add("  FAIL [" + suite + (section.isEmpty() ? "" : "/" + section) + "] " + what
+                + "\n       expected: " + expected + "\n       actual:   " + actual);
+    }
+
+    public static int passed() { return passed; }
+    public static int failed() { return failed; }
+    public static int negativeControls() { return negativeControls; }
+    public static List<String> failures() { return failures; }
+    public static List<String> receipts() { return receipts; }
+
+    /** Prints the summary. Returns a process exit code. */
+    public static int finish() {
+        for (String r : receipts) System.out.println(r);
+        if (!failures.isEmpty()) {
+            System.out.println();
+            for (String f : failures) System.out.println(f);
+        }
+        System.out.println();
+        System.out.println("assertions: " + passed + " passed, " + failed + " failed, "
+                + negativeControls + " negative controls");
+        System.out.println(failed == 0 ? "RESULT: PASS" : "RESULT: FAIL");
+        return failed == 0 ? 0 : 1;
+    }
+}
diff --git a/tests/src/dev/auralite/render/tests/UniformSuite.java b/tests/src/dev/auralite/render/tests/UniformSuite.java
new file mode 100644
index 0000000..7903a99
--- /dev/null
+++ b/tests/src/dev/auralite/render/tests/UniformSuite.java
@@ -0,0 +1,292 @@
+package dev.auralite.render.tests;
+
+import dev.auralite.render.biome.BiomeRegistry;
+import dev.auralite.render.uniform.CustomUniformTable;
+import dev.auralite.render.uniform.ExprEnv;
+import dev.auralite.render.uniform.ExprParser;
+import dev.auralite.render.uniform.FunctionTable;
+import dev.auralite.render.uniform.Value;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+import static dev.auralite.render.tests.TestRig.check;
+import static dev.auralite.render.tests.TestRig.eq;
+import static dev.auralite.render.tests.TestRig.near;
+import static dev.auralite.render.tests.TestRig.receipt;
+import static dev.auralite.render.tests.TestRig.section;
+import static dev.auralite.render.tests.TestRig.suite;
+import static dev.auralite.render.tests.TestRig.throwsNamed;
+
+/**
+ * C1 gate: the CPU expression evaluator that LEGACY packs depend on, measured
+ * against the exact chain AuraLite-Shaders v1.2.0 ships.
+ */
+public final class UniformSuite {
+    private UniformSuite() { }
+
+    /** The water-colour chain as it appears in AuraLite-Shaders' shaders.properties. */
+    static final String WATER_R =
+            "if(in(biome, BIOME_SWAMP), 0.38, "
+          + "in(biome, BIOME_LUKEWARM_OCEAN, BIOME_DEEP_LUKEWARM_OCEAN), 0.271, "
+          + "in(biome, BIOME_WARM_OCEAN), 0.263, "
+          + "in(biome, BIOME_COLD_OCEAN, BIOME_DEEP_COLD_OCEAN, BIOME_SNOWY_TAIGA, BIOME_SNOWY_BEACH), 0.239, "
+          + "in(biome, BIOME_FROZEN_RIVER, BIOME_FROZEN_OCEAN, BIOME_DEEP_FROZEN_OCEAN), 0.224, "
+          + "in(biome, BIOME_MEADOW), 0.055, "
+          + "in(biome, BIOME_MANGROVE_SWAMP), 0.227, 0.247)";
+    static final String WATER_G =
+            "if(in(biome, BIOME_SWAMP), 0.482, "
+          + "in(biome, BIOME_LUKEWARM_OCEAN, BIOME_DEEP_LUKEWARM_OCEAN), 0.678, "
+          + "in(biome, BIOME_WARM_OCEAN), 0.835, "
+          + "in(biome, BIOME_COLD_OCEAN, BIOME_DEEP_COLD_OCEAN, BIOME_SNOWY_TAIGA, BIOME_SNOWY_BEACH), 0.341, "
+          + "in(biome, BIOME_FROZEN_RIVER, BIOME_FROZEN_OCEAN, BIOME_DEEP_FROZEN_OCEAN), 0.22, "
+          + "in(biome, BIOME_MEADOW), 0.306, "
+          + "in(biome, BIOME_MANGROVE_SWAMP), 0.478, 0.463)";
+    static final String WATER_B =
+            "if(in(biome, BIOME_SWAMP), 0.392, "
+          + "in(biome, BIOME_LUKEWARM_OCEAN, BIOME_DEEP_LUKEWARM_OCEAN), 0.416, "
+          + "in(biome, BIOME_WARM_OCEAN), 0.933, "
+          + "in(biome, BIOME_COLD_OCEAN, BIOME_DEEP_COLD_OCEAN, BIOME_SNOWY_TAIGA, BIOME_SNOWY_BEACH), 0.839, "
+          + "in(biome, BIOME_FROZEN_RIVER, BIOME_FROZEN_OCEAN, BIOME_DEEP_FROZEN_OCEAN), 0.788, "
+          + "in(biome, BIOME_MEADOW), 0.812, "
+          + "in(biome, BIOME_MANGROVE_SWAMP), 0.416, 0.894)";
+
+    private static ExprEnv envWith(BiomeRegistry reg) {
+        ExprEnv env = new ExprEnv(new FunctionTable());
+        reg.bindConstants(env);
+        return env;
+    }
+
+    public static void run() {
+        suite("uniform");
+
+        section("arithmetic and precedence");
+        eq(eval("2 + 3 * 4").asDouble(), 14.0, "multiplication binds tighter than addition");
+        eq(eval("(2 + 3) * 4").asDouble(), 20.0, "parentheses override precedence");
+        eq(eval("10 - 4 - 3").asDouble(), 3.0, "subtraction is left-associative");
+        eq(eval("100 / 10 / 2").asDouble(), 5.0, "division is left-associative");
+        near(eval("7 % 3").asDouble(), 1.0, 1e-12, "modulo");
+        near(eval("-7 % 3").asDouble(), 2.0, 1e-12, "modulo follows GLSL, not Java: the sign of the divisor");
+        eq(eval("-3 + 5").asDouble(), 2.0, "unary minus");
+        eq(eval("--3").asDouble(), 3.0, "double unary minus");
+        near(eval("pi").asDouble(), Math.PI, 1e-12, "pi is predefined");
+        eq(eval("0x10").asDouble(), 16.0, "hexadecimal literal");
+        eq(eval("1e3").asDouble(), 1000.0, "exponent literal");
+        eq(eval("2.5f").asDouble(), 2.5, "a trailing f suffix is accepted");
+
+        section("comparison and logic");
+        check(eval("1 < 2").asBool(), "less-than");
+        check(!eval("2 < 1").asBool(), "less-than, false case");
+        check(eval("2 >= 2").asBool(), "greater-or-equal");
+        check(eval("3 == 3").asBool(), "equality");
+        check(eval("3 != 4").asBool(), "inequality");
+        check(eval("true && !false").asBool(), "logical and / not");
+        check(!eval("true && false").asBool(), "logical and, false case");
+        check(eval("false || true").asBool(), "logical or");
+        eq(eval("1 + 2 == 3").asBool(), true, "comparison binds looser than addition");
+        eq(eval("1 < 2 == true").asBool(), true, "equality binds looser than comparison");
+
+        section("functions");
+        eq(eval("max(3, 7)").asDouble(), 7.0, "max");
+        eq(eval("min(3, 7)").asDouble(), 3.0, "min");
+        eq(eval("clamp(9, 0, 1)").asDouble(), 1.0, "clamp");
+        eq(eval("abs(-4)").asDouble(), 4.0, "abs");
+        eq(eval("floor(2.7)").asDouble(), 2.0, "floor");
+        eq(eval("ceil(2.1)").asDouble(), 3.0, "ceil");
+        eq(eval("round(2.5)").asDouble(), 2.0, "round uses banker's rounding, as Math.rint does");
+        eq(eval("mix(0, 10, 0.25)").asDouble(), 2.5, "mix");
+        near(eval("smoothstep(0, 1, 0.5)").asDouble(), 0.5, 1e-9, "smoothstep midpoint");
+        near(eval("sqrt(16)").asDouble(), 4.0, 1e-12, "sqrt");
+        near(eval("sin(pi / 2)").asDouble(), 1.0, 1e-12, "sin");
+        near(eval("atan2(1, 1)").asDouble(), Math.PI / 4, 1e-12, "atan2");
+        eq(eval("if(true, 10, 20)").asDouble(), 10.0, "if, true branch");
+        eq(eval("if(false, 10, 20)").asDouble(), 20.0, "if, false branch");
+        check(eval("in(3, 1, 2, 3, 4)").asBool(), "in, present");
+        check(!eval("in(9, 1, 2, 3)").asBool(), "in, absent");
+        eq(eval("vec3(1, 2, 3)").size(), 3, "vec3 has three components");
+        near(eval("vec3(1, 2, 3)").component(2), 3.0, 1e-12, "vec3 component access");
+        near(eval("length(vec3(3, 4, 0))").asDouble(), 5.0, 1e-12, "length of a vector");
+        near(eval("dot(vec2(1,2), vec2(3,4))").asDouble(), 11.0, 1e-12, "dot product");
+
+        section("vector arithmetic");
+        Value v = eval("vec3(1, 2, 3) * 2");
+        eq(v.size(), 3, "scalar * vector keeps the vector size");
+        near(v.component(1), 4.0, 1e-12, "component-wise multiply");
+        Value w = eval("vec2(1, 2) + vec2(10, 20)");
+        near(w.component(0), 11.0, 1e-12, "vector + vector");
+
+        section("errors are named");
+        throwsNamed(new Runnable() { @Override public void run() { eval("2 +"); } },
+                "unexpected end of expression", "a truncated expression names the problem");
+        throwsNamed(new Runnable() { @Override public void run() { eval("1 2"); } },
+                "trailing input", "trailing input is reported");
+        throwsNamed(new Runnable() { @Override public void run() { eval("(1 + 2"); } },
+                "expected ')'", "an unbalanced parenthesis is reported");
+        throwsNamed(new Runnable() { @Override public void run() { eval("nope(1)"); } },
+                "unsupported function", "an unknown function is reported");
+        throwsNamed(new Runnable() { @Override public void run() { eval("max(1)"); } },
+                "takes 2 arguments", "an arity mismatch is reported");
+        ExprEnv bare = new ExprEnv(new FunctionTable());
+        throwsNamed(new Runnable() { @Override public void run() {
+            ExprParser.parse("missingVar + 1").eval(bare);
+        }}, "unknown identifier 'missingVar'", "an unbound identifier names itself");
+
+        section("smooth() is temporal, not spatial");
+        FunctionTable ft = new FunctionTable();
+        ExprEnv senv = new ExprEnv(ft);
+        dev.auralite.render.uniform.Expr e = ExprParser.parse("smooth(t1, target, 4.0)");
+        senv.bindFloat("target", 0.0);
+        ft.setFrame(0, 1.0 / 60.0);
+        double first = e.eval(senv).asDouble();
+        senv.bindFloat("target", 1.0);
+        ft.setFrame(1, 1.0 / 60.0);
+        double second = e.eval(senv).asDouble();
+        ft.setFrame(2, 1.0 / 60.0);
+        double third = e.eval(senv).asDouble();
+        near(first, 0.0, 1e-9, "smooth() starts at the first target");
+        check(second > first && second < 1.0, "smooth() moves toward the target without reaching it");
+        check(third > second, "smooth() keeps approaching");
+        eq(ft.smoothStateCount(), 1, "one smooth state is retained per call site");
+        // Two evaluations inside the same frame must not advance the filter.
+        ft.setFrame(2, 1.0 / 60.0);
+        double again = e.eval(senv).asDouble();
+        near(again, third, 1e-12, "smooth() does not advance twice in one frame");
+        receipt("smooth(t1, 0->1, rate=4): frame1=" + trim(second) + " frame2=" + trim(third));
+
+        section("custom uniform table");
+        BiomeRegistry reg = BiomeRegistry.vanillaDefaults();
+        CustomUniformTable t = new CustomUniformTable();
+        String[] lines = {
+                "# AuraLite-Shaders water colour, verbatim",
+                "variable.float.waterColorR = " + WATER_R,
+                "variable.float.waterColorG = " + WATER_G,
+                "variable.float.waterColorB = " + WATER_B,
+                "uniform.vec3.waterColor = vec3(waterColorR, waterColorG, waterColorB)",
+                "uniform.bool.isSwamp = in(biome, BIOME_SWAMP)",
+                "uniform.float.heat = smooth(heat, if(temperature > 1.0, 1.0, 0.0), 2, 0.25)",
+                "isSwamp.transition = 2.5",
+                "sliders = EXPOSURE CONTRAST",
+        };
+        int parsed = 0;
+        for (String line : lines) if (t.parseLine(line, "test")) parsed++;
+        eq(parsed, 7, "7 of 9 lines are definitions or transitions");
