+++ b/core/src/main/java/dev/auralite/render/biome/BiomeCategory.java
@@ -0,0 +1,36 @@
+package dev.auralite.render.biome;
+
+/**
+ * The {@code CAT_*} constants Iris exposes through {@code biome_category}.
+ *
+ * <p>Names and ordinals are the legacy ones on purpose: a LEGACY pack that
+ * compares {@code biome_category == CAT_OCEAN} must keep getting the same
+ * integer, so this enum's ordinals are part of the compatibility contract and
+ * are pinned by a test gate.
+ */
+public enum BiomeCategory {
+    CAT_NONE,
+    CAT_TAIGA,
+    CAT_EXTREME_HILLS,
+    CAT_JUNGLE,
+    CAT_MESA,
+    CAT_PLAINS,
+    CAT_SAVANNA,
+    CAT_ICY,
+    CAT_THE_END,
+    CAT_BEACH,
+    CAT_FOREST,
+    CAT_OCEAN,
+    CAT_DESERT,
+    CAT_RIVER,
+    CAT_SWAMP,
+    CAT_MUSHROOM,
+    CAT_NETHER;
+
+    public int id() { return ordinal(); }
+
+    public static BiomeCategory byId(int id) {
+        if (id < 0 || id >= values().length) return CAT_NONE;
+        return values()[id];
+    }
+}
diff --git a/core/src/main/java/dev/auralite/render/biome/BiomeField.java b/core/src/main/java/dev/auralite/render/biome/BiomeField.java
new file mode 100644
index 0000000..15083ff
--- /dev/null
+++ b/core/src/main/java/dev/auralite/render/biome/BiomeField.java
@@ -0,0 +1,161 @@
+package dev.auralite.render.biome;
+
+/**
+ * A sliding 3D window of biome ids around the camera, at Minecraft's own
+ * biome granularity of one id per 4x4x4 blocks.
+ *
+ * <p>This is the whole trick behind "more than one biome on screen". Iris
+ * answers "which biome is this?" with one integer sampled at the camera. Here
+ * the answer is a volume, so a fragment 120 blocks away in a swamp asks the
+ * volume at its own position and gets the swamp, while the beach under the
+ * camera gets the beach, in the same draw call and the same frame.
+ *
+ * <p>The window is a flat {@code int[]} rather than a sparse map because the
+ * access pattern is a strided 8-neighbourhood read at fragment rate: a flat
+ * array is cache-friendly, branch-free and copies to the GPU in one
+ * {@code glTexSubImage3D} / buffer upload.
+ */
+public final class BiomeField {
+    /** Cell value meaning "nothing ingested here yet". */
+    public static final int UNKNOWN = -1;
+
+    /** Blocks per cell edge. Minecraft's biome container granularity. */
+    public static final int DEFAULT_CELL_SIZE = 4;
+
+    private final int cellSize;
+    private int originCX, originCY, originCZ;
+    private int sizeCX, sizeCY, sizeCZ;
+    private int[] ids = new int[0];
+    private long version;
+    private int filledCells;
+    private long totalWrites;
+    private long windowMoves;
+
+    public BiomeField() { this(DEFAULT_CELL_SIZE); }
+
+    public BiomeField(int cellSize) {
+        if (cellSize < 1) throw new IllegalArgumentException("cellSize must be >= 1");
+        this.cellSize = cellSize;
+    }
+
+    public int cellSize() { return cellSize; }
+    public int sizeCX() { return sizeCX; }
+    public int sizeCY() { return sizeCY; }
+    public int sizeCZ() { return sizeCZ; }
+    public int originCX() { return originCX; }
+    public int originCY() { return originCY; }
+    public int originCZ() { return originCZ; }
+    public long version() { return version; }
+    public int filledCells() { return filledCells; }
+    public long totalWrites() { return totalWrites; }
+    public long windowMoves() { return windowMoves; }
+    public int cellCapacity() { return ids.length; }
+    public long sizeBytes() { return (long) ids.length * 4; }
+
+    /** (Re)allocates the window. Existing contents are dropped and marked unknown. */
+    public BiomeField allocate(int cx, int cy, int cz) {
+        if (cx < 1 || cy < 1 || cz < 1) throw new IllegalArgumentException("window must be at least 1x1x1");
+        this.sizeCX = cx; this.sizeCY = cy; this.sizeCZ = cz;
+        this.ids = new int[cx * cy * cz];
+        java.util.Arrays.fill(ids, UNKNOWN);
+        this.filledCells = 0;
+        bumpVersion();
+        return this;
+    }
+
+    /** Recentres the window on a cell coordinate, preserving cells that stay inside. */
+    public BiomeField moveWindowTo(int newOriginCX, int newOriginCY, int newOriginCZ) {
+        if (ids.length == 0) {
+            originCX = newOriginCX; originCY = newOriginCY; originCZ = newOriginCZ;
+            return this;
+        }
+        if (newOriginCX == originCX && newOriginCY == originCY && newOriginCZ == originCZ) return this;
+        windowMoves++;
+        int[] next = new int[ids.length];
+        java.util.Arrays.fill(next, UNKNOWN);
+        int carried = 0;
+        for (int z = 0; z < sizeCZ; z++) {
+            int wz = originCZ + z;
+            int nz = wz - newOriginCZ;
+            if (nz < 0 || nz >= sizeCZ) continue;
+            for (int y = 0; y < sizeCY; y++) {
+                int wy = originCY + y;
+                int ny = wy - newOriginCY;
+                if (ny < 0 || ny >= sizeCY) continue;
+                for (int x = 0; x < sizeCX; x++) {
+                    int wx = originCX + x;
+                    int nx = wx - newOriginCX;
+                    if (nx < 0 || nx >= sizeCX) continue;
+                    int v = ids[idx(x, y, z)];
+                    next[idx(nx, ny, nz)] = v;
+                    if (v != UNKNOWN) carried++;
+                }
+            }
+        }
+        ids = next;
+        filledCells = carried;
+        originCX = newOriginCX; originCY = newOriginCY; originCZ = newOriginCZ;
+        bumpVersion();
+        return this;
+    }
+
+    public int idx(int x, int y, int z) { return (z * sizeCY + y) * sizeCX + x; }
+
+    public boolean inRange(int cx, int cy, int cz) {
+        if (ids.length == 0) return false;
+        int x = cx - originCX, y = cy - originCY, z = cz - originCZ;
+        return x >= 0 && y >= 0 && z >= 0 && x < sizeCX && y < sizeCY && z < sizeCZ;
+    }
+
+    public int worldToCellX(double wx) { return floorDiv((long) Math.floor(wx), cellSize); }
+    public int worldToCellY(double wy) { return floorDiv((long) Math.floor(wy), cellSize); }
+    public int worldToCellZ(double wz) { return floorDiv((long) Math.floor(wz), cellSize); }
+
+    private static int floorDiv(long a, long b) { return (int) Math.floorDiv(a, b); }
+
+    /** Id at a cell coordinate, or {@link #UNKNOWN} outside the window. */
+    public int idAtCell(int cx, int cy, int cz) {
+        if (!inRange(cx, cy, cz)) return UNKNOWN;
+        return ids[idx(cx - originCX, cy - originCY, cz - originCZ)];
+    }
+
+    /** Id at a world coordinate, or {@link #UNKNOWN} outside the window. */
+    public int idAtWorld(double wx, double wy, double wz) {
+        return idAtCell(worldToCellX(wx), worldToCellY(wy), worldToCellZ(wz));
+    }
+
+    public boolean setIdAtCell(int cx, int cy, int cz, int biomeId) {
+        if (!inRange(cx, cy, cz)) return false;
+        int i = idx(cx - originCX, cy - originCY, cz - originCZ);
+        if (ids[i] == biomeId) return false;
+        if (ids[i] == UNKNOWN && biomeId != UNKNOWN) filledCells++;
+        else if (ids[i] != UNKNOWN && biomeId == UNKNOWN) filledCells--;
+        ids[i] = biomeId;
+        totalWrites++;
+        bumpVersion();
+        return true;
+    }
+
+    public boolean setIdAtWorld(double wx, double wy, double wz, int biomeId) {
+        return setIdAtCell(worldToCellX(wx), worldToCellY(wy), worldToCellZ(wz), biomeId);
+    }
+
+    public int unknownCount() { return ids.length - filledCells; }
+
+    /** Raw backing array, for the packer. Never mutated by the packer. */
+    public int[] rawIds() { return ids; }
+
+    public void clear() {
+        java.util.Arrays.fill(ids, UNKNOWN);
+        filledCells = 0;
+        bumpVersion();
+    }
+
+    private void bumpVersion() { version++; }
+
+    @Override public String toString() {
+        return "BiomeField{cell=" + cellSize + ", window=" + sizeCX + "x" + sizeCY + "x" + sizeCZ
+                + ", origin=(" + originCX + "," + originCY + "," + originCZ + ")"
+                + ", filled=" + filledCells + "/" + ids.length + ", v" + version + "}";
+    }
+}
diff --git a/core/src/main/java/dev/auralite/render/biome/BiomeFieldBuilder.java b/core/src/main/java/dev/auralite/render/biome/BiomeFieldBuilder.java
new file mode 100644
index 0000000..34009fd
--- /dev/null
+++ b/core/src/main/java/dev/auralite/render/biome/BiomeFieldBuilder.java
@@ -0,0 +1,211 @@
+package dev.auralite.render.biome;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Keeps a {@link BiomeField} in step with the chunks the client has loaded.
+ *
+ * <p>Ingest is one 4x4x4x4 = 64-cell block per chunk section, which is exactly
+ * Minecraft's biome container granularity, so nothing is resampled and no
+ * information is lost. The window follows the camera in whole cells and
+ * carries its contents across the move, so walking in a straight line costs
+ * one new slice of cells per 4 blocks rather than a full re-ingest.
+ */
+public final class BiomeFieldBuilder {
+
+    /** One chunk section's biomes: 4x4x4 cells covering 16x16x16 blocks. */
+    public static final class SectionBiomes {
+        public int chunkX, chunkZ, sectionY;
+        /** 64 ids, indexed {@code (y * 4 + z) * 4 + x} in cell space. */
+        public final int[] cellIds = new int[64];
+        /** Ids are palette-resolved by the caller; -1 means "not loaded yet". */
+        public boolean valid;
+
+        public SectionBiomes(int chunkX, int sectionY, int chunkZ) {
+            this.chunkX = chunkX; this.sectionY = sectionY; this.chunkZ = chunkZ;
+            java.util.Arrays.fill(cellIds, BiomeField.UNKNOWN);
+        }
+
+        public void set(int x, int y, int z, int id) { cellIds[(y * 4 + z) * 4 + x] = id; }
+        public int get(int x, int y, int z) { return cellIds[(y * 4 + z) * 4 + x]; }
+        public void fill(int id) { java.util.Arrays.fill(cellIds, id); }
+
+        public long key() {
+            // 21 bits per axis is plenty for any world, and keeps the key unique.
+            return (((long) chunkX & 0x1FFFFF) << 42) | (((long) sectionY & 0xFFFFF) << 21)
+                    | ((long) chunkZ & 0x1FFFFF);
+        }
+    }
+
+    private final BiomeField field;
+    private final Map<Long, SectionBiomes> ingested = new HashMap<Long, SectionBiomes>();
+    private final List<DirtyRegion> dirty = new ArrayList<DirtyRegion>();
+    private int verticalMinSection = -16;
+    private int verticalMaxSection = 20;
+    private long ingestedSections;
+    private long rejectedSections;
+    private long carriedCells;
+
+    public BiomeFieldBuilder(BiomeField field) { this.field = field; }
+
+    public BiomeField field() { return field; }
+    public long ingestedSections() { return ingestedSections; }
+    public long rejectedSections() { return rejectedSections; }
+    public long carriedCells() { return carriedCells; }
+    public int cachedSectionCount() { return ingested.size(); }
+
+    public BiomeFieldBuilder verticalRange(int minSection, int maxSection) {
+        this.verticalMinSection = minSection;
+        this.verticalMaxSection = maxSection;
+        return this;
+    }
+
+    /**
+     * Sizes the window for a render distance.
+     *
+     * <p>Horizontally: {@code (2 * radius + 1)} chunks, one extra cell of margin
+     * so a sample on the window edge still has all eight corners inside.
+     * Vertically: the configured section range.
+     */
+    public BiomeFieldBuilder sizeForRenderDistance(int radiusChunks, int minHeight, int maxHeight) {
+        int cell = field.cellSize();
+        int blocksAcross = (2 * radiusChunks + 1) * 16 + 2 * cell;
+        int cx = blocksAcross / cell + 1;
+        int cy = Math.max(1, (maxHeight - minHeight) / cell + 1);
+        int cz = cx;
+        field.allocate(cx, cy, cz);
+        verticalMinSection = minHeight / 16;
+        verticalMaxSection = maxHeight / 16;
+        return this;
+    }
+
+    /** Recentres the window on a camera position, carrying whatever still fits. */
+    public void recentre(double camX, double camY, double camZ) {
+        int cell = field.cellSize();
+        int halfX = field.sizeCX() / 2, halfY = field.sizeCY() / 2, halfZ = field.sizeCZ() / 2;
+        int ccx = (int) Math.floorDiv((long) Math.floor(camX), cell) - halfX;
+        int ccy = (int) Math.floorDiv((long) Math.floor(camY), cell) - halfY;
+        int ccz = (int) Math.floorDiv((long) Math.floor(camZ), cell) - halfZ;
+        if (ccx == field.originCX() && ccy == field.originCY() && ccz == field.originCZ()) return;
+        int before = field.filledCells();
+        field.moveWindowTo(ccx, ccy, ccz);
+        carriedCells += field.filledCells() < before ? field.filledCells() : before;
+        // Everything that survived the move is, by definition, unchanged; only the
+        // newly exposed slice needs an upload, so mark the whole window dirty and
+        // let coalescing reduce it to one box.
+        dirty.add(new DirtyRegion(field.originCX(), field.originCY(), field.originCZ(),
+                field.sizeCX(), field.sizeCY(), field.sizeCZ()));
+    }
+
+    /** Ingests one chunk section. Returns false when it fell outside the window. */
+    public boolean ingest(SectionBiomes section) {
+        if (!section.valid) { rejectedSections++; return false; }
+        if (section.sectionY < verticalMinSection || section.sectionY > verticalMaxSection) {
+            rejectedSections++;
+            return false;
+        }
+        // A section whose cells all fall outside the window is not "accepted with
+        // no effect": it is rejected, and it is not cached, or the cache fills
+        // with data the field can never use and the receipt overstates progress.
+        int baseCX = section.chunkX * 4, baseCZ = section.chunkZ * 4, baseCY = section.sectionY * 4;
+        boolean intersects = field.inRange(baseCX, baseCY, baseCZ)
+                || field.inRange(baseCX + 3, baseCY + 3, baseCZ + 3)
+                || field.inRange(baseCX + 3, baseCY, baseCZ)
+                || field.inRange(baseCX, baseCY + 3, baseCZ + 3);
+        if (!intersects) {
+            rejectedSections++;
+            return false;
+        }
+        ingested.put(section.key(), section);
+        ingestedSections++;
+
+        int cell = field.cellSize();
+        if (cell != 4) {
+            // Non-4 cell sizes are a debugging configuration; resample by nearest cell.
+            return ingestResampled(section);
+        }
+
+        boolean any = false;
+        for (int y = 0; y < 4; y++) {
+            for (int z = 0; z < 4; z++) {
+                for (int x = 0; x < 4; x++) {
+                    int id = section.get(x, y, z);
+                    if (field.setIdAtCell(baseCX + x, baseCY + y, baseCZ + z, id)) any = true;
+                }
+            }
+        }
+        if (any) {
+            int minX = baseCX - field.originCX(), minY = baseCY - field.originCY(), minZ = baseCZ - field.originCZ();
+            dirty.add(new DirtyRegion(
+                    Math.max(0, minX), Math.max(0, minY), Math.max(0, minZ),
+                    Math.min(4, field.sizeCX() - Math.max(0, minX)),
+                    Math.min(4, field.sizeCY() - Math.max(0, minY)),
+                    Math.min(4, field.sizeCZ() - Math.max(0, minZ))));
+        }
+        return any;
+    }
+
+    private boolean ingestResampled(SectionBiomes section) {
+        boolean any = false;
+        for (int by = 0; by < 16; by++) {
+            for (int bz = 0; bz < 16; bz++) {
+                for (int bx = 0; bx < 16; bx++) {
+                    int wx = section.chunkX * 16 + bx;
+                    int wy = section.sectionY * 16 + by;
+                    int wz = section.chunkZ * 16 + bz;
+                    int id = section.get(bx >> 2, by >> 2, bz >> 2);
+                    if (field.setIdAtWorld(wx, wy, wz, id)) any = true;
+                }
+            }
+        }
+        if (any) {
+            dirty.add(new DirtyRegion(field.originCX(), field.originCY(), field.originCZ(),
+                    field.sizeCX(), field.sizeCY(), field.sizeCZ()));
+        }
+        return any;
+    }
+
+    /** Forgets sections outside the current window so the cache cannot grow forever. */
+    public int evictOutsideWindow() {
+        List<Long> dead = new ArrayList<Long>();
+        for (Map.Entry<Long, SectionBiomes> e : ingested.entrySet()) {
+            SectionBiomes s = e.getValue();
+            int baseCX = s.chunkX * 4, baseCZ = s.chunkZ * 4, baseCY = s.sectionY * 4;
+            boolean inside = field.inRange(baseCX, baseCY, baseCZ)
+                    || field.inRange(baseCX + 3, baseCY + 3, baseCZ + 3);
+            if (!inside) dead.add(e.getKey());
+        }
+        for (Long k : dead) ingested.remove(k);
+        return dead.size();
+    }
+
+    /** Re-ingests everything cached after a window resize. */
+    public int replayCache() {
+        int n = 0;
+        for (SectionBiomes s : new ArrayList<SectionBiomes>(ingested.values())) {
+            if (ingest(s)) n++;
+        }
+        return n;
+    }
+
+    public int pendingDirtyCount() { return dirty.size(); }
+
+    /** Returns at most {@code budget} coalesced regions and clears the pending list. */
+    public List<DirtyRegion> drainDirty(int budget, int gap) {
+        List<DirtyRegion> out = DirtyRegion.coalesce(dirty, budget, gap);
+        dirty.clear();
+        return out;
+    }
+
+    public void clearDirty() { dirty.clear(); }
+
+    public String receipt() {
+        return "biome ingest: " + ingestedSections + " sections accepted, "
+                + rejectedSections + " rejected, " + ingested.size() + " cached, "
+                + field.filledCells() + "/" + field.cellCapacity() + " cells filled, "
+                + field.windowMoves() + " window moves";
+    }
+}
diff --git a/core/src/main/java/dev/auralite/render/biome/BiomeFieldPacker.java b/core/src/main/java/dev/auralite/render/biome/BiomeFieldPacker.java
new file mode 100644
index 0000000..124f3f1
--- /dev/null
+++ b/core/src/main/java/dev/auralite/render/biome/BiomeFieldPacker.java
@@ -0,0 +1,150 @@
+package dev.auralite.render.biome;
+
+import dev.auralite.render.rhi.GfxFormat;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Packs a {@link BiomeField} into GPU-uploadable texels.
+ *
+ * <p>Two layouts, because they trade different things:
+ *
+ * <ul>
+ * <li>{@link Layout#ID_R32UI} -- one 32-bit id per cell. Exact, supports any
+ *     id a modded registry can produce, and the shader does its own trilinear
+ *     blend from eight fetches plus eight LUT fetches.</li>
+ * <li>{@link Layout#TOPK_RGBA8UI} -- the four most likely ids per cell plus a
+ *     matching RGBA8 weight texture. One fetch instead of eight and a quarter
+ *     of the bandwidth, at the cost of pre-resolving the blend on the CPU and
+ *     of a hard ceiling of 254 biome ids. The packer refuses this layout with
+ *     a named reason rather than silently truncating ids.</li>
+ * </ul>
+ */
+public final class BiomeFieldPacker {
+
+    public enum Layout { ID_R32UI, TOPK_RGBA8UI }
+
+    /** Sentinel written for a cell that has never been ingested. */
+    public static final int UNKNOWN_TEXEL = 0xFFFFFFFF;
+    public static final int UNKNOWN_TOPK = 255;
+    public static final int MAX_TOPK_IDS = 254;
+
+    private final BiomeField field;
+    private final Layout layout;
+    private final BiomeSampler sampler;
+
+    public BiomeFieldPacker(BiomeField field, Layout layout, BiomeRegistry registry) {
+        this.field = field;
+        this.layout = layout;
+        this.sampler = layout == Layout.TOPK_RGBA8UI ? new BiomeSampler(field, registry) : null;
+        if (layout == Layout.TOPK_RGBA8UI && registry.highestId() > MAX_TOPK_IDS) {
+            throw new IllegalArgumentException("TOPK_RGBA8UI cannot represent biome id "
+                    + registry.highestId() + "; the layout stores ids in one byte (max "
+                    + MAX_TOPK_IDS + "). Use ID_R32UI or split the registry.");
+        }
+    }
+
+    public Layout layout() { return layout; }
+    public int width() { return field.sizeCX(); }
+    public int height() { return field.sizeCY(); }
+    public int depth() { return field.sizeCZ(); }
+
+    public GfxFormat idFormat() {
+        return layout == Layout.ID_R32UI ? GfxFormat.R32_UINT : GfxFormat.RGBA8_UINT;
+    }
+
+    public long idBytes() {
+        int per = layout == Layout.ID_R32UI ? 4 : 4;   // R32UI = 4 B, RGBA8UI = 4 B
+        return (long) field.cellCapacity() * per;
+    }
+
+    /** Bytes for the TOPK weight texture, 0 for the R32UI layout. */
+    public long weightBytes() {
+        return layout == Layout.TOPK_RGBA8UI ? (long) field.cellCapacity() * 4 : 0;
+    }
+
+    /** Packs the whole field. {@code out} must be at least {@link #idBytes()} long. */
+    public void packIds(int[] out) {
+        int[] ids = field.rawIds();
+        if (out.length < ids.length) {
+            throw new IllegalArgumentException("output holds " + out.length + " cells, field has " + ids.length);
+        }
+        if (layout == Layout.ID_R32UI) {
+            for (int i = 0; i < ids.length; i++) out[i] = ids[i] == BiomeField.UNKNOWN ? UNKNOWN_TEXEL : ids[i];
+        } else {
+            for (int i = 0; i < ids.length; i++) {
+                int x = i % field.sizeCX();
+                int y = (i / field.sizeCX()) % field.sizeCY();
+                int z = i / (field.sizeCX() * field.sizeCY());
+                BiomeSample s = sampler.sampleCellCentre(field.originCX() + x,
+                        field.originCY() + y, field.originCZ() + z);
+                int packed = 0;
+                for (int k = 0; k < BiomeSample.MAX_ENTRIES; k++) {
+                    int id = k < s.count ? s.ids[k] : UNKNOWN_TOPK;
+                    if (id < 0 || id > MAX_TOPK_IDS) id = UNKNOWN_TOPK;
+                    packed |= (id & 0xFF) << (k * 8);
+                }
+                out[i] = packed;
+            }
+        }
+    }
+
+    /** Packs the TOPK weights as bytes summing to 255, or fills with 0 for R32UI. */
+    public void packWeights(int[] out) {
+        int[] ids = field.rawIds();
+        if (layout != Layout.TOPK_RGBA8UI) {
+            for (int i = 0; i < ids.length; i++) out[i] = 0;
+            return;
+        }
+        for (int i = 0; i < ids.length; i++) {
+            int x = i % field.sizeCX();
+            int y = (i / field.sizeCX()) % field.sizeCY();
+            int z = i / (field.sizeCX() * field.sizeCY());
+            BiomeSample s = sampler.sampleCellCentre(field.originCX() + x,
+                    field.originCY() + y, field.originCZ() + z);
+            int packed = 0;
+            int assigned = 0;
+            for (int k = 0; k < BiomeSample.MAX_ENTRIES; k++) {
+                int q = k < s.count ? Math.round(s.weights[k] * 255f) : 0;
+                if (k < s.count - 1) assigned += q;
+                else if (k < s.count) q = Math.max(0, 255 - assigned);   // last one takes the remainder
+                packed |= (q & 0xFF) << (k * 8);
+            }
+            out[i] = packed;
+        }
+    }
+
+    /**
+     * Clips a dirty region to the field and returns the sub-box to upload.
+     * Regions entirely outside produce nothing, which is what keeps a chunk
+     * load on the far side of the window from touching the GPU at all.
+     */
+    public List<int[]> subImageBoxes(List<DirtyRegion> regions) {
+        List<int[]> out = new ArrayList<int[]>();
+        for (DirtyRegion r : regions) {
+            int minX = Math.max(r.minX - field.originCX(), 0);
+            int minY = Math.max(r.minY - field.originCY(), 0);
+            int minZ = Math.max(r.minZ - field.originCZ(), 0);
+            int maxX = Math.min(r.maxX() - field.originCX(), field.sizeCX());
+            int maxY = Math.min(r.maxY() - field.originCY(), field.sizeCY());
+            int maxZ = Math.min(r.maxZ() - field.originCZ(), field.sizeCZ());
+            if (maxX <= minX || maxY <= minY || maxZ <= minZ) continue;
+            out.add(new int[] { minX, minY, minZ, maxX - minX, maxY - minY, maxZ - minZ });
+        }
+        return out;
+    }
+
+    /** Upload statistics for the receipts. */
+    public long bytesForBoxes(List<int[]> boxes) {
+        long cells = 0;
+        for (int[] b : boxes) cells += (long) b[3] * b[4] * b[5];
+        return cells * (layout == Layout.ID_R32UI ? 4 : 8);   // TOPK uploads ids + weights
+    }
+
+    public String receipt() {
+        return "biome packer: " + layout + " " + width() + "x" + height() + "x" + depth()
+                + " (" + idBytes() + " B ids" + (weightBytes() > 0 ? " + " + weightBytes() + " B weights" : "")
+                + ")";
+    }
+}
diff --git a/core/src/main/java/dev/auralite/render/biome/BiomeLut.java b/core/src/main/java/dev/auralite/render/biome/BiomeLut.java
new file mode 100644
index 0000000..d9c8774
--- /dev/null
+++ b/core/src/main/java/dev/auralite/render/biome/BiomeLut.java
@@ -0,0 +1,90 @@
+package dev.auralite.render.biome;
+
+import dev.auralite.render.rhi.GfxFormat;
+
+/**
+ * The biome property lookup table, as a 2D texture.
+ *
+ * <p>One texel column per biome id, five RGBA32F rows. The shader fetches a
+ * row by biome id and gets the property without any CPU involvement, which is
+ * what makes per-pixel multi-biome blending affordable: eight id fetches from
+ * the field plus eight LUT fetches, no branching, no uniform re-upload.
+ *
+ * <pre>
+ * row 0  WATER_COLOR      rgb = linear water colour          a = 1.0
+ * row 1  WATER_FOG_COLOR  rgb = linear water fog colour      a = fogDensityScale
+ * row 2  FOLIAGE_COLOR    rgb = linear foliage tint          a = temperature
+ * row 3  GRASS_COLOR      rgb = linear grass tint            a = downfall
+ * row 4  META             r = biome id, g = category, b = precipitation, a = cloudCoverageScale
+ * </pre>
+ *
+ * The layout is fixed and versioned: {@link #LAYOUT_VERSION} goes up if a row
+ * changes meaning, and the native pack format refuses a pack built against a
+ * different one.
+ */
+public final class BiomeLut {
+    public static final int LAYOUT_VERSION = 1;
+    public static final int ROW_WATER_COLOR = 0;
+    public static final int ROW_WATER_FOG = 1;
+    public static final int ROW_FOLIAGE = 2;
+    public static final int ROW_GRASS = 3;
+    public static final int ROW_META = 4;
+    public static final int ROWS = 5;
+    public static final GfxFormat FORMAT = GfxFormat.RGBA32F;
+
+    private final int width;
+    private final float[] texels;
+
+    private BiomeLut(int width, float[] texels) {
+        this.width = width;
+        this.texels = texels;
+    }
+
+    /** Builds the LUT for a registry, padded to a power-of-two width. */
+    public static BiomeLut build(BiomeRegistry registry) {
+        int needed = Math.max(1, registry.highestId() + 1);
+        int w = 1;
+        while (w < needed) w <<= 1;
+        float[] t = new float[w * ROWS * 4];
+        BiomeRecord fallback = registry.fallback();
+        for (int id = 0; id < w; id++) {
+            BiomeRecord r = registry.byId(id);
+            if (r == null) r = fallback;
+            if (r == null) continue;
+            put(t, w, id, ROW_WATER_COLOR, r.waterColor[0], r.waterColor[1], r.waterColor[2], 1.0f);
+            put(t, w, id, ROW_WATER_FOG, r.waterFogColor[0], r.waterFogColor[1], r.waterFogColor[2], r.fogDensityScale);
+            put(t, w, id, ROW_FOLIAGE, r.foliageColor[0], r.foliageColor[1], r.foliageColor[2], r.temperature);
+            put(t, w, id, ROW_GRASS, r.grassColor[0], r.grassColor[1], r.grassColor[2], r.downfall);
+            put(t, w, id, ROW_META, r.id, r.category.id(), r.precipitation.id(), r.cloudCoverageScale);
+        }
+        return new BiomeLut(w, t);
+    }
+
+    private static void put(float[] t, int w, int x, int row, float r, float g, float b, float a) {
+        int base = (row * w + x) * 4;
+        t[base] = r; t[base + 1] = g; t[base + 2] = b; t[base + 3] = a;
+    }
+
+    public int width() { return width; }
+    public int height() { return ROWS; }
+    public int texelCount() { return width * ROWS; }
+    public GfxFormat format() { return FORMAT; }
+    public long sizeBytes() { return (long) texels.length * 4; }
+
+    /** Row-major RGBA floats, ready for an upload. Not a copy: treat as read-only. */
+    public float[] texels() { return texels; }
+
+    /** Reads one component back; used by the gates instead of poking the array. */
+    public float get(int id, int row, int component) {
+        if (id < 0 || id >= width) return 0f;
+        return texels[(row * width + id) * 4 + component];
+    }
+
+    public float[] readColor(int id, int row) {
+        return new float[] { get(id, row, 0), get(id, row, 1), get(id, row, 2) };
+    }
+
+    @Override public String toString() {
+        return "BiomeLut{" + width + "x" + ROWS + " RGBA32F, " + sizeBytes() + " B, layout v" + LAYOUT_VERSION + "}";
+    }
+}
