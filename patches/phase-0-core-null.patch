diff --git a/Makefile b/Makefile
new file mode 100644
index 0000000..6c28921
--- /dev/null
+++ b/Makefile
@@ -0,0 +1,88 @@
+# AuraLite-Render host build: Java 11, no Gradle, no IDE.
+# The only network access is `make deps`, which fetches the LWJGL jars used to
+# compile-verify the GL and Vulkan backends. Everything else works offline.
+.RECIPEPREFIX = >
+
+JAVAC ?= javac
+JAVA ?= java
+
+LWJGL_VERSION = 3.4.3
+MAVEN = https://repo1.maven.org/maven2/org/lwjgl
+THIRD_PARTY = third_party
+LWJGL_JARS = $(THIRD_PARTY)/lwjgl.jar $(THIRD_PARTY)/lwjgl-opengl.jar $(THIRD_PARTY)/lwjgl-vulkan.jar
+
+BUILD = build
+CORE_CLASSES = $(BUILD)/core
+NULL_CLASSES = $(BUILD)/null
+GL_CLASSES = $(BUILD)/gl
+VK_CLASSES = $(BUILD)/vk
+TEST_CLASSES = $(BUILD)/tests
+
+.PHONY: all deps build test bench clean help
+
+all: build
+
+help:
+> @echo "targets: deps build test bench clean"
+> @echo "  deps  - fetch LWJGL $(LWJGL_VERSION) jars into third_party/ (gitignored, never committed)"
+> @echo "  build - compile core, backend-null, backend-gl, backend-vulkan, tests"
+> @echo "  test  - build, then run all six host gates (must end RESULT: PASS)"
+> @echo "  bench - build, then run the gates 5x and show the timing lines"
+
+deps: $(LWJGL_JARS)
+> @echo "GL46 present: $$(unzip -l $(THIRD_PARTY)/lwjgl-opengl.jar | grep -c 'GL46.class') class(es)"
+> @echo "VK13 present: $$(unzip -l $(THIRD_PARTY)/lwjgl-vulkan.jar | grep -c 'VK13.class') class(es)"
+
+$(THIRD_PARTY)/lwjgl.jar:
+> @mkdir -p $(THIRD_PARTY)
+> curl -sSL -o $@ $(MAVEN)/lwjgl/$(LWJGL_VERSION)/lwjgl-$(LWJGL_VERSION).jar
+
+$(THIRD_PARTY)/lwjgl-opengl.jar:
+> @mkdir -p $(THIRD_PARTY)
+> curl -sSL -o $@ $(MAVEN)/lwjgl-opengl/$(LWJGL_VERSION)/lwjgl-opengl-$(LWJGL_VERSION).jar
+
+$(THIRD_PARTY)/lwjgl-vulkan.jar:
+> @mkdir -p $(THIRD_PARTY)
+> curl -sSL -o $@ $(MAVEN)/lwjgl-vulkan/$(LWJGL_VERSION)/lwjgl-vulkan-$(LWJGL_VERSION).jar
+
+build: deps
+> @mkdir -p $(CORE_CLASSES) $(NULL_CLASSES) $(GL_CLASSES) $(VK_CLASSES) $(TEST_CLASSES)
+> @echo "--- core (java 11, no dependencies) ---"
+> find core/src -name '*.java' | sort > $(BUILD)/core-sources.txt
+> $(JAVAC) -Xlint:-options -d $(CORE_CLASSES) @$(BUILD)/core-sources.txt
+> @echo "--- backend-null ---"
+> find backend-null/src -name '*.java' | sort > $(BUILD)/null-sources.txt
+> $(JAVAC) -cp $(CORE_CLASSES) -d $(NULL_CLASSES) @$(BUILD)/null-sources.txt
+> @echo "--- backend-gl (against third_party jars) ---"
+> @if [ -n "$$(find backend-gl/src -name '*.java' 2>/dev/null)" ]; then \
+      find backend-gl/src -name '*.java' | sort > $(BUILD)/gl-sources.txt; \
+      $(JAVAC) -cp $(CORE_CLASSES):$(THIRD_PARTY)/lwjgl.jar:$(THIRD_PARTY)/lwjgl-opengl.jar \
+        -d $(GL_CLASSES) @$(BUILD)/gl-sources.txt; \
+    else echo "backend-gl: no sources yet, SKIP"; fi
+> @echo "--- backend-vulkan (against third_party jars) ---"
+> @if [ -n "$$(find backend-vulkan/src -name '*.java' 2>/dev/null)" ]; then \
+      find backend-vulkan/src -name '*.java' | sort > $(BUILD)/vk-sources.txt; \
+      $(JAVAC) -cp $(CORE_CLASSES):$(THIRD_PARTY)/lwjgl.jar:$(THIRD_PARTY)/lwjgl-vulkan.jar \
+        -d $(VK_CLASSES) @$(BUILD)/vk-sources.txt; \
+    else echo "backend-vulkan: no sources yet, SKIP"; fi
+> @echo "--- tests ---"
+> find tests/src -name '*.java' | sort > $(BUILD)/tests-sources.txt
+> $(JAVAC) -cp $(CORE_CLASSES):$(NULL_CLASSES):$(GL_CLASSES):$(VK_CLASSES) \
+      -d $(TEST_CLASSES) @$(BUILD)/tests-sources.txt
+> @echo "build: OK"
+
+# The runtime classpath deliberately omits third_party: the mapping tables are
+# pure data and must load with no LWJGL present. A NoClassDefFoundError in the
+# tables suite means a real GL/VK call leaked into a mapping function.
+test: build
+> $(JAVA) -cp $(CORE_CLASSES):$(NULL_CLASSES):$(GL_CLASSES):$(VK_CLASSES):$(TEST_CLASSES) \
+      dev.auralite.render.tests.RunAll
+
+bench: build
+> @for i in 1 2 3 4 5; do \
+      $(JAVA) -cp $(CORE_CLASSES):$(NULL_CLASSES):$(GL_CLASSES):$(VK_CLASSES):$(TEST_CLASSES) \
+        dev.auralite.render.tests.RunAll --receipts 2>&1 | grep -E '^(TOTAL|RESULT)'; \
+    done
+
+clean:
+> rm -rf $(BUILD)
diff --git a/README.md b/README.md
new file mode 100644
index 0000000..5d90d40
--- /dev/null
+++ b/README.md
@@ -0,0 +1,71 @@
+# AuraLite-Render
+
+A renderer-agnostic core, two real backends, and a shader-pack format with two
+modes — legacy-compatible and new native. Built for the AuraLite stack
+(AuraLite-OS, Emulator), usable without it.
+
+Every number in this repo is measured by `make test`, not estimated.
+See [docs/STATUS.md](docs/STATUS.md) for the receipts.
+
+## Layout
+
+```
+core/            RHI, render graph, scene, uniforms, biomes, pack loader (Java 11)
+backend-null/    recording + fail-fast reference device (Java 11)
+backend-gl/      OpenGL 4.6 device (Java 11, LWJGL, compile-verified)
+backend-vulkan/  Vulkan 1.3 device (Java 11, LWJGL, compile-verified)
+fabric/          mod glue: Java 21 + Gradle/Loom (sources + json; build SKIPs here)
+packs/           AuraLite-Native reference pack
+tests/           7 suites, one `RunAll`, no GPU required
+tools/           packlint, drift-check
+docs/            STATUS, ROADMAP, api/, plans/
+third_party/     gitignored LWJGL 3.4.3, fetched by `make deps` (compile-only)
+```
+
+## Build
+
+```
+make deps    # fetch LWJGL 3.4.3 into third_party/ (~11 MB)
+make test    # build everything, run 7 suites
+make bench   # run the perf gates 5x
+```
+
+Host rule: everything except `fabric/` stays Java 11 source-compatible, so
+`make test` is genuinely green on OpenJDK 11. `fabric/` is the documented
+exception — it needs a JDK 21 lane this sandbox does not have.
+
+Current state: **967 passed, 0 failed, 2 negative controls, 7/7 suites green**,
+both backends compile `rc=0` against real LWJGL sources.
+
+## The two modes
+
+- **LEGACY_IRIS** reads an OptiFine/Iris pack exactly as shipped:
+  `shaders.properties`, filename-derived program names, scalar custom uniforms.
+  AuraLite-Shaders, Complementary and BSL keep working on day one.
+- **NATIVE** reads `pack.aurapack`: an explicit resource table, a declared
+  render-graph DAG, compute passes, a required-capability list, a versioned
+  API level. Nothing is inferred from filenames.
+
+A directory containing both loads as NATIVE; the decision goes into the load
+report instead of happening silently. Format authority:
+[docs/api/PACK_FORMAT.md](docs/api/PACK_FORMAT.md).
+
+## Docs
+
+- [docs/STATUS.md](docs/STATUS.md) — what is done, with receipts
+- [docs/ROADMAP.md](docs/ROADMAP.md) — phases and lanes
+- [docs/plans/BIG_PLAN.md](docs/plans/BIG_PLAN.md) — the whole endeavour,
+  and where it plugs into AuraLite-OS and the Emulator
+- [docs/api/RHI.md](docs/api/RHI.md) — the device contract both backends keep
+- [docs/api/PACK_FORMAT.md](docs/api/PACK_FORMAT.md) — the pack grammar
+
+## Standing rules
+
+1. Receipts, not adjectives. A claim without a suite line is a rumour.
+2. Every refusal names its offender. `GfxException` always says which backend,
+   which call, and what was wrong.
+3. The NULL backend is the spec. If GL and VK disagree, the recording device
+   settles it.
+4. No GPU in the sandbox, so backends are compile-verified here and
+   behaviour-verified where a GPU exists. Never claim a frame was rendered
+   until one has been.
diff --git a/backend-null/src/main/java/dev/auralite/render/backend/nulldev/NullDevice.java b/backend-null/src/main/java/dev/auralite/render/backend/nulldev/NullDevice.java
