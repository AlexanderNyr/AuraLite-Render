+    }
+
+    private void seed(String key, String constant, BiomeCategory cat, BiomePrecipitation ppt,
+                      float temp, float downfall, float[] water, float[] waterFog) {
+        BiomeRecord rec = new BiomeRecord(byId.size(), key, constant, cat, ppt, temp, downfall, water);
+        rec.fog(waterFog);
+        add(rec);
+    }
+
+    /** Appends a record, assigning the next id when it does not carry one. */
+    public BiomeRecord add(BiomeRecord record) {
+        int id = record.id < 0 ? byId.size() : record.id;
+        if (id >= capacity) {
+            throw new IllegalStateException("biome id " + id + " exceeds registry capacity " + capacity
+                    + "; raise BiomeRegistry.capacity before seeding");
+        }
+        while (byId.size() < id) byId.add(null);
+        if (id == byId.size()) byId.add(record);
+        else byId.set(id, record);
+        byConstant.put(record.constantName, record);
+        byKey.put(record.registryKey, record);
+        return record;
+    }
+
+    public BiomeRecord byId(int id) {
+        if (id < 0 || id >= byId.size()) return null;
+        return byId.get(id);
+    }
+
+    public BiomeRecord byConstant(String constant) { return byConstant.get(constant); }
+    public BiomeRecord byKey(String registryKey) { return byKey.get(registryKey); }
+
+    /** Resolves a {@code BIOME_*} constant to its integer id, -1 when unknown. */
+    public int constantId(String constant) {
+        BiomeRecord r = byConstant.get(constant);
+        return r == null ? -1 : r.id;
+    }
+
+    public int count() {
+        int n = 0;
+        for (BiomeRecord r : byId) if (r != null) n++;
+        return n;
+    }
+
+    public int highestId() { return byId.size() - 1; }
+    public int capacity() { return capacity; }
+    public BiomeRegistry capacity(int c) { this.capacity = Math.max(byId.size(), c); return this; }
+
+    public List<BiomeRecord> records() {
+        List<BiomeRecord> out = new ArrayList<BiomeRecord>();
+        for (BiomeRecord r : byId) if (r != null) out.add(r);
+        return Collections.unmodifiableList(out);
+    }
+
+    /**
+     * Binds every {@code BIOME_*}, {@code CAT_*} and {@code PPT_*} constant into
+     * an expression environment.
+     *
+     * <p>Iris predefines these for custom-uniform expressions; a LEGACY pack
+     * that writes {@code in(biome, BIOME_SWAMP)} cannot be evaluated without
+     * them, and evaluating it is what makes the baked biome field possible.
+     */
+    public int bindConstants(dev.auralite.render.uniform.ExprEnv env) {
+        int n = 0;
+        for (BiomeRecord r : byId) {
+            if (r == null) continue;
+            env.bindInt(r.constantName, r.id);
+            n++;
+        }
+        for (BiomeCategory c : BiomeCategory.values()) { env.bindInt(c.name(), c.id()); n++; }
+        for (BiomePrecipitation p : BiomePrecipitation.values()) { env.bindInt(p.name(), p.id()); n++; }
+        return n;
+    }
+
+    /** Fallback used when a cell holds an id this registry has never seen. */
+    public BiomeRecord fallback() {
+        BiomeRecord r = byConstant.get("BIOME_PLAINS");
+        return r != null ? r : (byId.isEmpty() ? null : byId.get(0));
+    }
+}
diff --git a/core/src/main/java/dev/auralite/render/biome/BiomeSample.java b/core/src/main/java/dev/auralite/render/biome/BiomeSample.java
new file mode 100644
index 0000000..c421b46
--- /dev/null
+++ b/core/src/main/java/dev/auralite/render/biome/BiomeSample.java
@@ -0,0 +1,125 @@
+package dev.auralite.render.biome;
+
+import java.util.Arrays;
+
+/**
+ * The answer to "which biome is here?" -- up to N biomes and their weights.
+ *
+ * <p>This is the type Iris has no equivalent of. Its {@code biome} uniform is
+ * one int; this is a sorted, normalised weight vector, so a fragment on a
+ * swamp/beach border carries both and the shader can blend water colour,
+ * fog and foliage across the seam instead of snapping.
+ */
+public final class BiomeSample {
+    /** How many contributors are exposed. Matches the vec4 the shader API uses. */
+    public static final int MAX_ENTRIES = 4;
+
+    public final int[] ids = new int[MAX_ENTRIES];
+    public final float[] weights = new float[MAX_ENTRIES];
+    public int count;
+    public final float worldX, worldY, worldZ;
+    private final BiomeRegistry registry;
+
+    public BiomeSample(BiomeRegistry registry, float worldX, float worldY, float worldZ) {
+        this.registry = registry;
+        this.worldX = worldX; this.worldY = worldY; this.worldZ = worldZ;
+        Arrays.fill(ids, -1);
+    }
+
+    public int dominantId() { return count > 0 ? ids[0] : -1; }
+    public float dominantWeight() { return count > 0 ? weights[0] : 0f; }
+    public BiomeRecord dominant() { return registry.byId(dominantId()); }
+
+    /** True when more than one biome contributes measurably. */
+    public boolean isMixed() {
+        return count > 1 && weights[1] > 0.02f;
+    }
+
+    public float weightOf(int biomeId) {
+        for (int i = 0; i < count; i++) if (ids[i] == biomeId) return weights[i];
+        return 0f;
+    }
+
+    /**
+     * Blends a property across the contributors.
+     *
+     * <p>Blendable properties are a weighted sum. Non-blendable ones (category,
+     * precipitation) come from the dominant contributor, because a weighted
+     * average of two labels is a third label that does not exist.
+     */
+    public float blend(BiomeProperty p) {
+        if (count == 0) {
+            BiomeRecord f = registry.fallback();
+            return f == null ? 0f : f.scalar(p);
+        }
+        if (!p.isBlendable()) {
+            BiomeRecord d = dominant();
+            return d == null ? 0f : d.scalar(p);
+        }
+        double sum = 0, wsum = 0;
+        for (int i = 0; i < count; i++) {
+            BiomeRecord r = registry.byId(ids[i]);
+            if (r == null) continue;
+            sum += r.scalar(p) * weights[i];
+            wsum += weights[i];
+        }
+        return wsum == 0 ? 0f : (float) (sum / wsum);
+    }
+
+    /** Blends a 3-component property into {@code out}; returns {@code out}. */
+    public float[] blend3(BiomeProperty p, float[] out) {
+        if (out == null || out.length < 3) out = new float[3];
+        if (count == 0) {
+            BiomeRecord f = registry.fallback();
+            if (f != null) System.arraycopy(f.property(p), 0, out, 0, 3);
+            return out;
+        }
+        out[0] = out[1] = out[2] = 0f;
+        double wsum = 0;
+        for (int i = 0; i < count; i++) {
+            BiomeRecord r = registry.byId(ids[i]);
+            if (r == null) continue;
+            float[] c = r.property(p);
+            if (c == null) continue;
+            out[0] += c[0] * weights[i];
+            out[1] += c[1] * weights[i];
+            out[2] += c[2] * weights[i];
+            wsum += weights[i];
+        }
+        if (wsum > 0) { out[0] /= wsum; out[1] /= wsum; out[2] /= wsum; }
+        return out;
+    }
+
+    public float[] waterColor() { return blend3(BiomeProperty.WATER_COLOR, new float[3]); }
+    public float[] waterFogColor() { return blend3(BiomeProperty.WATER_FOG_COLOR, new float[3]); }
+    public float[] foliageColor() { return blend3(BiomeProperty.FOLIAGE_COLOR, new float[3]); }
+    public float[] grassColor() { return blend3(BiomeProperty.GRASS_COLOR, new float[3]); }
+    public float temperature() { return blend(BiomeProperty.TEMPERATURE); }
+    public float downfall() { return blend(BiomeProperty.DOWNFALL); }
+
+    /** The vec4 a native pack reads: three dominant ids plus the residual weight. */
+    public float[] asIdsVec4() {
+        float[] v = new float[4];
+        for (int i = 0; i < 3 && i < count; i++) v[i] = ids[i];
+        v[3] = count > 3 ? weights[3] : 0f;
+        return v;
+    }
+
+    /** The vec4 a native pack reads: the weights, zero-padded. */
+    public float[] asWeightsVec4() {
+        float[] v = new float[4];
+        for (int i = 0; i < MAX_ENTRIES && i < count; i++) v[i] = weights[i];
+        return v;
+    }
+
+    @Override public String toString() {
+        StringBuilder sb = new StringBuilder("BiomeSample{");
+        for (int i = 0; i < count; i++) {
+            if (i > 0) sb.append(", ");
+            BiomeRecord r = registry.byId(ids[i]);
+            sb.append(r == null ? ("#" + ids[i]) : r.constantName).append('=').append(weights[i]);
+        }
+        return sb.append(" @ ").append(worldX).append(',').append(worldY).append(',').append(worldZ)
+                .append('}').toString();
+    }
+}
diff --git a/core/src/main/java/dev/auralite/render/biome/BiomeSampler.java b/core/src/main/java/dev/auralite/render/biome/BiomeSampler.java
new file mode 100644
index 0000000..2ec161b
--- /dev/null
+++ b/core/src/main/java/dev/auralite/render/biome/BiomeSampler.java
@@ -0,0 +1,123 @@
+package dev.auralite.render.biome;
+
+/**
+ * Turns a world position into a {@link BiomeSample}.
+ *
+ * <p>Trilinear interpolation over the eight cells surrounding the position,
+ * with cell centres at {@code cellIndex + 0.5}. Duplicate ids are merged, the
+ * contributors are sorted by weight and the top {@link BiomeSample#MAX_ENTRIES}
+ * are kept and renormalised, so the weights always sum to 1 and the dominant
+ * biome is always entry 0.
+ *
+ * <p>Cells that were never ingested contribute nothing; when all eight are
+ * unknown the sample is empty and callers fall back to the registry default
+ * rather than inventing a biome.
+ *
+ * <p><b>Seam width is exactly one biome cell (4 blocks) and that is a
+ * structural fact, not a tunable.</b> Trilinear interpolation consults the two
+ * cells either side of the position on each axis, so a position more than one
+ * cell from a border cannot see it. An earlier revision carried a
+ * {@code blendRadius} knob that appeared to widen the seam; measurement showed
+ * it only reweighted the same eight corners and never reached a further cell,
+ * so it was removed rather than left as a control that lies. Widening a seam is
+ * done where it is cheap -- a compute-pass blur over the baked property volume
+ * (BIOME_PLAN B5) -- not by widening a per-fragment CPU kernel.
+ */
+public final class BiomeSampler {
+    private final BiomeField field;
+    private final BiomeRegistry registry;
+
+    // Scratch reused across calls so sampling is allocation-free at fragment rate.
+    private final int[] cornerIds = new int[8];
+    private final float[] cornerWeights = new float[8];
+    private final int[] mergedIds = new int[8];
+    private final float[] mergedWeights = new float[8];
+
+    public BiomeSampler(BiomeField field, BiomeRegistry registry) {
+        this.field = field;
+        this.registry = registry;
+    }
+
+    public BiomeField field() { return field; }
+    public BiomeRegistry registry() { return registry; }
+
+    public BiomeSample sample(double wx, double wy, double wz) {
+        BiomeSample out = new BiomeSample(registry, (float) wx, (float) wy, (float) wz);
+
+        double cellSize = field.cellSize();
+        // Cell-centre space: the centre of cell c sits at (c + 0.5) * cellSize.
+        double fx = wx / cellSize - 0.5;
+        double fy = wy / cellSize - 0.5;
+        double fz = wz / cellSize - 0.5;
+
+        int bx = (int) Math.floor(fx), by = (int) Math.floor(fy), bz = (int) Math.floor(fz);
+        float tx = clamp01((float) (fx - bx));
+        float ty = clamp01((float) (fy - by));
+        float tz = clamp01((float) (fz - bz));
+
+        float w000 = (1 - tx) * (1 - ty) * (1 - tz);
+        float w100 = tx * (1 - ty) * (1 - tz);
+        float w010 = (1 - tx) * ty * (1 - tz);
+        float w110 = tx * ty * (1 - tz);
+        float w001 = (1 - tx) * (1 - ty) * tz;
+        float w101 = tx * (1 - ty) * tz;
+        float w011 = (1 - tx) * ty * tz;
+        float w111 = tx * ty * tz;
+
+        cornerIds[0] = field.idAtCell(bx, by, bz);         cornerWeights[0] = w000;
+        cornerIds[1] = field.idAtCell(bx + 1, by, bz);     cornerWeights[1] = w100;
+        cornerIds[2] = field.idAtCell(bx, by + 1, bz);     cornerWeights[2] = w010;
+        cornerIds[3] = field.idAtCell(bx + 1, by + 1, bz); cornerWeights[3] = w110;
+        cornerIds[4] = field.idAtCell(bx, by, bz + 1);     cornerWeights[4] = w001;
+        cornerIds[5] = field.idAtCell(bx + 1, by, bz + 1); cornerWeights[5] = w101;
+        cornerIds[6] = field.idAtCell(bx, by + 1, bz + 1); cornerWeights[6] = w011;
+        cornerIds[7] = field.idAtCell(bx + 1, by + 1, bz + 1); cornerWeights[7] = w111;
+
+        int merged = 0;
+        float total = 0f;
+        for (int i = 0; i < 8; i++) {
+            int id = cornerIds[i];
+            float w = cornerWeights[i];
+            if (id == BiomeField.UNKNOWN || w <= 0f) continue;
+            int at = -1;
+            for (int j = 0; j < merged; j++) if (mergedIds[j] == id) { at = j; break; }
+            if (at >= 0) mergedWeights[at] += w;
+            else { mergedIds[merged] = id; mergedWeights[merged] = w; merged++; }
+            total += w;
+        }
+        if (merged == 0 || total <= 0f) return out;
+
+        // Sort by weight, descending. Insertion sort: n <= 8.
+        for (int i = 1; i < merged; i++) {
+            int id = mergedIds[i];
+            float w = mergedWeights[i];
+            int j = i - 1;
+            while (j >= 0 && mergedWeights[j] < w) {
+                mergedIds[j + 1] = mergedIds[j];
+                mergedWeights[j + 1] = mergedWeights[j];
+                j--;
+            }
+            mergedIds[j + 1] = id;
+            mergedWeights[j + 1] = w;
+        }
+
+        out.count = Math.min(merged, BiomeSample.MAX_ENTRIES);
+        float kept = 0f;
+        for (int i = 0; i < out.count; i++) kept += mergedWeights[i];
+        // Renormalise over what we keep, so the weights the shader sees sum to 1
+        // even when a fifth biome was dropped.
+        for (int i = 0; i < out.count; i++) {
+            out.ids[i] = mergedIds[i];
+            out.weights[i] = kept > 0f ? mergedWeights[i] / kept : 0f;
+        }
+        return out;
+    }
+
+    /** Convenience for the ingest path: sample at a cell centre. */
+    public BiomeSample sampleCellCentre(int cx, int cy, int cz) {
+        double s = field.cellSize();
+        return sample((cx + 0.5) * s, (cy + 0.5) * s, (cz + 0.5) * s);
+    }
+
+    private static float clamp01(float f) { return f < 0f ? 0f : (f > 1f ? 1f : f); }
+}
diff --git a/core/src/main/java/dev/auralite/render/biome/DirtyRegion.java b/core/src/main/java/dev/auralite/render/biome/DirtyRegion.java
new file mode 100644
index 0000000..1105f2a
--- /dev/null
+++ b/core/src/main/java/dev/auralite/render/biome/DirtyRegion.java
@@ -0,0 +1,107 @@
+package dev.auralite.render.biome;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.List;
+
+/**
+ * A box of cells that changed, in cell coordinates.
+ *
+ * <p>Sub-image uploads are the difference between a biome field that costs
+ * nothing after the first frame and one that re-uploads megabytes every time a
+ * chunk loads. Regions are coalesced before upload because a chunk border
+ * crossing otherwise produces dozens of 1-cell boxes and the driver call
+ * overhead dominates the bytes.
+ */
+public final class DirtyRegion {
+    public int minX, minY, minZ;
+    public int sizeX, sizeY, sizeZ;
+
+    public DirtyRegion(int minX, int minY, int minZ, int sizeX, int sizeY, int sizeZ) {
+        this.minX = minX; this.minY = minY; this.minZ = minZ;
+        this.sizeX = Math.max(1, sizeX); this.sizeY = Math.max(1, sizeY); this.sizeZ = Math.max(1, sizeZ);
+    }
+
+    public static DirtyRegion cell(int cx, int cy, int cz) { return new DirtyRegion(cx, cy, cz, 1, 1, 1); }
+
+    public int maxX() { return minX + sizeX; }
+    public int maxY() { return minY + sizeY; }
+    public int maxZ() { return minZ + sizeZ; }
+    public long volume() { return (long) sizeX * sizeY * sizeZ; }
+
+    public boolean contains(int cx, int cy, int cz) {
+        return cx >= minX && cy >= minY && cz >= minZ && cx < maxX() && cy < maxY() && cz < maxZ();
+    }
+
+    public boolean intersects(DirtyRegion o) {
+        return minX < o.maxX() && o.minX < maxX()
+                && minY < o.maxY() && o.minY < maxY()
+                && minZ < o.maxZ() && o.minZ < maxZ();
+    }
+
+    /** True when the two boxes touch or are within {@code gap} cells of each other. */
+    public boolean touches(DirtyRegion o, int gap) {
+        return minX - gap < o.maxX() && o.minX - gap < maxX()
+                && minY - gap < o.maxY() && o.minY - gap < maxY()
+                && minZ - gap < o.maxZ() && o.minZ - gap < maxZ();
+    }
+
+    public DirtyRegion union(DirtyRegion o) {
+        int nMinX = Math.min(minX, o.minX), nMinY = Math.min(minY, o.minY), nMinZ = Math.min(minZ, o.minZ);
+        int nMaxX = Math.max(maxX(), o.maxX()), nMaxY = Math.max(maxY(), o.maxY()), nMaxZ = Math.max(maxZ(), o.maxZ());
+        return new DirtyRegion(nMinX, nMinY, nMinZ, nMaxX - nMinX, nMaxY - nMinY, nMaxZ - nMinZ);
+    }
+
+    /**
+     * Coalesces a region list down to at most {@code budget} boxes.
+     *
+     * <p>Greedy: repeatedly merge the touching pair whose union wastes the least
+     * volume, then, if the budget is still exceeded, merge the two largest
+     * boxes regardless of adjacency. Deterministic -- the same input list
+     * produces the same output list, which the ingest gate asserts.
+     */
+    public static List<DirtyRegion> coalesce(List<DirtyRegion> in, int budget, int gap) {
+        List<DirtyRegion> out = new ArrayList<DirtyRegion>();
+        for (DirtyRegion r : in) out.add(new DirtyRegion(r.minX, r.minY, r.minZ, r.sizeX, r.sizeY, r.sizeZ));
+        if (budget <= 0) budget = 1;
+
+        boolean merged = true;
+        while (out.size() > 1 && merged) {
+            merged = false;
+            int bestI = -1, bestJ = -1;
+            long bestWaste = Long.MAX_VALUE;
+            for (int i = 0; i < out.size(); i++) {
+                for (int j = i + 1; j < out.size(); j++) {
+                    DirtyRegion a = out.get(i), b = out.get(j);
+                    if (!a.touches(b, gap)) continue;
+                    long waste = a.union(b).volume() - a.volume() - b.volume();
+                    if (waste < bestWaste) { bestWaste = waste; bestI = i; bestJ = j; }
+                }
+            }
+            if (bestI >= 0) {
+                DirtyRegion u = out.get(bestI).union(out.get(bestJ));
+                out.remove(bestJ);
+                out.set(bestI, u);
+                merged = true;
+            }
+        }
+
+        while (out.size() > budget) {
+            Collections.sort(out, new Comparator<DirtyRegion>() {
+                @Override public int compare(DirtyRegion a, DirtyRegion b) {
+                    int c = Long.compare(b.volume(), a.volume());
+                    return c != 0 ? c : Integer.compare(a.minX, b.minX);
+                }
+            });
+            DirtyRegion u = out.get(0).union(out.get(1));
+            out.remove(1);
+            out.set(0, u);
+        }
+        return out;
+    }
+
+    @Override public String toString() {
+        return "[" + minX + "," + minY + "," + minZ + " +" + sizeX + "x" + sizeY + "x" + sizeZ + "]";
+    }
+}
diff --git a/core/src/main/java/dev/auralite/render/graph/Barrier.java b/core/src/main/java/dev/auralite/render/graph/Barrier.java
new file mode 100644
index 0000000..eddec36
--- /dev/null
+++ b/core/src/main/java/dev/auralite/render/graph/Barrier.java
@@ -0,0 +1,43 @@
+package dev.auralite.render.graph;
+
+import dev.auralite.render.rhi.GfxEnums.ResourceState;
+
+/**
+ * One transition the backends must honour.
+ *
+ * <p>Vulkan turns this into a {@code VkImageMemoryBarrier2}; OpenGL turns it
+ * into at most a {@code glMemoryBarrier} with the matching bit, and into
+ * nothing at all when the driver's implicit tracking already covers it. The
+ * graph emits the same list either way, so both lanes are driven by one
+ * derivation and can be diffed against each other in the parity gate.
+ */
+public final class Barrier {
+    public enum Target { IMAGE, BUFFER }
+
+    public final Target target;
+    public final GraphResource resource;
+    public final ResourceState from;
+    public final ResourceState to;
+    public final int srcAccess;
+    public final int dstAccess;
+    /** Pass that required the transition; used in the receipts. */
+    public final String requiredBy;
+
+    public Barrier(Target target, GraphResource resource, ResourceState from, ResourceState to,
+                   int srcAccess, int dstAccess, String requiredBy) {
+        this.target = target;
+        this.resource = resource;
+        this.from = from;
+        this.to = to;
+        this.srcAccess = srcAccess;
+        this.dstAccess = dstAccess;
+        this.requiredBy = requiredBy;
+    }
+
+    /** True when nothing actually changes and the backend may skip the call. */
+    public boolean isNoop() { return from == to && srcAccess == dstAccess; }
+
+    @Override public String toString() {
+        return resource.name() + ": " + from + " -> " + to + " @" + requiredBy;
+    }
+}
diff --git a/core/src/main/java/dev/auralite/render/graph/CompiledGraph.java b/core/src/main/java/dev/auralite/render/graph/CompiledGraph.java
new file mode 100644
index 0000000..8ee931b
--- /dev/null
+++ b/core/src/main/java/dev/auralite/render/graph/CompiledGraph.java
@@ -0,0 +1,247 @@
+package dev.auralite.render.graph;
+
+import dev.auralite.render.rhi.DeviceLimits;
+import dev.auralite.render.rhi.GfxBuffer;
+import dev.auralite.render.rhi.GfxDesc;
+import dev.auralite.render.rhi.GfxDevice;
+import dev.auralite.render.rhi.GfxImage;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * An executable frame: ordered passes, the barriers each one needs, resource
+ * lifetimes and the compile receipts.
+ *
+ * <p>Immutable after construction except for the resource bindings, which
+ * {@link #allocate(GfxDevice)} fills in and {@link #release()} clears. One
+ * compiled graph is reused for every frame at a given size; a resize or an
+ * option change recompiles.
+ */
+public final class CompiledGraph {
+    private final RenderGraph graph;
+    private final int width;
+    private final int height;
+    private final DeviceLimits limits;
+    private final List<GraphPass> ordered;
+    private final List<List<Barrier>> barriersByPass;
+    private final List<ResourceLifetime> lifetimes;
+    private final Map<GraphResource, GfxDesc.Image> effectiveDescs;
+    private final GraphStats stats;
+    private final List<GraphHistory> histories;
+
+    private boolean allocated;
+    private GfxDevice device;
+    private final List<AutoCloseable> owned = new ArrayList<AutoCloseable>();
+    private long executions;
+    private long barriersEmitted;
+    private long passesExecuted;
+
+    CompiledGraph(RenderGraph graph, int width, int height, DeviceLimits limits,
+                  List<GraphPass> ordered, List<List<Barrier>> barriersByPass,
+                  List<ResourceLifetime> lifetimes, Map<GraphResource, GfxDesc.Image> effectiveDescs,
+                  GraphStats stats) {
+        this.graph = graph;
+        this.width = width;
+        this.height = height;
+        this.limits = limits;
+        this.ordered = Collections.unmodifiableList(ordered);
+        this.barriersByPass = barriersByPass;
+        this.lifetimes = Collections.unmodifiableList(lifetimes);
+        this.effectiveDescs = effectiveDescs;
+        this.stats = stats;
+        this.histories = Collections.unmodifiableList(graph.histories());
+    }
+
+    public RenderGraph graph() { return graph; }
+    public int width() { return width; }
+    public int height() { return height; }
+    public DeviceLimits limits() { return limits; }
+    public GraphStats stats() { return stats; }
+    public List<GraphPass> passes() { return ordered; }
+    public List<ResourceLifetime> lifetimes() { return lifetimes; }
+    public int passCount() { return ordered.size(); }
+    public long executions() { return executions; }
+    public long barriersEmitted() { return barriersEmitted; }
+    public long passesExecuted() { return passesExecuted; }
+    public boolean isAllocated() { return allocated; }
+
+    public List<String> passOrder() {
+        List<String> out = new ArrayList<String>();
+        for (GraphPass p : ordered) out.add(p.name());
+        return out;
+    }
+
+    public List<Barrier> barriersBefore(int passIndex) {
+        if (passIndex < 0 || passIndex >= barriersByPass.size()) return Collections.emptyList();
+        return Collections.unmodifiableList(barriersByPass.get(passIndex));
+    }
+
+    public int totalBarriers() {
+        int n = 0;
+        for (List<Barrier> l : barriersByPass) n += l.size();
+        return n;
+    }
+
+    public ResourceLifetime lifetimeOf(String resourceName) {
+        for (ResourceLifetime l : lifetimes) if (l.resource.name().equals(resourceName)) return l;
+        return null;
+    }
+
+    /** The descriptor actually used at allocation time, with relative sizes resolved. */
+    public GfxDesc.Image effectiveDesc(String resourceName) {
+        return effectiveDescs.get(graph.require(resourceName));
+    }
+
+    // ------------------------------------------------------------ allocation
+    /** Creates every owned resource on {@code dev} and binds it. Idempotent. */
+    public void allocate(GfxDevice dev) {
+        if (allocated) return;
+        this.device = dev;
+        for (GraphResource r : graph.resources()) {
+            if (r.isImported()) continue;
+            if (r.isTexture()) {
+                GfxDesc.Image d = effectiveDescs.get(r);
+                if (d == null) continue;
+                GfxDesc.Image c = GfxDesc.Image.tex2d(d.width, d.height, d.format, d.usage);
+                c.type = d.type; c.depth = d.depth; c.mipLevels = d.mipLevels;
+                c.arrayLayers = d.arrayLayers; c.samples = d.samples; c.domain = d.domain;
+                c.debugName = r.name();
+                GfxImage img = dev.createImage(c);
+                r.bindImage(img);
+                owned.add(img);
+            } else {
+                GfxDesc.Buffer d = r.bufferDesc();
+                if (d == null) continue;
+                GfxDesc.Buffer c = GfxDesc.Buffer.of(d.sizeBytes, d.usage).domain(d.domain).named(r.name());
+                GfxBuffer b = dev.createBuffer(c);
+                r.bindBuffer(b);
+                owned.add(b);
+            }
+        }
+        allocated = true;
+    }
+
+    /**
+     * Binds an imported resource to a handle the host owns.
+     *
+     * <p>The graph never allocates, resizes or frees an imported resource; it
+     * only requires that one is bound before the pass that uses it runs. Inside
+     * Minecraft the glue binds the vanilla framebuffer here every frame.
+     */
+    public void bindImported(String resourceName, GfxImage image) {
+        GraphResource r = graph.require(resourceName);
+        if (!r.isImported()) {
+            throw new GraphException("resource '" + resourceName + "' is owned by the graph, not imported");
+        }
+        r.bindImage(image);
+    }
+
+    public void bindImported(String resourceName, GfxBuffer buffer) {
+        GraphResource r = graph.require(resourceName);
+        if (!r.isImported()) {
+            throw new GraphException("resource '" + resourceName + "' is owned by the graph, not imported");
+        }
+        r.bindBuffer(buffer);
+    }
+
+    /** Checks that every resource the ordered passes touch is bound. */
+    private void preflight() {
+        for (int i = 0; i < ordered.size(); i++) {
+            GraphPass p = ordered.get(i);
+            for (GraphAccess a : p.accesses()) {
+                boolean bound = a.resource.isBuffer() ? a.resource.buffer() != null : a.resource.image() != null;
+                if (!bound) {
+                    throw new GraphException("resource '" + a.resource.name() + "' is not bound"
+                            + (a.resource.isImported()
+                                    ? "; imported resources must be bound by the host via bindImported()"
+                                    : ""), p.name());
+                }
+            }
+        }
+    }
+
+    public void release() {
+        for (int i = owned.size() - 1; i >= 0; i--) {
+            try { owned.get(i).close(); } catch (Exception e) { /* recorded by the device */ }
+        }
+        owned.clear();
+        for (GraphResource r : graph.resources()) {
+            if (!r.isImported()) { r.bindImage(null); r.bindBuffer(null); }
+        }
+        allocated = false;
+        device = null;
+    }
+
+    // ------------------------------------------------------------- execution
+    /** Runs the frame. Barriers first, then the pass body, in compiled order. */
+    public void execute(GraphContext ctx) {
+        if (!allocated) {
+            throw new GraphException("graph executed before allocate(); no resources are bound");
+        }
+        preflight();
+        executions++;
+        for (int i = 0; i < ordered.size(); i++) {
+            GraphPass p = ordered.get(i);
+            for (Barrier b : barriersByPass.get(i)) {
+                if (b.target == Barrier.Target.IMAGE) {
+                    GfxImage img = b.resource.image();
+                    if (img != null) {
+                        ctx.cmd().barrier(img, b.from, b.to, b.srcAccess, b.dstAccess);
+                        barriersEmitted++;
+                    }
+                } else {
+                    GfxBuffer buf = b.resource.buffer();
+                    if (buf != null) {
+                        ctx.cmd().barrier(buf, b.srcAccess, b.dstAccess);
+                        barriersEmitted++;
+                    }
+                }
+            }
+            ctx.setCurrentPass(p);
+            // The graph owns pass begin/end and the viewport, not the pass body.
+            // A body that had to remember to close its own render pass was a
+            // footgun the NULL backend caught immediately; now a body only binds
+            // pipelines and issues draws or dispatches.
+            boolean raster = p.type() == dev.auralite.render.rhi.GfxEnums.PassType.RASTER;
+            if (raster) ctx.beginRasterPass();
+            if (p.executor() != null) {
+                p.executor().execute(ctx);
+                passesExecuted++;
+            }
+            if (raster) ctx.endRasterPass();
+            ctx.setCurrentPass(null);
+        }
+        swapHistories();
+    }
+
+    /** Ping-pongs every history pair; called by {@link #execute} at frame end. */
+    public void swapHistories() {
+        for (GraphHistory h : histories) h.swapBindings();
+    }
+
+    /** One line per fact, for the plan receipts and CI diffs. */
+    public String receipt() {
+        StringBuilder sb = new StringBuilder();
+        sb.append("graph '").append(graph.name()).append("' ").append(width).append('x').append(height).append('\n');
+        sb.append(stats.receipt());
+        sb.append("order: ").append(passOrder()).append('\n');
+        sb.append("barriers: ").append(totalBarriers()).append(" planned\n");
+        for (int i = 0; i < ordered.size(); i++) {
+            List<Barrier> b = barriersByPass.get(i);
+            if (!b.isEmpty()) {
+                sb.append("  before ").append(ordered.get(i).name()).append(": ");
+                for (int k = 0; k < b.size(); k++) {
+                    if (k > 0) sb.append(", ");
+                    sb.append(b.get(k));
+                }
+                sb.append('\n');
+            }
+        }
+        sb.append("lifetimes:\n");
+        for (ResourceLifetime l : lifetimes) sb.append("  ").append(l).append('\n');
+        return sb.toString();
+    }
+}
diff --git a/core/src/main/java/dev/auralite/render/graph/GraphAccess.java b/core/src/main/java/dev/auralite/render/graph/GraphAccess.java
new file mode 100644
index 0000000..4d51276
--- /dev/null
+++ b/core/src/main/java/dev/auralite/render/graph/GraphAccess.java
@@ -0,0 +1,42 @@
+package dev.auralite.render.graph;
+
+import dev.auralite.render.rhi.GfxEnums.Access;
+import dev.auralite.render.rhi.GfxEnums.ResourceState;
+
+/** One resource usage inside one pass. */
+public final class GraphAccess {
+    public final GraphResource resource;
+    public final int access;
+    /** Attachment slot when the resource is a colour attachment, else -1. */
+    public final int attachmentSlot;
+    public final int mipLevel;
+
+    public GraphAccess(GraphResource resource, int access, int attachmentSlot, int mipLevel) {
+        this.resource = resource;
+        this.access = access;
+        this.attachmentSlot = attachmentSlot;
+        this.mipLevel = mipLevel;
+    }
+
+    public boolean isWrite() { return Access.isWrite(access); }
+    public boolean isRead() { return !isWrite(); }
+
+    /** The state a resource must be in for this access. */
+    public ResourceState impliedState() {
+        if ((access & Access.COLOR_ATTACHMENT_WRITE) != 0) return ResourceState.COLOR_ATTACHMENT_WRITE;
+        if ((access & Access.COLOR_ATTACHMENT_READ) != 0) return ResourceState.COLOR_ATTACHMENT_WRITE;
+        if ((access & Access.DEPTH_STENCIL_WRITE) != 0) return ResourceState.DEPTH_STENCIL_WRITE;
+        if ((access & Access.DEPTH_STENCIL_READ) != 0) return ResourceState.DEPTH_STENCIL_READ;
+        if ((access & Access.SHADER_WRITE) != 0) return ResourceState.STORAGE_WRITE;
+        if ((access & Access.SHADER_READ) != 0) return ResourceState.SHADER_READ;
+        if ((access & Access.INPUT_ATTACHMENT_READ) != 0) return ResourceState.SHADER_READ;
+        if ((access & Access.TRANSFER_READ) != 0) return ResourceState.COPY_SOURCE;
+        if ((access & Access.TRANSFER_WRITE) != 0) return ResourceState.COPY_DEST;
+        if ((access & Access.HOST_READ) != 0) return ResourceState.HOST_READ;
+        return ResourceState.UNDEFINED;
+    }
+
+    @Override public String toString() {
+        return resource.name() + (isWrite() ? "[w]" : "[r]") + "->" + impliedState();
+    }
+}
diff --git a/core/src/main/java/dev/auralite/render/graph/GraphCompiler.java b/core/src/main/java/dev/auralite/render/graph/GraphCompiler.java
new file mode 100644
index 0000000..e6b7b1a
--- /dev/null
+++ b/core/src/main/java/dev/auralite/render/graph/GraphCompiler.java
@@ -0,0 +1,562 @@
+package dev.auralite.render.graph;
+
+import dev.auralite.render.rhi.DeviceLimits;
+import dev.auralite.render.rhi.GfxDesc;
+import dev.auralite.render.rhi.GfxEnums.Access;
+import dev.auralite.render.rhi.GfxEnums.PassType;
+import dev.auralite.render.rhi.GfxEnums.ResourceState;
+import dev.auralite.render.rhi.GfxUsage;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.IdentityHashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Turns a declared {@link RenderGraph} into an executable {@link CompiledGraph}.
+ *
+ * <p>Six derivations, in order, each with a host-side gate:
+ * <ol>
+ *   <li>validation -- a broken pack is refused with a named reason here, not at
+ *       first draw;</li>
+ *   <li>dependency edges from the read/write declarations (RAW, WAR and WAW are
+ *       all just "consecutive accesses where one side writes");</li>
+ *   <li>cycle detection, reporting the offending path;</li>
+ *   <li>culling of passes with no external output, no kept consumer and no
+ *       {@link GraphPass#isKept()} marker of its own;</li>
+ *   <li>deterministic topological order (Kahn, ties broken by declaration
+ *       index, so two runs of the same pack compile byte-identically);</li>
+ *   <li>resource lifetimes, alias groups and the barrier list.</li>
+ * </ol>
+ */
+public final class GraphCompiler {
+
+    private final RenderGraph graph;
+    private final int width;
+    private final int height;
+    private final DeviceLimits limits;
+
+    private final List<GraphPass> enabled = new ArrayList<GraphPass>();
+    private final List<List<Integer>> successors = new ArrayList<List<Integer>>();
+    private final List<List<Integer>> predecessors = new ArrayList<List<Integer>>();
+    private final GraphStats stats = new GraphStats();
+    private final Map<GraphResource, GfxDesc.Image> effectiveDescs =
+            new LinkedHashMap<GraphResource, GfxDesc.Image>();
+
+    public GraphCompiler(RenderGraph graph, int width, int height, DeviceLimits limits) {
+        this.graph = graph;
+        this.width = Math.max(1, width);
+        this.height = Math.max(1, height);
+        this.limits = limits == null ? new DeviceLimits() : limits;
+    }
+
+    public CompiledGraph compile() {
+        long t0 = System.nanoTime();
+        stats.declaredPasses = graph.passCount();
+        stats.declaredResources = graph.resourceCount();
+
+        for (GraphPass p : graph.passes()) {
+            if (!p.isEnabled()) {
+                stats.disabled.add(p.name() + " -- " + p.disableReason());
+                continue;
+            }
+            enabled.add(p);
+        }
+        stats.enabledPasses = enabled.size();
+        for (int i = 0; i < enabled.size(); i++) {
+            successors.add(new ArrayList<Integer>());
+            predecessors.add(new ArrayList<Integer>());
+        }
+
+        validate();
+        resolveEffectiveDescs();
+        buildEdges();
+        detectCycles();
+
+        int[] order = cullAndOrder();
+
+        List<GraphPass> ordered = new ArrayList<GraphPass>();
+        for (int idx : order) ordered.add(enabled.get(idx));
+
+        Map<GraphResource, int[]> accessSlots = indexPassPositions(ordered);
+        List<ResourceLifetime> lifetimes = computeLifetimes(ordered, accessSlots);
+        List<List<Barrier>> barriers = deriveBarriers(ordered);
+        computeAliasing(lifetimes);
+
+        stats.compileMicros = (System.nanoTime() - t0) / 1000L;
+        return new CompiledGraph(graph, width, height, limits, ordered, barriers,
+                lifetimes, effectiveDescs, stats);
+    }
+
+    // ------------------------------------------------------------- validation
+    private void validate() {
+        for (GraphPass p : enabled) {
+            if (p.accesses().isEmpty()) {
+                throw new GraphException("pass declares no resource access; a pass must read or write "
+                        + "something or be marked external()", p.name());
+            }
+            if (p.executor() == null && !p.isExternal()) {
+                throw new GraphException("pass has no body and is not external()", p.name());
+            }
+            if (p.type() == PassType.RASTER) {
+                List<GraphAccess> colors = p.colorAttachments();
+                if (colors.isEmpty() && p.depthAttachment() == null) {
+                    throw new GraphException("raster pass has neither a colour nor a depth attachment", p.name());
+                }
+                if (colors.size() > limits.maxColorAttachments) {
+                    throw new GraphException("raster pass uses " + colors.size() + " colour attachments, "
+                            + "device limit is " + limits.maxColorAttachments, p.name());
+                }
+                Set<Integer> slots = new HashSet<Integer>();
+                for (GraphAccess a : colors) {
+                    if (!a.resource.isTexture()) {
+                        throw new GraphException("colour attachment '" + a.resource.name()
+                                + "' is a buffer", p.name());
+                    }
+                    if (!slots.add(a.attachmentSlot)) {
+                        throw new GraphException("duplicate colour attachment slot " + a.attachmentSlot, p.name());
+                    }
+                }
+                GraphAccess d = p.depthAttachment();
+                if (d != null && !d.resource.format().isDepthStencil()) {
+                    throw new GraphException("depth attachment '" + d.resource.name() + "' has format "
+                            + d.resource.format() + ", which is not a depth format", p.name());
+                }
+                stats.rasterPasses++;
+            } else if (p.type() == PassType.COMPUTE) {
+                boolean writes = false;
+                for (GraphAccess a : p.accesses()) if (a.isWrite()) writes = true;
+                if (!writes) {
+                    stats.warnings.add("compute pass '" + p.name() + "' writes nothing");
+                }
+                if (p.groupsX() > limits.maxComputeWorkGroupCountX
+                        || p.groupsY() > limits.maxComputeWorkGroupCountY
+                        || p.groupsZ() > limits.maxComputeWorkGroupCountZ) {
+                    throw new GraphException("dispatch (" + p.groupsX() + "," + p.groupsY() + ","
+                            + p.groupsZ() + ") exceeds the device work-group count limit", p.name());
+                }
+                stats.computePasses++;
+            } else if (p.type() == PassType.COPY) {
+                stats.copyPasses++;
+            }
+        }
+
+        for (GraphResource r : graph.resources()) {
+            if (r.isImported()) { stats.importedResources++; continue; }
+            if (r.isTransient()) stats.transientResources++;
+            GfxDesc.Image d = r.imageDesc();
+            if (d != null) {
+                int maxDim = d.type == dev.auralite.render.rhi.GfxEnums.ImageType.TEXTURE_3D
+                        ? limits.maxTexture3DSize : limits.maxTexture2DSize;
+                if (d.width > maxDim || d.height > maxDim) {
+                    throw new GraphException("resource '" + r.name() + "' is " + d.width + "x" + d.height
+                            + ", device limit is " + maxDim);
+                }
+            }
+        }
+
+        // Reads that no enabled pass produces. Not fatal: a pack option may be off
+        // and the consumer may fall back to a default, but it is always reported.
+        Set<GraphResource> written = new HashSet<GraphResource>();
+        for (GraphPass p : enabled) {
+            for (GraphAccess a : p.accesses()) if (a.isWrite()) written.add(a.resource);
+        }
+        Set<GraphResource> read = new HashSet<GraphResource>();
+        for (GraphPass p : enabled) {
+            for (GraphAccess a : p.accesses()) if (a.isRead()) read.add(a.resource);
+        }
+        java.util.Set<GraphResource> historySides = new java.util.HashSet<GraphResource>();
+        for (GraphHistory h : graph.histories()) {
+            historySides.add(h.sideA());
+            historySides.add(h.sideB());
+        }
+        for (GraphResource r : read) {
+            if (written.contains(r) || r.isImported()) continue;
+            if (historySides.contains(r)) {
+                // Written on the previous frame by construction; not a defect.
+                stats.warnings.add("resource '" + r.name() + "' is a history side: written last frame, "
+                        + "read this frame");
+                continue;
+            }
+            stats.warnings.add("resource '" + r.name() + "' is read but never written by an enabled pass");
+        }
+    }
+
+    /** Expands framebuffer-relative sizes (0 means "match the framebuffer"). */
+    private void resolveEffectiveDescs() {
+        for (GraphResource r : graph.resources()) {
+            GfxDesc.Image d = r.imageDesc();
+            if (d == null) continue;
+            if (d.width == 0 || d.height == 0) {
+                GfxDesc.Image e = GfxDesc.Image.tex2d(d.width == 0 ? width : d.width,
+                        d.height == 0 ? height : d.height, d.format, d.usage);
+                e.type = d.type;
+                e.depth = d.depth;
+                e.mipLevels = d.mipLevels;
+                e.arrayLayers = d.arrayLayers;
+                e.samples = d.samples;
+                e.domain = d.domain;
+                e.debugName = d.debugName;
+                effectiveDescs.put(r, e);
+            } else {
+                effectiveDescs.put(r, d);
+            }
+        }
+        for (GraphResource r : graph.resources()) {
+            if (r.isImported()) {
+                GfxDesc.Image d = effectiveDescs.get(r);
+                long b = d == null ? (r.bufferDesc() == null ? 0 : r.bufferDesc().sizeBytes) : d.approxBytes();
+                stats.importedTextureBytes += b;
+            } else if (r.isTexture()) {
+                GfxDesc.Image d = effectiveDescs.get(r);
+                stats.ownedTextureBytes += d == null ? 0 : d.approxBytes();
+            } else {
+                stats.bufferBytes += r.bufferDesc() == null ? 0 : r.bufferDesc().sizeBytes;
+            }
+        }
+    }
+
+    // ------------------------------------------------------------------ edges
+    /**
+     * Derives dependency edges from the read/write declarations.
+     *
+     * <p>Three edge kinds, and the direction comes from the semantics rather
+     * than from the order the pack happened to declare things in -- a pack may
+     * declare {@code present} first and the compiler still puts it last:
+     *
+     * <ul>
+     * <li><b>RAW</b> writer &rarr; reader of the same resource;</li>
+     * <li><b>WAW</b> earlier-declared writer &rarr; later-declared writer.</li>
+     * </ul>
+     *
+     * <p>WAR is deliberately <b>not</b> an edge. A read that must happen before a
+     * later write to the same resource is a false dependency: making it an edge
+     * contradicts the RAW edge for the same pair and manufactures a cycle out of
+     * an ordinary "read the imported framebuffer, then overwrite it" pass. Those
+     * cases are ordered by the deterministic tie-break in the topological sort,
+     * which prefers the lower declaration index. That was measured, not assumed:
+     * with a WAR edge the two-pass graph {@code blit(reads mid) -> produce(writes
+     * mid)} reported a cycle.
+     *
+     * <p>History pairs get a third rule: a writer of one side &rarr; a reader of
+     * the other. Without it the temporal producer has no downstream consumer in
+     * this frame's graph and culling deletes it.
+     */
+    private void buildEdges() {
+        Map<GraphResource, List<Integer>> writers = new LinkedHashMap<GraphResource, List<Integer>>();
+        Map<GraphResource, List<Integer>> readers = new LinkedHashMap<GraphResource, List<Integer>>();
+
+        for (int i = 0; i < enabled.size(); i++) {
+            for (GraphAccess a : enabled.get(i).accesses()) {
+                List<Integer> w = writers.get(a.resource);
+                if (w == null) { w = new ArrayList<Integer>(); writers.put(a.resource, w); }
+                List<Integer> r = readers.get(a.resource);
+                if (r == null) { r = new ArrayList<Integer>(); readers.put(a.resource, r); }
+                if (a.isWrite()) {
+                    if (!w.contains(i)) w.add(i);
+                } else if (!r.contains(i)) {
+                    r.add(i);
+                }
+            }
+            // A pass that both reads and writes a resource is a writer only; the
+            // read is inside the same pass and must not become a self-edge.
+            for (GraphAccess a : enabled.get(i).accesses()) {
+                if (a.isWrite()) readers.get(a.resource).remove(Integer.valueOf(i));
+            }
+        }
+
+        int n = enabled.size();
+        boolean[][] adj = new boolean[n][n];
+
+        for (GraphResource res : writers.keySet()) {
+            List<Integer> w = writers.get(res);
+            List<Integer> r = readers.get(res);
+            for (int wi : w) for (int ri : r) if (wi != ri) adj[wi][ri] = true;          // RAW
+            for (int i = 0; i < w.size(); i++)                                            // WAW
+                for (int j = i + 1; j < w.size(); j++) adj[w.get(i)][w.get(j)] = true;
+        }
+
+        for (GraphHistory h : graph.histories()) {
+            linkSides(adj, writers, readers, h.sideA(), h.sideB());
+            linkSides(adj, writers, readers, h.sideB(), h.sideA());
+        }
+
+        List<List<Integer>> succ = new ArrayList<List<Integer>>();
+        List<List<Integer>> pred = new ArrayList<List<Integer>>();
+        for (int i = 0; i < n; i++) { succ.add(new ArrayList<Integer>()); pred.add(new ArrayList<Integer>()); }
+        long edges = 0;
+        for (int i = 0; i < n; i++) {
+            for (int j = 0; j < n; j++) {
+                if (i != j && adj[i][j]) { succ.get(i).add(j); pred.get(j).add(i); edges++; }
+            }
+        }
+        successors.clear(); successors.addAll(succ);
+        predecessors.clear(); predecessors.addAll(pred);
+        stats.edgeCount = edges;
+    }
+
+    private static void linkSides(boolean[][] adj, Map<GraphResource, List<Integer>> writers,
+                                  Map<GraphResource, List<Integer>> readers,
+                                  GraphResource from, GraphResource to) {
+        List<Integer> w = writers.get(from);
+        List<Integer> r = readers.get(to);
+        if (w == null || r == null) return;
+        for (int wi : w) for (int ri : r) if (wi != ri) adj[wi][ri] = true;
+    }
+
+    // ----------------------------------------------------------------- cycles
+    private void detectCycles() {
+        int n = enabled.size();
+        int[] color = new int[n]; // 0 white, 1 grey, 2 black
+        int[] parent = new int[n];
+        Arrays.fill(parent, -1);
+        for (int i = 0; i < n; i++) {
+            if (color[i] == 0) {
+                String cycle = dfs(i, color, parent, new ArrayList<Integer>());
+                if (cycle != null) {
+                    throw new GraphException("dependency cycle: " + cycle);
+                }
+            }
+        }
+    }
+
+    private String dfs(int node, int[] color, int[] parent, List<Integer> stack) {
+        color[node] = 1;
+        stack.add(node);
+        for (int next : successors.get(node)) {
+            if (color[next] == 1) {
+                StringBuilder sb = new StringBuilder();
+                int from = stack.indexOf(next);
+                for (int i = from; i < stack.size(); i++) {
+                    if (sb.length() > 0) sb.append(" -> ");
+                    sb.append(enabled.get(stack.get(i)).name());
+                }
+                sb.append(" -> ").append(enabled.get(next).name());
+                return sb.toString();
+            }
+            if (color[next] == 0) {
+                parent[next] = node;
+                String r = dfs(next, color, parent, stack);
+                if (r != null) return r;
+            }
+        }
+        stack.remove(stack.size() - 1);
+        color[node] = 2;
+        return null;
+    }
+
+    // ---------------------------------------------------------- cull + order
+    private int[] cullAndOrder() {
+        int n = enabled.size();
+        boolean[] keep = new boolean[n];
+        List<Integer> work = new ArrayList<Integer>();
+        for (int i = 0; i < n; i++) {
+            if (enabled.get(i).isExternal() || enabled.get(i).isKept()) { keep[i] = true; work.add(i); }
+        }
+        while (!work.isEmpty()) {
+            int cur = work.remove(work.size() - 1);
+            for (int p : predecessors.get(cur)) {
+                if (!keep[p]) { keep[p] = true; work.add(p); }
+            }
+        }
+        List<Integer> alive = new ArrayList<Integer>();
+        for (int i = 0; i < n; i++) {
+            if (keep[i]) alive.add(i);
+            else stats.culled.add(enabled.get(i).name()
+                    + " -- no external output and no kept consumer");
+        }
+        stats.culledPasses = stats.culled.size();
+
+        // Kahn over the kept subgraph, restricted to kept edges only.
+        Set<Integer> aliveSet = new HashSet<Integer>(alive);
+        Map<Integer, Integer> indeg = new HashMap<Integer, Integer>();
+        for (int i : alive) {
+            int d = 0;
+            for (int p : predecessors.get(i)) if (aliveSet.contains(p)) d++;
+            indeg.put(i, d);
+        }
+        List<Integer> ready = new ArrayList<Integer>();
+        for (int i : alive) if (indeg.get(i) == 0) ready.add(i);
+        java.util.Collections.sort(ready);
+
+        int[] order = new int[alive.size()];
+        int written = 0;
+        while (!ready.isEmpty()) {
+            int cur = ready.remove(0);
+            order[written++] = cur;
+            List<Integer> newly = new ArrayList<Integer>();
+            for (int s : successors.get(cur)) {
+                if (!aliveSet.contains(s)) continue;
+                int d = indeg.get(s) - 1;
+                indeg.put(s, d);
+                if (d == 0) newly.add(s);
+            }
+            if (!newly.isEmpty()) {
+                ready.addAll(newly);
+                java.util.Collections.sort(ready);
+            }
+        }
+        if (written != alive.size()) {
+            throw new GraphException("topological sort stalled after " + written + " of "
+                    + alive.size() + " passes; a cycle survived detection");
+        }
+        stats.orderedPasses = written;
+        return order;
+    }
+
+    // -------------------------------------------------------------- lifetimes
+    /** First and last pass index that touch each resource, in ordered position. */
+    private Map<GraphResource, int[]> indexPassPositions(List<GraphPass> ordered) {
+        Map<GraphResource, int[]> slots = new LinkedHashMap<GraphResource, int[]>();
+        for (int i = 0; i < ordered.size(); i++) {
+            for (GraphAccess a : ordered.get(i).accesses()) {
+                int[] s = slots.get(a.resource);
+                if (s == null) {
+                    slots.put(a.resource, new int[] { i, i });
+                } else {
+                    s[0] = Math.min(s[0], i);
+                    s[1] = Math.max(s[1], i);
+                }
+            }
+        }
+        return slots;
+    }
+
+    private List<ResourceLifetime> computeLifetimes(List<GraphPass> ordered,
+                                                    Map<GraphResource, int[]> slots) {
+        List<ResourceLifetime> out = new ArrayList<ResourceLifetime>();
+        int last = Math.max(0, ordered.size() - 1);
+        for (GraphResource r : graph.resources()) {
+            int[] s = slots.get(r);
+            int first = r.isImported() ? 0 : (s == null ? 0 : s[0]);
+            int end = r.isImported() ? last : (s == null ? 0 : s[1]);
+            out.add(new ResourceLifetime(r, first, end, -1));
+        }
+        return out;
+    }
+
+    // --------------------------------------------------------------- barriers
+    private List<List<Barrier>> deriveBarriers(List<GraphPass> ordered) {
+        Map<GraphResource, ResourceState> state = new HashMap<GraphResource, ResourceState>();
+        Map<GraphResource, Integer> accessMask = new HashMap<GraphResource, Integer>();
+        for (GraphResource r : graph.resources()) {
+            if (r.isImported()) {
+                boolean present = r.imageDesc() != null
+                        && (r.imageDesc().usage & GfxUsage.IMAGE_PRESENT) != 0;
+                state.put(r, present ? ResourceState.PRESENT : ResourceState.SHADER_READ);
+                accessMask.put(r, present ? Access.MEMORY_READ : Access.SHADER_READ);
+            } else {
+                state.put(r, ResourceState.UNDEFINED);
+                accessMask.put(r, Access.NONE);
+            }
+        }
+
+        List<List<Barrier>> out = new ArrayList<List<Barrier>>();
+        for (GraphPass p : ordered) {
+            List<Barrier> before = new ArrayList<Barrier>();
+            // Sort accesses so attachments are transitioned in slot order: the
+            // resulting barrier list is stable across runs.
+            List<GraphAccess> sorted = new ArrayList<GraphAccess>(p.accesses());
+            java.util.Collections.sort(sorted, (x, y) -> {
+                int c = Integer.compare(x.resource.index(), y.resource.index());
+                if (c != 0) return c;
+                return Integer.compare(x.attachmentSlot, y.attachmentSlot);
+            });
+            for (GraphAccess a : sorted) {
+                ResourceState want = a.impliedState();
+                if (want == ResourceState.UNDEFINED) continue;
+                ResourceState have = state.get(a.resource);
+                int srcAccess = accessMask.get(a.resource);
+                if (have != want) {
+                    Barrier b = new Barrier(a.resource.isBuffer() ? Barrier.Target.BUFFER : Barrier.Target.IMAGE,
+                            a.resource, have, want, srcAccess, a.access, p.name());
+                    if (b.isNoop()) stats.noopBarriersSuppressed++;
+                    else { before.add(b); stats.barriers++; }
+                    state.put(a.resource, want);
+                }
+                accessMask.put(a.resource, a.access);
+            }
+            out.add(before);
+        }
+
+        // Anything presented must end in PRESENT.
+        List<Barrier> tail = new ArrayList<Barrier>();
+        for (Map.Entry<GraphResource, ResourceState> e : state.entrySet()) {
+            GraphResource r = e.getKey();
+            boolean present = r.imageDesc() != null && (r.imageDesc().usage & GfxUsage.IMAGE_PRESENT) != 0;
+            if (present && e.getValue() != ResourceState.PRESENT) {
+                tail.add(new Barrier(Barrier.Target.IMAGE, r, e.getValue(), ResourceState.PRESENT,
+                        accessMask.get(r), Access.MEMORY_READ, "<present>"));
+                stats.barriers++;
+            }
+        }
+        if (!tail.isEmpty()) out.add(tail);
+        return out;
+    }
+
+    // --------------------------------------------------------------- aliasing
+    private void computeAliasing(List<ResourceLifetime> lifetimes) {
+        List<ResourceLifetime> candidates = new ArrayList<ResourceLifetime>();
+        for (ResourceLifetime l : lifetimes) {
+            if (l.resource.isImported()) continue;
+            if (!l.resource.isTexture()) continue;
+            if (l.resource.isTransient()) continue;
+            if (l.span() <= 0) continue;
+            candidates.add(l);
+        }
+        // Longest-lived first: they anchor groups, short-lived ones pack around them.
+        java.util.Collections.sort(candidates, (a, b) -> {
+            int c = Integer.compare(b.span(), a.span());
+            if (c != 0) return c;
+            return Long.compare(b.resource.sizeBytes(), a.resource.sizeBytes());
+        });
+
+        List<List<ResourceLifetime>> groups = new ArrayList<List<ResourceLifetime>>();
+        for (ResourceLifetime cand : candidates) {
+            boolean placed = false;
+            for (List<ResourceLifetime> g : groups) {
+                boolean fits = true;
+                for (ResourceLifetime m : g) {
+                    if (m.overlaps(cand) || !compatible(m.resource, cand.resource)) { fits = false; break; }
+                }
+                if (fits) { g.add(cand); placed = true; break; }
+            }
+            if (!placed) {
+                List<ResourceLifetime> g = new ArrayList<ResourceLifetime>();
+                g.add(cand);
+                groups.add(g);
+            }
+        }
+
+        int realGroups = 0;
+        long savings = 0;
+        for (int i = 0; i < groups.size(); i++) {
+            List<ResourceLifetime> g = groups.get(i);
+            long max = 0, sum = 0;
+            for (ResourceLifetime m : g) {
+                m.setAliasGroup(g.size() > 1 ? i : -1);
+                long sz = m.resource.sizeBytes();
+                sum += sz;
+                max = Math.max(max, sz);
+            }
+            if (g.size() > 1) { realGroups++; savings += sum - max; }
+        }
+        stats.aliasGroups = realGroups;
+        stats.aliasSavingsBytes = savings;
+        if (savings > 0) {
+            stats.warnings.add("aliasing computed but allocations are not yet shared (PIPELINE_PLAN P4)");
+        }
+    }
+
+    private static boolean compatible(GraphResource a, GraphResource b) {
+        GfxDesc.Image da = a.imageDesc(), db = b.imageDesc();
+        if (da == null || db == null) return false;
+        return da.type == db.type && da.format == db.format && da.samples == db.samples
+                && da.mipLevels == db.mipLevels;
+    }
+}
diff --git a/core/src/main/java/dev/auralite/render/graph/GraphContext.java b/core/src/main/java/dev/auralite/render/graph/GraphContext.java
new file mode 100644
index 0000000..5b87e70
--- /dev/null
+++ b/core/src/main/java/dev/auralite/render/graph/GraphContext.java
@@ -0,0 +1,142 @@
+package dev.auralite.render.graph;
+
+import dev.auralite.render.rhi.GfxBuffer;
+import dev.auralite.render.rhi.GfxDesc;
+import dev.auralite.render.rhi.GfxCommandBuffer;
+import dev.auralite.render.rhi.GfxDevice;
+import dev.auralite.render.rhi.GfxImage;
+import dev.auralite.render.scene.FrameContext;
+
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * What a pass body receives.
+ *
+ * <p>Nothing here is backend specific, so the same pass body runs on the NULL,
+ * GL46 and Vulkan lanes. The {@code scratch} map is where the Minecraft glue
+ * hands pack code per-frame values (camera matrices, the biome field, the
+ * lightmap texture) without them becoming part of the graph's resource set.
+ */
+public final class GraphContext {
+    private final GfxDevice device;
+    private final GfxCommandBuffer cmd;
+    private final CompiledGraph graph;
+    private final FrameContext frame;
+    private final Map<String, Object> scratch = new HashMap<String, Object>();
+    private GraphPass currentPass;
+    private int areaW, areaH;
+
+    public GraphContext(GfxDevice device, GfxCommandBuffer cmd, CompiledGraph graph, FrameContext frame) {
+        this.device = device;
+        this.cmd = cmd;
+        this.graph = graph;
+        this.frame = frame;
+    }
+
+    public GfxDevice device() { return device; }
+    public GfxCommandBuffer cmd() { return cmd; }
+    public CompiledGraph graph() { return graph; }
+    public FrameContext frame() { return frame; }
+    public int width() { return graph.width(); }
+    public int height() { return graph.height(); }
+    public long frameId() { return frame == null ? 0 : frame.frameId(); }
+
+    public GraphPass currentPass() { return currentPass; }
+    void setCurrentPass(GraphPass p) { this.currentPass = p; }
+
+    public GfxImage image(String resourceName) {
+        GraphResource r = graph.graph().require(resourceName);
+        GfxImage img = r.image();
+        if (img == null) {
+            throw new GraphException("resource '" + resourceName + "' is not a texture or is not allocated",
+                    currentPass == null ? "" : currentPass.name());
+        }
+        return img;
+    }
+
+    public GfxBuffer buffer(String resourceName) {
+        GraphResource r = graph.graph().require(resourceName);
+        GfxBuffer b = r.buffer();
+        if (b == null) {
+            throw new GraphException("resource '" + resourceName + "' is not a buffer or is not allocated",
+                    currentPass == null ? "" : currentPass.name());
+        }
+        return b;
+    }
+
+    public GraphResource resource(String resourceName) { return graph.graph().require(resourceName); }
+
+    /**
+     * Builds and begins the render pass implied by the current pass's declared
+     * attachments, so a pack body never spells out its own target list.
+     *
+     * <p>The render area comes from the attachments, not from the framebuffer:
+     * a 256x256 cloud-shadow map and a 2048x2048 shadow map are passes in the
+     * same graph as the 1920x1080 lighting pass, and each one's area is the
+     * smallest attachment it writes, mip level accounted for.
+     */
+    public void beginRasterPass() {
+        if (currentPass == null) throw new GraphException("beginRasterPass outside a pass body");
+        int[] area = renderArea();
+        int w = area[0], h = area[1];
+        GfxDesc.RenderPass rp = GfxDesc.RenderPass.of(w, h).named(currentPass.name());
+        for (GraphAccess a : currentPass.colorAttachments()) {
+            rp.color(GfxDesc.Attachment.of(image(a.resource.name())));
+        }
+        GraphAccess d = currentPass.depthAttachment();
+        if (d != null) rp.depth(GfxDesc.Attachment.of(image(d.resource.name())));
+        cmd.beginRenderPass(rp);
+        // The render area follows the attachments, so the viewport must too: a
+        // 256x256 cloud-shadow pass with a 1920x1080 viewport draws nothing.
+        cmd.setViewport(0, 0, w, h, 0.0f, 1.0f);
+        cmd.setScissor(0, 0, w, h);
+        areaW = w; areaH = h;
+    }
+
+    /**
+     * The render area the current pass will use, as {@code {width, height}},
+     * without beginning anything.
+     *
+     * <p>A pass body needs this before it builds a pipeline: a pipeline created
+     * against the framebuffer's 1920x1080 is the wrong pipeline for the 256x256
+     * cloud-shadow pass and for the 2048x2048 shadow map that sit in the same
+     * graph. The rule is the smallest attached image, mip level accounted for,
+     * falling back to the graph size only when a pass attaches nothing.
+     */
+    public int[] renderArea() {
+        if (currentPass == null) return new int[] { graph.width(), graph.height() };
+        int w = graph.width(), h = graph.height();
+        boolean any = false;
+        for (GraphAccess a : currentPass.colorAttachments()) {
+            GfxImage img = image(a.resource.name());
+            int shift = Math.max(0, a.mipLevel);
+            int iw = Math.max(1, img.width() >> shift), ih = Math.max(1, img.height() >> shift);
+            w = any ? Math.min(w, iw) : iw;
+            h = any ? Math.min(h, ih) : ih;
+            any = true;
+        }
+        GraphAccess d = currentPass.depthAttachment();
+        if (d != null) {
+            GfxImage img = image(d.resource.name());
+            w = any ? Math.min(w, img.width()) : img.width();
+            h = any ? Math.min(h, img.height()) : img.height();
+        }
+        return new int[] { w, h };
+    }
+
+    /** Width of the area the last {@link #beginRasterPass()} used. */
+    public int renderAreaWidth() { return areaW; }
+
+    /** Height of the area the last {@link #beginRasterPass()} used. */
+    public int renderAreaHeight() { return areaH; }
+
+    public void endRasterPass() { cmd.endRenderPass(); }
+
+    public void put(String key, Object value) { scratch.put(key, value); }
+
+    @SuppressWarnings("unchecked")
+    public <T> T get(String key) { return (T) scratch.get(key); }
+
+    public boolean has(String key) { return scratch.containsKey(key); }
+}
diff --git a/core/src/main/java/dev/auralite/render/graph/GraphException.java b/core/src/main/java/dev/auralite/render/graph/GraphException.java
